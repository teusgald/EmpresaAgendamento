@model EmpresaAgendamento.Models.Agendamento

@{
    ViewData["Title"] = "Novo Agendamento";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="mb-4">Novo Agendamento</h4>
            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label">Categoria</label>
                    <select class="form-select" id="segmentoSelect">
                        <option value="">Todas as categorias</option>
                        @foreach (var segmento in (List<string>)ViewBag.Segmentos)
                        {
                            <option value="@segmento">@segmento</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Empresa</label>
                    <select asp-for="EmpresaId" class="form-select" asp-items="ViewBag.Empresas" id="empresaSelect">
                        <option value="">Selecione</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Serviço</label>
                    <select asp-for="ServicoId" class="form-select" asp-items="ViewBag.Servicos" id="servicoSelect">
                        <option value="">Selecione</option>
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Data</label>
                        <input type="date" class="form-control" id="dataAgendamento" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Horário</label>
                        <select class="form-select" id="horarioSelect">
                            <option value="">Selecione a empresa, o serviço e a data</option>
                        </select>
                    </div>
                </div>

                <input type="hidden" asp-for="DataHora" id="dataHoraHidden" />

                <div class="mb-3">
                    <label class="form-label">Observação</label>
                    <input asp-for="Observacao" class="form-control" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">Agendar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const segmentoSelect = document.getElementById("segmentoSelect");
        const empresaSelect = document.getElementById("empresaSelect");
        const servicoSelect = document.getElementById("servicoSelect");
        const dataInput = document.getElementById("dataAgendamento");
        const horarioSelect = document.getElementById("horarioSelect");
        const dataHoraHidden = document.getElementById("dataHoraHidden");

        if (!empresaSelect) return;

        // ==========================================
        // HORÁRIOS DISPONÍVEIS (mesma regra do agendamento público —
        // respeita expediente do funcionário e conflitos já marcados)
        // ==========================================

        function carregarHorarios() {

            const empresaId = empresaSelect.value;
            const servicoId = servicoSelect.value;
            const data = dataInput.value;

            if (!empresaId || !servicoId || !data) {
                horarioSelect.innerHTML = '<option value="">Selecione a empresa, o serviço e a data</option>';
                return;
            }

            horarioSelect.innerHTML = '<option value="">Carregando...</option>';

            fetch(`/Publico/HorariosDisponiveis?empresaId=${empresaId}&servicoId=${servicoId}&data=${data}`)
                .then(response => response.json())
                .then(horarios => {

                    if (!horarios.length) {
                        horarioSelect.innerHTML = '<option value="">Nenhum horário disponível nesse dia</option>';
                        return;
                    }

                    horarioSelect.innerHTML = '<option value="">Selecione</option>';

                    horarios.forEach(h => {
                        const option = document.createElement("option");
                        option.value = h;
                        option.text = h;
                        horarioSelect.appendChild(option);
                    });
                })
                .catch(error => {
                    console.error("Erro ao carregar horários:", error);
                    horarioSelect.innerHTML = '<option value="">Erro ao carregar</option>';
                });
        }

        dataInput.addEventListener("change", carregarHorarios);
        horarioSelect.addEventListener("change", atualizarDataHoraHidden);

        function atualizarDataHoraHidden() {
            dataHoraHidden.value = (dataInput.value && horarioSelect.value)
                ? `${dataInput.value}T${horarioSelect.value}:00`
                : "";
        }

        document.querySelector("form").addEventListener("submit", atualizarDataHoraHidden);

        if (segmentoSelect) {
            segmentoSelect.addEventListener("change", function () {

                const segmento = this.value;

                empresaSelect.innerHTML = '<option value="">Carregando...</option>';
                servicoSelect.innerHTML = '<option value="">Selecione</option>';

                const url = segmento
                    ? `/cliente/agendamentos/empresas?segmento=${encodeURIComponent(segmento)}`
                    : `/cliente/agendamentos/empresas`;

                fetch(url)
                    .then(response => response.json())
                    .then(data => {

                        empresaSelect.innerHTML = '<option value="">Selecione</option>';

                        data.forEach(function (empresa) {
                            const option = document.createElement("option");
                            option.value = empresa.id;
                            option.text = empresa.nome;
                            empresaSelect.appendChild(option);
                        });

                    })
                    .catch(error => {
                        console.error("Erro ao carregar empresas:", error);
                        empresaSelect.innerHTML = '<option value="">Erro ao carregar</option>';
                    });
            });
        }

        empresaSelect.addEventListener("change", function () {

            const empresaId = this.value;

            horarioSelect.innerHTML = '<option value="">Selecione a empresa, o serviço e a data</option>';

            if (!empresaId) {
                servicoSelect.innerHTML = '<option value="">Selecione</option>';
                return;
            }

            servicoSelect.innerHTML = '<option value="">Carregando...</option>';

            fetch(`/cliente/agendamentos/servicos/${empresaId}`)
                .then(response => response.json())
                .then(data => {

                    servicoSelect.innerHTML = '<option value="">Selecione</option>';

                    data.forEach(function (servico) {
                        const option = document.createElement("option");
                        option.value = servico.id;
                        option.text = servico.nome;
                        servicoSelect.appendChild(option);
                    });

                })
                .catch(error => {
                    console.error("Erro ao carregar serviços:", error);
                    servicoSelect.innerHTML = '<option value="">Erro ao carregar</option>';
                });

        });

        servicoSelect.addEventListener("change", carregarHorarios);

    });
</script>