@model EmpresaLoginViewModel

<div class="auth-card">

    <div class="text-center mb-4">
        <i class="bi bi-building auth-icon"></i>
        <h4 class="auth-title">Login Empresa</h4>
    </div>

    <form method="post" id="empresaLoginForm">

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <input asp-for="Email" class="form-control" placeholder="Email" />
        </div>

        <div class="mb-3">
            <input asp-for="Password" type="password" class="form-control" placeholder="Senha" />
        </div>

        <button class="btn btn-dark w-100">
            Entrar
        </button>

        <div class="text-center">
            <a href="#" class="text-muted small switch-mode" data-mode="register">Criar conta</a>
        </div>

        <div class="text-center mt-2">
            <a href="#" class="text-muted small" id="forgotPassword">
                Esqueci minha senha
            </a>
        </div>

    </form>

</div>