@using EmpresaAgendamento.Models.ViewModels
@model EmpresaRegisterViewModel

<div class="auth-card">

    <div class="text-center mb-4">
        <i class="bi bi-building auth-icon"></i>
        <h4 class="auth-title">Cadastro Empresa</h4>
    </div>

    <form id="empresaRegisterForm"  data-type="empresa-register">

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <input asp-for="NomeEmpresa" class="form-control" placeholder="Nome da empresa" />
        </div>

        <div class="mb-3">
            <input asp-for="Email" class="form-control" placeholder="Email" />
        </div>

        <div class="mb-3">
            <input asp-for="Password" type="password" class="form-control" placeholder="Senha" />
        </div>

        <button class="btn btn-dark w-100">
            Criar Conta
        </button>

        <div class="text-center mt-3">
            <a href="#" class="text-muted small switch-mode" data-mode="login">Já tem conta? Entrar</a>
        </div>
    </form>

</div>