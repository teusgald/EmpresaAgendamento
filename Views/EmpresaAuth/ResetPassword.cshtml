@model EmpresaAgendamento.Models.ViewModels.ResetPasswordViewModel

<div class="auth-card">

    <div class="text-center mb-4">
        <h4>Nova senha</h4>
        <p class="text-muted">
            Informe sua nova senha para acessar sua conta.
        </p>
    </div>

    <form id="resetForm"
          data-type="empresa-reset">

        <input asp-for="Email" type="hidden" />
        <input asp-for="Token" type="hidden" />

        <div class="mb-3">
            <input asp-for="Password"
                   type="password"
                   class="form-control"
                   placeholder="Nova senha" />
        </div>

        <div class="mb-3">
            <input asp-for="ConfirmPassword"
                   type="password"
                   class="form-control"
                   placeholder="Confirmar senha" />
        </div>

        <button type="submit"
                class="btn btn-dark w-100">
            Alterar senha
        </button>

    </form>

</div>

<partial name="_ValidationScriptsPartial" />