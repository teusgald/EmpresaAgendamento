@model EmpresaAgendamento.Models.ViewModels.PerfilFormViewModel
@{
    ViewData["Title"] = "Editar perfil";
}

<div class="container-fluid mt-4">

    <div class="page-header">
        <div>
            <h3 class="fw-bold mb-0">Editar perfil de acesso</h3>
            <p class="page-subtitle">@Model.Nome</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-dark btn-sm">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>
    </div>

    <form method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <label class="form-label small fw-semibold">Nome do perfil</label>
                <input asp-for="Nome" class="form-control" style="max-width:360px" />
                <span asp-validation-for="Nome" class="text-danger small"></span>
            </div>
        </div>

        <div class="alert alert-light border small">
            O campo <b>Escopo</b> hoje tem efeito em três módulos, sempre no mesmo sentido ("Próprios" = só o
            que é dele; "Todos" = vê da empresa inteira): <b>Agendamentos</b> (só os agendamentos dele),
            <b>Serviços</b> (só os que ele está marcado pra realizar, no cadastro do funcionário) e
            <b>Clientes</b> (só clientes que ele já atendeu). Nos demais módulos fica salvo, mas ainda sem efeito.
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Módulo</th>
                                <th class="text-center">Ver</th>
                                <th class="text-center">Criar</th>
                                <th class="text-center">Editar</th>
                                <th class="text-center">Excluir</th>
                                <th>Escopo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Permissoes.Count; i++)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @Model.Permissoes[i].ModuloLabel
                                        @if (Model.Permissoes[i].Modulo == "Agendamentos")
                                        {
                                            <br /><small class="text-muted fw-normal">Tela sempre liberada — só o Escopo importa aqui</small>
                                        }
                                        <input type="hidden" asp-for="Permissoes[i].Modulo" />
                                        <input type="hidden" asp-for="Permissoes[i].ModuloLabel" />
                                    </td>
                                    <td class="text-center"><input type="checkbox" class="form-check-input" asp-for="Permissoes[i].PodeVisualizar" /></td>
                                    <td class="text-center"><input type="checkbox" class="form-check-input" asp-for="Permissoes[i].PodeCriar" /></td>
                                    <td class="text-center"><input type="checkbox" class="form-check-input" asp-for="Permissoes[i].PodeEditar" /></td>
                                    <td class="text-center"><input type="checkbox" class="form-check-input" asp-for="Permissoes[i].PodeExcluir" /></td>
                                    <td>
                                        <select asp-for="Permissoes[i].EscopoDados" class="form-select form-select-sm"
                                                asp-items="Html.GetEnumSelectList<EmpresaAgendamento.Models.Enums.EscopoDadosPerfil>()">
                                        </select>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-dark mt-3">Salvar perfil</button>
    </form>

</div>
