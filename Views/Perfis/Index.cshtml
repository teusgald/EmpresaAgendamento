@model List<EmpresaAgendamento.Models.Perfil>
@{
    ViewData["Title"] = "Perfis de acesso";
}

<div class="container-fluid mt-4">

    <div class="page-header">
        <div>
            <h3 class="fw-bold mb-0">Perfis de acesso</h3>
            <p class="page-subtitle">Defina o que cada tipo de funcionário pode ver e fazer no sistema.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Novo perfil
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm">
            <div class="empty-state">
                <i class="bi bi-person-badge"></i>
                <p>Nenhum perfil criado ainda.</p>
                <a asp-action="Create" class="btn btn-dark btn-sm mt-2">Criar o primeiro perfil</a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Nome</th>
                            <th>Status</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Nome</td>
                                <td>
                                    @if (item.Ativo)
                                    {
                                        <span class="badge bg-success">Ativo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inativo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>

                                    <form asp-action="ToggleAtivo" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        @if (item.Ativo)
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-warning">Desativar</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-success">Ativar</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>
