@model EmpresaAgendamento.Models.Servico

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="mb-4">Novo Serviço</h4>

            <div asp-validation-summary="All" class="text-danger"></div>

            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label class="form-label">Nome</label>
                    <input asp-for="Nome" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Preço</label>
                    <input asp-for="Preco" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Duração (minutos)</label>
                    <input asp-for="DuracaoMinutos" class="form-control" />
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">Salvar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
                </div>
            </form>
        </div>
    </div>
</div>