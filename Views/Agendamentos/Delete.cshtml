@model EmpresaAgendamento.Models.Agendamento
@{
    ViewData["Title"] = "Agendamentos";
}
<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="mb-4 text-danger">Excluir Agendamento</h4>
            <p>Tem certeza que deseja excluir o agendamento de <strong>@Model.Cliente.Nome</strong> no dia <strong>@Model.DataHora.ToString("dd/MM/yyyy HH:mm")</strong>?</p>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger">Excluir</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>