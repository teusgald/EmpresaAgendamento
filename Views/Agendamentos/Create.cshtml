@model EmpresaAgendamento.Models.Agendamento

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">

            <h4 class="mb-4">Novo Agendamento</h4>

            <form asp-action="Create">

                <!-- CLIENTE CADASTRADO -->
                <div class="mb-3">
                    <label class="form-label">Cliente cadastrado</label>
                    <select asp-for="ClienteId" class="form-select">
                        <option value="">Selecione</option>
                        @foreach (var cliente in ViewBag.Clientes)
                        {
                            <option value="@cliente.Id">@cliente.Nome</option>
                        }
                    </select>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="ClienteAvulso"
                           id="clienteAvulso"
                           class="form-check-input" />

                    <label class="form-check-label">
                        Cliente não cadastrado
                    </label>
                </div>

                <!-- CLIENTE AVULSO -->
                <div id="avulsoBox" class="border p-3 mb-3 d-none">

                    <input asp-for="NomeClienteAvulso"
                           class="form-control mb-2"
                           placeholder="Nome do cliente" />

                    <input asp-for="TelefoneClienteAvulso"
                           class="form-control"
                           placeholder="Telefone" />
                </div>

                <!-- SERVIÇO -->
                <div class="mb-3">
                    <label class="form-label">Serviço</label>
                    <select asp-for="ServicoId" class="form-select">
                        <option value="">Selecione</option>
                        @foreach (var servico in ViewBag.Servicos)
                        {
                            <option value="@servico.Id">@servico.Nome</option>
                        }
                    </select>
                </div>

                <!-- FUNCIONÁRIO -->
                <div class="mb-3">
                    <label class="form-label">Funcionário (opcional)</label>
                    <select asp-for="FuncionarioId" class="form-select">
                        <option value="">Automático (sistema escolhe)</option>
                        @foreach (var f in ViewBag.Funcionarios)
                        {
                            <option value="@f.Id">@f.Nome</option>
                        }
                    </select>
                </div>

                <!-- DATA -->
                <div class="mb-3">
                    <label class="form-label">Data e Hora</label>
                    <input asp-for="DataHora"
                           type="datetime-local"
                           class="form-control"
                           value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
                </div>

                <!-- OBS -->
                <div class="mb-3">
                    <label class="form-label">Observação</label>
                    <input asp-for="Observacao"
                           class="form-control" />
                </div>

                <button class="btn btn-success">
                    Salvar
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Voltar
                </a>

            </form>

        </div>
    </div>
</div>

<script>
    const check = document.getElementById('clienteAvulso');
    const box = document.getElementById('avulsoBox');

    check.addEventListener('change', function () {
        box.classList.toggle('d-none', !this.checked);
    });
</script>