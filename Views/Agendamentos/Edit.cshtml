@model EmpresaAgendamento.Models.Agendamento

@{
    ViewData["Title"] = "Editar Agendamento";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">

            <h4 class="mb-4">Editar Agendamento</h4>

            <div asp-validation-summary="All" class="text-danger"></div>

            <form asp-action="Edit" method="post">

                <input type="hidden" asp-for="Id" />

                <!-- CLIENTE CADASTRADO -->

                <div class="mb-3">
                    <label class="form-label">
                        Cliente cadastrado
                    </label>

                    <select asp-for="ClienteId" class="form-select">

                        <option value="">
                            Selecione
                        </option>

                        @foreach (var cliente in ViewBag.Clientes)
                        {
                            <option value="@cliente.Id"
                                    selected="@(Model.ClienteId == cliente.Id)">
                                @cliente.Nome
                            </option>
                        }

                    </select>
                </div>

                <!-- CLIENTE AVULSO -->

                <div class="form-check mb-3">

                    <input class="form-check-input"
                           type="checkbox"
                           id="clienteAvulso"
                           name="clienteAvulso"
                           value="true"
                    @(Model.ClienteAvulso ? "checked" : "") />

                    <label class="form-check-label">
                        Cliente não cadastrado
                    </label>

                </div>

                <div id="avulsoBox"
                     class="border rounded p-3 mb-3 @(Model.ClienteAvulso ? "" : "d-none")">

                    <div class="mb-2">
                        <label class="form-label">
                            Nome do Cliente
                        </label>

                        <input asp-for="NomeClienteAvulso"
                               class="form-control" />
                    </div>

                    <div>
                        <label class="form-label">
                            Telefone
                        </label>

                        <input asp-for="TelefoneClienteAvulso"
                               class="form-control" />
                    </div>

                </div>

                <!-- SERVIÇO -->

                <div class="mb-3">
                    <label class="form-label">
                        Serviço
                    </label>

                    <select asp-for="ServicoId"
                            class="form-select">

                        @foreach (var servico in ViewBag.Servicos)
                        {
                            <option value="@servico.Id"
                                    selected="@(Model.ServicoId == servico.Id)">
                                @servico.Nome
                            </option>
                        }

                    </select>
                </div>

                <!-- FUNCIONÁRIO -->

                <div class="mb-3">

                    <label class="form-label">
                        Funcionário
                    </label>

                    <select asp-for="FuncionarioId"
                            class="form-select">

                        <option value="">
                            Selecione
                        </option>

                        @foreach (var funcionario in ViewBag.Funcionarios)
                        {
                            <option value="@funcionario.Id"
                                    selected="@(Model.FuncionarioId == funcionario.Id)">
                                @funcionario.Nome
                            </option>
                        }

                    </select>

                </div>

                <div class="form-check mb-3">

                    <input class="form-check-input"
                           type="checkbox"
                           id="funcionarioAleatorio"
                           name="funcionarioAleatorio"
                           value="true" />

                    <label class="form-check-label">
                        Escolher funcionário automaticamente
                    </label>

                </div>

                <!-- DATA -->

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Data</label>
                        <input type="date" class="form-control" id="dataAgendamento"
                               value="@Model.DataHora.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Horário</label>
                        <select class="form-select" id="horarioSelect">
                            <option value="@Model.DataHora.ToString("HH:mm")" selected>
                                @Model.DataHora.ToString("HH:mm") (atual)
                            </option>
                        </select>
                    </div>
                </div>

                <input type="hidden" asp-for="DataHora" id="dataHoraHidden"
                       value="@Model.DataHora.ToString("yyyy-MM-ddTHH:mm:ss")" />

                <!-- OBSERVAÇÃO -->

                <div class="mb-3">

                    <label class="form-label">
                        Observação
                    </label>

                    <textarea asp-for="Observacao"
                              class="form-control"
                              rows="3"></textarea>

                </div>

                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-success">
                        Salvar
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Voltar
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts
{
    <script>

        const checkCliente =
            document.getElementById("clienteAvulso");

        const avulsoBox =
            document.getElementById("avulsoBox");

        function toggleClienteAvulso()
        {
            avulsoBox.classList.toggle(
                "d-none",
                !checkCliente.checked
            );
        }

        checkCliente.addEventListener(
            "change",
            toggleClienteAvulso
        );

        toggleClienteAvulso();

        // ==========================================
        // HORÁRIOS DISPONÍVEIS (mesma regra do agendamento público —
        // respeita expediente do funcionário e conflitos já marcados;
        // exclui este próprio agendamento do cálculo de conflito)
        // ==========================================

        const empresaId = @ViewBag.EmpresaId;
        const agendamentoId = @Model.Id;
        const servicoSelect = document.getElementById("ServicoId");
        const funcionarioSelect = document.getElementById("FuncionarioId");
        const dataInput = document.getElementById("dataAgendamento");
        const horarioSelect = document.getElementById("horarioSelect");
        const dataHoraHidden = document.getElementById("dataHoraHidden");

        function carregarHorarios() {

            const servicoId = servicoSelect.value;
            const funcionarioId = funcionarioSelect.value;
            const data = dataInput.value;

            if (!servicoId || !data) {
                horarioSelect.innerHTML = '<option value="">Selecione o serviço e a data</option>';
                return;
            }

            horarioSelect.innerHTML = '<option value="">Carregando...</option>';

            const url = `/Publico/HorariosDisponiveis?empresaId=${empresaId}&servicoId=${servicoId}` +
                `&funcionarioId=${funcionarioId}&data=${data}&excluirAgendamentoId=${agendamentoId}`;

            fetch(url)
                .then(response => response.json())
                .then(horarios => {

                    if (!horarios.length) {
                        horarioSelect.innerHTML = '<option value="">Nenhum horário disponível nesse dia</option>';
                        return;
                    }

                    horarioSelect.innerHTML = '<option value="">Selecione</option>';

                    horarios.forEach(h => {
                        const option = document.createElement("option");
                        option.value = h;
                        option.text = h;
                        horarioSelect.appendChild(option);
                    });
                })
                .catch(error => {
                    console.error("Erro ao carregar horários:", error);
                    horarioSelect.innerHTML = '<option value="">Erro ao carregar</option>';
                });
        }

        function atualizarDataHoraHidden() {
            dataHoraHidden.value = (dataInput.value && horarioSelect.value)
                ? `${dataInput.value}T${horarioSelect.value}:00`
                : "";
        }

        servicoSelect.addEventListener("change", carregarHorarios);
        funcionarioSelect.addEventListener("change", carregarHorarios);
        dataInput.addEventListener("change", carregarHorarios);
        horarioSelect.addEventListener("change", atualizarDataHoraHidden);

        document.querySelector("form").addEventListener("submit", atualizarDataHoraHidden);

    </script>
}