@{
    Layout = null;
    ViewData["Title"] = "Acesso indisponível";
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Simpli Time</title>
    <link rel="icon" type="image/png" href="/img/icon.png?v=3" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="d-flex align-items-center justify-content-center" style="min-height:100vh;">
        <div class="card shadow-sm text-center" style="width:100%;max-width:420px;">
            <div class="card-body p-4">

                <i class="bi bi-lock text-warning" style="font-size:2.5rem;"></i>
                <h4 class="mt-3 mb-2">Acesso temporariamente indisponível</h4>

                <p class="text-muted small mb-4">
                    A assinatura desta empresa está inativa no momento. Fale com o
                    responsável pela empresa para regularizar o pagamento e voltar
                    a ter acesso ao sistema.
                </p>

                <form asp-controller="FuncionarioAuth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-dark w-100">
                        <i class="bi bi-box-arrow-right me-1"></i> Sair
                    </button>
                </form>

            </div>
        </div>
    </div>

</body>
</html>
