@model EmpresaAgendamento.Models.Empresa
@using EmpresaAgendamento.Helpers

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">

            <h4 class="mb-4">Configurações da Empresa</h4>

            @if (ViewBag.Mensagem != null)
            {
                <div class="alert alert-success">
                    @ViewBag.Mensagem
                </div>
            }

            <form asp-action="Index" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <!-- ===================== IDENTIDADE ===================== -->
                <h5 class="mt-3">Identidade</h5>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nome</label>
                        <input asp-for="Nome" class="form-control" />
                        <small class="text-muted">Razão social — o nome oficial, usado em documentos e recibos.</small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nome Fantasia</label>
                        <input asp-for="NomeFantasia" class="form-control" />
                        <small class="text-muted">Como aparece pro cliente — página pública, portal, notificações. Em branco, usa o Nome ao lado.</small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Categoria</label>
                        <select asp-for="Categoria" class="form-select">
                            <option value="">Selecione</option>
                            @foreach (var opcao in CategoriaEmpresaHelper.Opcoes)
                            {
                                <option value="@opcao.Valor">@opcao.Nome</option>
                            }
                        </select>
                        <small class="text-muted">Tipo de negócio — é o filtro que o cliente usa pra te achar em "Encontrar empresas".</small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">CPF / CNPJ</label>
                        <input asp-for="DocumentoNumero" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Slogan</label>
                        <input asp-for="Slogan" class="form-control" />
                        <small class="text-muted">Frase curta embaixo do nome na página pública (opcional).</small>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Descrição</label>
                    <textarea asp-for="Descricao" class="form-control"></textarea>
                </div>

                <!-- ===================== MÍDIA ===================== -->
                <h5 class="mt-4">Marca</h5>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Logo</label>

                        <div class="d-flex align-items-center gap-3 mb-2">
                            <img id="logoPreview"
                                 src="@Model.LogoUrl"
                                 alt="Logo"
                                 style="max-height:64px;max-width:120px;object-fit:contain;@(string.IsNullOrEmpty(Model.LogoUrl) ? "display:none;" : "")"
                                 class="border rounded p-1 bg-white" />
                        </div>

                        <input type="file"
                               name="logoFile"
                               id="logoFile"
                               accept="image/png,image/jpeg,image/webp,image/gif"
                               class="form-control"
                               onchange="previewLogo(this)" />

                        <small class="text-muted">
                            PNG, JPG, WEBP ou GIF — até 2 MB. Aparece no menu do seu portal e na sua página pública.
                        </small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Banner da página pública</label>

                        <div class="mb-2">
                            <img id="bannerPreview"
                                 src="@Model.CapaBannerUrl"
                                 alt="Banner"
                                 style="max-height:64px;width:100%;object-fit:cover;@(string.IsNullOrEmpty(Model.CapaBannerUrl) ? "display:none;" : "")"
                                 class="border rounded" />
                        </div>

                        <input type="file"
                               name="bannerFile"
                               id="bannerFile"
                               accept="image/png,image/jpeg,image/webp,image/gif"
                               class="form-control"
                               onchange="previewBanner(this)" />

                        <small class="text-muted">
                            PNG, JPG, WEBP ou GIF — até 5 MB. Imagem larga (ideal 1400x400px) que fica atrás do seu nome na página pública. Sem foto, usa um fundo neutro.
                        </small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Cor primária</label>

                        <div class="d-flex align-items-center gap-2">
                            <input type="checkbox"
                                   id="corPrimariaPadrao"
                                   class="form-check-input mt-0"
                                   checked="@(string.IsNullOrWhiteSpace(Model.CorPrimaria))"
                                   onchange="toggleCorPadrao('Primaria')" />

                            <label class="form-check-label small" for="corPrimariaPadrao">
                                Usar cor padrão do sistema
                            </label>
                        </div>

                        <div class="d-flex align-items-center gap-2 mt-1">
                            <input type="color"
                                   asp-for="CorPrimaria"
                                   id="corPrimariaInput"
                                   value="@(string.IsNullOrWhiteSpace(Model.CorPrimaria) ? "#000000" : Model.CorPrimaria)"
                                   disabled="@(string.IsNullOrWhiteSpace(Model.CorPrimaria))"
                                   class="form-control form-control-color"
                                   title="Escolha a cor primária"
                                   oninput="corSincronizarDoPicker('Primaria')" />

                            <span id="corPrimariaPreview"
                                  class="border rounded"
                                  style="width:32px;height:32px;background:@(string.IsNullOrWhiteSpace(Model.CorPrimaria) ? "#000000" : Model.CorPrimaria);"></span>

                            <input type="text"
                                   id="corPrimariaHex"
                                   class="form-control form-control-sm"
                                   style="max-width:110px;"
                                   placeholder="#RRGGBB"
                                   maxlength="7"
                                   disabled="@(string.IsNullOrWhiteSpace(Model.CorPrimaria))"
                                   value="@Model.CorPrimaria"
                                   oninput="corSincronizarDoTexto('Primaria')" />
                        </div>

                        <small class="text-muted">Usada nos botões e destaques da sua página pública. Já tem o código da cor (ex.: #FF5733)? Digite direto no campo ao lado.</small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Cor secundária</label>

                        <div class="d-flex align-items-center gap-2">
                            <input type="checkbox"
                                   id="corSecundariaPadrao"
                                   class="form-check-input mt-0"
                                   checked="@(string.IsNullOrWhiteSpace(Model.CorSecundaria))"
                                   onchange="toggleCorPadrao('Secundaria')" />

                            <label class="form-check-label small" for="corSecundariaPadrao">
                                Usar cor padrão do sistema
                            </label>
                        </div>

                        <div class="d-flex align-items-center gap-2 mt-1">
                            <input type="color"
                                   asp-for="CorSecundaria"
                                   id="corSecundariaInput"
                                   value="@(string.IsNullOrWhiteSpace(Model.CorSecundaria) ? "#000000" : Model.CorSecundaria)"
                                   disabled="@(string.IsNullOrWhiteSpace(Model.CorSecundaria))"
                                   class="form-control form-control-color"
                                   title="Escolha a cor secundária"
                                   oninput="corSincronizarDoPicker('Secundaria')" />

                            <span id="corSecundariaPreview"
                                  class="border rounded"
                                  style="width:32px;height:32px;background:@(string.IsNullOrWhiteSpace(Model.CorSecundaria) ? "#000000" : Model.CorSecundaria);"></span>

                            <input type="text"
                                   id="corSecundariaHex"
                                   class="form-control form-control-sm"
                                   style="max-width:110px;"
                                   placeholder="#RRGGBB"
                                   maxlength="7"
                                   disabled="@(string.IsNullOrWhiteSpace(Model.CorSecundaria))"
                                   value="@Model.CorSecundaria"
                                   oninput="corSincronizarDoTexto('Secundaria')" />
                        </div>

                        <small class="text-muted">Usada em detalhes e elementos de apoio da sua página pública. Já tem o código da cor (ex.: #FF5733)? Digite direto no campo ao lado.</small>
                    </div>
                </div>

                <!-- ===================== DIGITAL ===================== -->
                <h5 class="mt-4">Presença Digital</h5>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Slug</label>
                        <input asp-for="Slug" class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">WhatsApp</label>
                        <input asp-for="WhatsApp" class="form-control" />
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Slug))
                    {
                        <div class="col-md-12 mb-3">
                            <label class="form-label">Link da Página Pública</label>

                            <div class="input-group">
                                <input id="publicUrl"
                                       class="form-control"
                                       readonly
                                       value="@($"{Context.Request.Scheme}://{Context.Request.Host}/{Model.Slug}")" />

                                <button type="button"
                                        class="btn btn-outline-secondary d-flex align-items-center gap-1"
                                        onclick="copyPublicUrl()"
                                        title="Copiar link">
                                    <span style="font-size:16px;">📋</span>
                                </button>
                            </div>

                            <small class="text-muted">
                                Este é o link público da sua empresa
                            </small>
                        </div>
                    }
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Instagram</label>
                        <input asp-for="Instagram" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Facebook</label>
                        <input asp-for="Facebook" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Site</label>
                        <input asp-for="Site" class="form-control" />
                    </div>
                </div>

                <!-- ===================== ENDEREÇO ===================== -->
                <h5 class="mt-4">Endereço</h5>

                <div class="row">
                    <div class="col-md-2 mb-3">
                        <label class="form-label">Número</label>
                        <input asp-for="Numero" class="form-control" />
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Complemento</label>
                        <input asp-for="Complemento" class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Bairro</label>
                        <input asp-for="Bairro" class="form-control" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">CEP</label>
                        <input asp-for="CEP" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-5 mb-3">
                        <label class="form-label">Cidade</label>
                        <input asp-for="Cidade" class="form-control" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label">UF</label>
                        <input asp-for="UF" class="form-control" maxlength="2" />
                    </div>

                    <div class="col-md-3 mb-3">
                        <label class="form-label">Latitude</label>
                        <input asp-for="Latitude" class="form-control" />
                    </div>

                    <div class="col-md-2 mb-3">
                        <label class="form-label">Longitude</label>
                        <input asp-for="Longitude" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">Link Google Maps</label>
                    <input asp-for="LinkMaps" class="form-control" />
                </div>

                <!-- ===================== PAGAMENTOS ===================== -->
                <h5 class="mt-4">Pagamentos</h5>

                <div class="row">
                    <div class="col-md-3 form-check">
                        <input asp-for="AceitaPix" class="form-check-input" />
                        <label class="form-check-label">PIX</label>
                    </div>

                    <div class="col-md-3 form-check">
                        <input asp-for="AceitaDinheiro" class="form-check-input" />
                        <label class="form-check-label">Dinheiro</label>
                    </div>

                    <div class="col-md-3 form-check">
                        <input asp-for="AceitaCartaoDebito" class="form-check-input" />
                        <label class="form-check-label">Débito</label>
                    </div>

                    <div class="col-md-3 form-check">
                        <input asp-for="AceitaCartaoCredito" class="form-check-input" />
                        <label class="form-check-label">Crédito</label>
                    </div>
                </div>

                <div class="col-md-3 mt-3">
                    <label class="form-label">Parcelamento Máximo</label>
                    <input asp-for="ParcelamentoMaximo" class="form-control" />
                </div>

                <!-- ===================== COMODIDADES ===================== -->
                <h5 class="mt-4">Comodidades</h5>

                <div class="row">
                    <div class="col-md-3 form-check">
                        <input asp-for="TemWifi" class="form-check-input" />
                        <label class="form-check-label">Wi-Fi</label>
                    </div>

                    <div class="col-md-3 form-check">
                        <input asp-for="TemEstacionamento" class="form-check-input" />
                        <label class="form-check-label">Estacionamento</label>
                    </div>

                    <div class="col-md-3 form-check">
                        <input asp-for="TemAcessibilidade" class="form-check-input" />
                        <label class="form-check-label">Acessibilidade</label>
                    </div>

                    <div class="col-md-3 form-check">
                        <input asp-for="TemArCondicionado" class="form-check-input" />
                        <label class="form-check-label">Ar-condicionado</label>
                    </div>
                </div>

                <div class="form-check mt-2">
                    <input asp-for="AtendimentoOnline" class="form-check-input" />
                    <label class="form-check-label">Atendimento Online</label>
                </div>

                <!-- ===================== CONTROLE ===================== -->
                <div class="form-check mt-4">
                    <input asp-for="Ativo" class="form-check-input" />
                    <label class="form-check-label">Ativo (visível para clientes)</label>
                </div>

                <button type="submit" class="btn btn-success mt-3">
                    Salvar
                </button>

            </form>

        </div>
    </div>

    <!-- ===================== TESTAR WHATSAPP ===================== -->
    <div class="card shadow-sm mt-4">
        <div class="card-body">

            <h5 class="mb-1">Testar integração com o WhatsApp</h5>
            <p class="text-muted small">
                Manda uma mensagem de teste pelo WhatsApp Cloud API — use um dos números verificados no seu
                painel de testes da Meta. Se a integração ainda não estiver configurada, a mensagem só é
                gravada no log do servidor (nada é enviado de verdade).
            </p>

            <form asp-action="TestarWhatsApp" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()

                <div class="col-auto">
                    <label class="form-label small mb-1">Telefone (com DDD)</label>
                    <input type="text" name="telefone" class="form-control" placeholder="(11) 98765-4321" style="width:200px" />
                </div>

                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-success">
                        <i class="bi bi-whatsapp me-1"></i>Enviar teste
                    </button>
                </div>
            </form>

        </div>
    </div>

    <!-- ===================== GALERIA DE FOTOS ===================== -->
    <div class="card shadow-sm mt-4">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Galeria de fotos</h5>
                <span class="text-muted small">
                    @ViewBag.Fotos.Count de @ViewBag.LimiteFotosGaleria fotos
                </span>
            </div>

            <p class="text-muted small">
                Essas fotos aparecem na aba "Galeria" da sua página pública.
            </p>

            <div class="row g-3 mb-3">

                @foreach (var foto in ViewBag.Fotos)
                {
                    <div class="col-6 col-md-3">
                        <div class="position-relative">
                            <img src="@foto.Url"
                                 class="w-100 rounded border"
                                 style="height:120px;object-fit:cover;" />

                            <form asp-action="RemoverFotoGaleria" method="post" class="position-absolute top-0 end-0 m-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@foto.Id" />
                                <button type="submit"
                                        class="btn btn-sm btn-danger rounded-circle"
                                        title="Remover foto"
                                        style="width:28px;height:28px;padding:0;line-height:1;">
                                    &times;
                                </button>
                            </form>
                        </div>
                    </div>
                }

            </div>

            @if (ViewBag.Fotos.Count < ViewBag.LimiteFotosGaleria)
            {
                <form asp-action="UploadGaleria" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()

                    <div class="input-group">
                        <input type="file"
                               name="fotos"
                               multiple
                               accept="image/png,image/jpeg,image/webp,image/gif"
                               class="form-control" />

                        <button type="submit" class="btn btn-outline-primary">
                            Adicionar
                        </button>
                    </div>

                    <small class="text-muted">
                        PNG, JPG, WEBP ou GIF — até 2 MB cada. Pode selecionar várias de uma vez.
                    </small>
                </form>
            }

        </div>
    </div>
</div>

<script>
        function previewLogo(input) {
        if (!input.files || !input.files[0]) return;

        const preview = document.getElementById("logoPreview");
        preview.src = URL.createObjectURL(input.files[0]);
        preview.style.display = "";
    }

        function previewBanner(input) {
        if (!input.files || !input.files[0]) return;

        const preview = document.getElementById("bannerPreview");
        preview.src = URL.createObjectURL(input.files[0]);
        preview.style.display = "";
    }

        function copyPublicUrl() {
        const input = document.getElementById("publicUrl");
        navigator.clipboard.writeText(input.value);

        const btn = event.currentTarget;
        const original = btn.innerHTML;

        btn.innerHTML = "✔";
        setTimeout(() => {
            btn.innerHTML = "📋";
        }, 1200);
    }

        // Enquanto o checkbox "usar cor padrão" está marcado, o input
        // type="color" fica desabilitado — um input desabilitado não é
        // enviado no POST, então CorPrimaria/CorSecundaria chegam nulos no
        // servidor (não força nenhum valor default no banco).
        function toggleCorPadrao(campo) {
        const checkbox = document.getElementById("cor" + campo + "Padrao");
        const input = document.getElementById("cor" + campo + "Input");
        const hex = document.getElementById("cor" + campo + "Hex");
        input.disabled = checkbox.checked;
        hex.disabled = checkbox.checked;
    }

        // Muita gente já tem o código da cor da marca (ex.: de uma logo ou
        // manual de identidade visual) — digitar é mais rápido que escolher
        // no seletor visual. Os dois campos ficam sincronizados; quem é
        // realmente enviado no POST é o input type="color" (asp-for).
        function corSincronizarDoTexto(campo) {
        const hex = document.getElementById("cor" + campo + "Hex");
        const input = document.getElementById("cor" + campo + "Input");
        const preview = document.getElementById("cor" + campo + "Preview");

        let valor = hex.value.trim();
        if (valor && !valor.startsWith("#")) {
            valor = "#" + valor;
        }

        if (/^#[0-9A-Fa-f]{6}$/.test(valor)) {
            input.value = valor;
            preview.style.background = valor;
        }
    }

        function corSincronizarDoPicker(campo) {
        const input = document.getElementById("cor" + campo + "Input");
        const hex = document.getElementById("cor" + campo + "Hex");
        const preview = document.getElementById("cor" + campo + "Preview");

        hex.value = input.value;
        preview.style.background = input.value;
    }
</script>