@model EmpresaAgendamento.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid mt-4">

    @if (!Model.AssinaturaAtiva)
    {
        <div class="alert alert-warning d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-4">
            <div>
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <strong>Sua assinatura ainda não está ativa.</strong>
                Você pode configurar sua empresa por aqui, mas agendamentos, clientes e os
                demais recursos só são liberados depois do pagamento.
            </div>
            <a asp-controller="Assinatura" asp-action="Index" class="btn btn-dark btn-sm text-nowrap">
                Assinar agora
            </a>
        </div>
    }

    @if (!Model.OnboardingConcluido)
    {
        var totalPassos = Model.OnboardingPassos.Count;
        var passosConcluidos = Model.OnboardingPassos.Count(p => p.Concluido);
        var progresso = totalPassos == 0 ? 0 : (int)Math.Round(passosConcluidos * 100.0 / totalPassos);

        <div class="card shadow-sm mb-4 border-primary">
            <div class="card-body">

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-rocket-takeoff text-primary"></i>
                        Vamos configurar sua empresa
                    </h5>
                    <span class="text-muted small">@passosConcluidos de @totalPassos concluídos</span>
                </div>

                <div class="progress mb-3" style="height:8px;">
                    <div class="progress-bar bg-primary" role="progressbar"
                         style="width:@progresso%;" aria-valuenow="@progresso" aria-valuemin="0" aria-valuemax="100"></div>
                </div>

                <div class="row g-2">
                    @foreach (var passo in Model.OnboardingPassos)
                    {
                        <div class="col-md-6 col-lg-3">
                            <a asp-controller="@passo.ControllerName" asp-action="@passo.ActionName"
                               class="text-decoration-none">
                                <div class="border rounded p-3 h-100 @(passo.Concluido ? "bg-light" : "")">
                                    <div class="d-flex align-items-start gap-2">
                                        @if (passo.Concluido)
                                        {
                                            <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                        }
                                        else
                                        {
                                            <i class="bi @passo.Icone text-primary fs-5"></i>
                                        }
                                        <div>
                                            <div class="fw-semibold small text-dark @(passo.Concluido ? "text-decoration-line-through text-muted" : "")">
                                                @passo.Titulo
                                            </div>
                                            <div class="text-muted small">
                                                @passo.Descricao
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>

            </div>
        </div>
    }

    <!-- KPIs -->
    <div class="row g-3 mb-4">

        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm p-3 text-center">
                <h6 class="text-muted">Agendamentos Hoje</h6>
                <h3 class="fw-bold">@Model.TotalAgendamentosHoje</h3>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm p-3 text-center">
                <h6 class="text-muted">Faturamento Mensal</h6>
                <h3 class="text-success fw-bold">
                    @Model.FaturamentoMensal.ToString("C")
                </h3>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm p-3 text-center">
                <h6 class="text-muted">Clientes Ativos</h6>
                <h3 class="fw-bold">@Model.TotalClientes</h3>
            </div>
        </div>

        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm p-3 text-center">
                <h6 class="text-muted">Crescimento</h6>
                <h3 class="text-primary fw-bold">
                    @Math.Round(Model.Crescimento, 2)%
                </h3>
            </div>
        </div>

    </div>

    <!-- GRÁFICOS -->
    <div class="row g-3 mb-4">

        <div class="col-lg-6">
            <div class="card shadow-sm p-3">
                <h6>Faturamento Mensal</h6>

                <div style="height:300px">
                    <canvas id="graficoFaturamento"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm p-3">
                <h6>Serviços Populares</h6>

                <div style="height:300px">
                    <canvas id="graficoServicos"></canvas>
                </div>
            </div>
        </div>

    </div>

    <!-- AGENDAMENTOS -->
    <div class="card shadow-sm">

        <div class="card-body">

            <h5 class="fw-bold mb-3">
                Agendamentos de Hoje
            </h5>

            @if (Model.AgendamentosHoje.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Hora</th>
                                <th>Cliente</th>
                                <th>Funcionário</th>
                                <th>Serviço</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var ag in Model.AgendamentosHoje)
                            {
                                string badge = ag.Status.ToString() switch
                                {
                                    "Agendado" => "bg-primary",
                                    "Confirmado" => "bg-success",
                                    "Cancelado" => "bg-danger",
                                    "Finalizado" => "bg-secondary",
                                    _ => "bg-secondary"
                                };

                                <tr>

                                    <td>
                                        @ag.DataHora.ToString("HH:mm")
                                    </td>

                                    <td>
                                        @(ag.Cliente?.Nome
                                            ?? ag.NomeClienteAvulso
                                            ?? "-")
                                    </td>

                                    <td>
                                        @(ag.Funcionario?.Nome ?? "-")
                                    </td>

                                    <td>
                                        @ag.Servico?.Nome
                                    </td>

                                    <td>
                                        <span class="badge @badge">
                                            @ag.Status
                                        </span>
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="alert alert-info">
                    Nenhum agendamento para hoje.
                </div>
            }

        </div>

    </div>

</div>

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>

        const meses =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.FaturamentoPorMes.Select(x =>
                            System.Globalization.CultureInfo
                            .CurrentCulture
                            .DateTimeFormat
                            .GetMonthName(x.Mes))
                    ));

        const faturamento =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.FaturamentoPorMes.Select(x => x.Total)
                    ));

        const servicos =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.ServicosPopulares.Select(x => x.Servico)
                    ));

        const quantidades =
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.ServicosPopulares.Select(x => x.Quantidade)
                    ));

        new Chart(
            document.getElementById("graficoFaturamento"),
            {
                type: "bar",
                data: {
                    labels: meses,
                    datasets: [{
                        data: faturamento
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false
                }
            });

        new Chart(
            document.getElementById("graficoServicos"),
            {
                type: "doughnut",
                data: {
                    labels: servicos,
                    datasets: [{
                        data: quantidades
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false
                }
            });

    </script>
}