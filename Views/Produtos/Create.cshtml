@model EmpresaAgendamento.Models.Produto

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-body">
            <h4 class="mb-4">Novo Produto</h4>

            <div asp-validation-summary="All" class="text-danger"></div>

            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label">Nome</label>
                    <input asp-for="Nome" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Descrição</label>
                    <textarea asp-for="Descricao" class="form-control"></textarea>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Preço</label>
                        <input asp-for="Preco" class="form-control" data-mask="dinheiro" placeholder="R$ 0,00" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Estoque inicial</label>
                        <input asp-for="QuantidadeEstoque" type="number" min="0" class="form-control" />
                    </div>
                </div>

                <div class="mb-3 mt-3">
                    <label class="form-label">Foto</label>
                    <input type="file" name="fotoFile" accept="image/png,image/jpeg,image/webp,image/gif" class="form-control" />
                    <small class="text-muted">PNG, JPG, WEBP ou GIF — até 2 MB.</small>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">Salvar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
                </div>
            </form>
        </div>
    </div>
</div>
