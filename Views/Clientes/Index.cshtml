@model IEnumerable<EmpresaAgendamento.Models.Cliente>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold">Clientes</h3>
        <a asp-action="Create" class="btn btn-primary">+ Novo Cliente</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <table class="table table-hover table-fixed">
                <thead class="table-light">
                    <tr>
                        <th style="width: 35%;">Nome</th>
                        <th style="width: 25%;">Telefone</th>
                        <th style="width: 25%;">Email</th>
                        <th style="width: 15%;" class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Nome</td>
                            <td>@item.Telefone</td>
                            <td>@item.Email</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>