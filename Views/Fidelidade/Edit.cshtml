@model EmpresaAgendamento.Models.ViewModels.ProgramaFidelidadeViewModel
@using EmpresaAgendamento.Models.Enums

<div class="container-fluid mt-4">

    <h3 class="fw-bold mb-3">Editar Programa de Fidelidade</h3>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">

        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="row">
            <div class="col-lg-8">

                <div class="card shadow-sm">
                    <div class="card-body">

                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="row g-3">

                            <div class="col-md-8">
                                <label class="form-label">Aplica a</label>
                                <select asp-for="ServicoId" class="form-select">
                                    <option value="">Qualquer serviço (geral)</option>
                                    @foreach (var servico in Model.ServicosDisponiveis)
                                    {
                                        <option value="@servico.Value">@servico.Text</option>
                                    }
                                </select>
                                <small class="text-muted">
                                    Escolha um serviço pra contar só as visitas desse serviço, ou deixe "qualquer serviço" pra valer em todo agendamento finalizado.
                                </small>
                            </div>

                            <div class="col-md-4 form-check form-switch pt-4">
                                <input asp-for="Ativo" class="form-check-input" />
                                <label class="form-check-label" asp-for="Ativo">Programa ativo</label>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Visitas necessárias</label>
                                <input asp-for="VisitasNecessarias" type="number" min="1" max="100" class="form-control" />
                                <span asp-validation-for="VisitasNecessarias" class="text-danger"></span>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Tipo de desconto</label>
                                <select asp-for="TipoDesconto" class="form-select"
                                        asp-items="Html.GetEnumSelectList<TipoDescontoFidelidade>()">
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Valor do desconto</label>
                                <input asp-for="ValorDesconto" type="number" step="0.01" min="0.01" class="form-control" />
                                <span asp-validation-for="ValorDesconto" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Salvar</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
                        </div>

                    </div>
                </div>

            </div>
        </div>

    </form>

</div>
