@model EmpresaAgendamento.Models.ViewModels.RelatorioDetalhadoViewModel
@using EmpresaAgendamento.Models.Enums
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Relatório detalhado";

    var categorias = ViewBag.CategoriasRelatorio as SelectList;
    var funcionarios = ViewBag.FuncionariosRelatorio as SelectList;
    var clientes = ViewBag.ClientesRelatorio as SelectList;
}

<div class="container-fluid mt-4">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
        <h3 class="fw-bold mb-0">Relatório detalhado</h3>

        <a asp-action="Relatorios" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Voltar
        </a>
    </div>

    <!-- FILTRO ÚNICO — usado tanto para ver os dados aqui quanto para a impressão -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" asp-action="RelatorioDetalhado" class="row g-2 align-items-end">
                <div class="col-md-3 col-sm-6">
                    <label class="form-label">De</label>
                    <input type="date" name="dataInicial" class="form-control"
                           value="@Model.DataInicial.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label">Até</label>
                    <input type="date" name="dataFinal" class="form-control"
                           value="@Model.DataFinal.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label">Tipo</label>
                    <select name="tipo" class="form-select">
                        <option value="">Todos</option>
                        @foreach (var t in Enum.GetValues<TipoMovimentacao>())
                        {
                            <option value="@t" selected="@(Model.TipoSelecionado == t)">@t</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label">Categoria</label>
                    <select name="categoriaId" class="form-select" asp-items="categorias">
                        <option value="">Todas</option>
                    </select>
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label">Forma de pagamento</label>
                    <select name="formaPagamento" class="form-select">
                        <option value="">Todas</option>
                        @foreach (var f in Enum.GetValues<FormaPagamento>())
                        {
                            <option value="@f" selected="@(Model.FormaPagamentoSelecionada == f)">@f</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label">Funcionário</label>
                    <select name="funcionarioId" class="form-select" asp-items="funcionarios">
                        <option value="">Todos</option>
                    </select>
                </div>
                <div class="col-md-3 col-sm-6">
                    <label class="form-label">Cliente</label>
                    <select name="clienteId" class="form-select" asp-items="clientes">
                        <option value="">Todos</option>
                    </select>
                </div>
                <div class="col-md-3 col-sm-6">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search me-1"></i>Filtrar
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- RESULTADO DO FILTRO -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mb-3">
                <div>
                    <h6 class="fw-bold mb-1">Movimentações filtradas</h6>
                    <span class="text-muted small">
                        Período: @Model.DataInicial.ToString("dd/MM/yyyy") a @Model.DataFinal.ToString("dd/MM/yyyy")
                        — @Model.Itens.Count item(ns)
                    </span>
                </div>

                <a asp-action="RelatorioDetalhadoImpressao"
                   asp-route-dataInicial="@Model.DataInicial.ToString("yyyy-MM-dd")"
                   asp-route-dataFinal="@Model.DataFinal.ToString("yyyy-MM-dd")"
                   asp-route-tipo="@Model.TipoSelecionado"
                   asp-route-categoriaId="@Model.CategoriaIdSelecionada"
                   asp-route-formaPagamento="@Model.FormaPagamentoSelecionada"
                   asp-route-funcionarioId="@Model.FuncionarioIdSelecionado"
                   asp-route-clienteId="@Model.ClienteIdSelecionado"
                   target="_blank"
                   class="btn btn-dark">
                    <i class="bi bi-printer me-1"></i>Gerar relatório para impressão
                </a>
            </div>

            @if (!Model.Itens.Any())
            {
                <p class="text-muted small mb-0">Nenhuma movimentação encontrada para os filtros selecionados.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Data</th>
                                <th>Descrição</th>
                                <th>Cliente</th>
                                <th>Categoria</th>
                                <th>Forma de pagamento</th>
                                <th class="text-end">Entrada</th>
                                <th class="text-end">Saída</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Itens)
                            {
                                <tr>
                                    <td>@item.Data.ToString("dd/MM/yyyy")</td>
                                    <td>@item.Descricao</td>
                                    <td>@(item.Cliente ?? "-")</td>
                                    <td>@(item.Categoria ?? "-")</td>
                                    <td>@(item.FormaPagamento ?? "-")</td>
                                    <td class="text-end text-success">@(item.Entrada > 0 ? item.Entrada.ToString("C") : "-")</td>
                                    <td class="text-end text-danger">@(item.Saida > 0 ? item.Saida.ToString("C") : "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="row justify-content-end mt-2">
                    <div class="col-md-4">
                        <table class="table table-sm mb-0">
                            <tr>
                                <td class="text-muted">Total de entradas</td>
                                <td class="text-end fw-bold text-success">@Model.TotalEntradas.ToString("C")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Total de saídas</td>
                                <td class="text-end fw-bold text-danger">@Model.TotalSaidas.ToString("C")</td>
                            </tr>
                            <tr class="border-top">
                                <td class="fw-bold">Saldo do período</td>
                                <td class="text-end fw-bold @(Model.Saldo >= 0 ? "text-success" : "text-danger")">@Model.Saldo.ToString("C")</td>
                            </tr>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>

</div>
