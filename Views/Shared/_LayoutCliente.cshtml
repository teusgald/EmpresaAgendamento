@using EmpresaAgendamento.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using EmpresaAgendamento.Models
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext _context

@{
    var userId = UserManager.GetUserId(User);

    var clienteInfo = await _context.Users
        .Where(u => u.Id == userId)
        .Select(u => new { u.ClienteId, Nome = u.Cliente.Nome })
        .FirstOrDefaultAsync();

    var nomeUsuario = clienteInfo?.Nome;

    var notificacoesNaoLidas = clienteInfo?.ClienteId != null
        ? await _context.Notificacoes.CountAsync(n => n.ClienteId == clienteInfo.ClienteId && !n.Lida)
        : 0;

    string Iniciais(string? nome)
    {
        if (string.IsNullOrWhiteSpace(nome)) return "?";
        var partes = nome.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(partes.Take(2).Select(p => char.ToUpper(p[0])));
    }
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - Simpli Time</title>
    <link rel="icon" type="image/png" href="/img/icon.png?v=3" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#111111" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Simpli Time" />
    <link rel="apple-touch-icon" href="/img/icon-192.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    @if (clienteInfo?.ClienteId != null)
    {
        <a asp-controller="Notificacoes" asp-action="Index" class="sino-notificacoes" title="Notificações">
            <i class="bi bi-bell"></i>
            @if (notificacoesNaoLidas > 0)
            {
                <span class="badge-contador">@(notificacoesNaoLidas > 9 ? "9+" : notificacoesNaoLidas.ToString())</span>
            }
        </a>
    }

    <!-- SIDEBAR -->
    <div class="sidebar" id="sidebar">
        <h4>👤 Cliente</h4>
        <hr />

        <ul class="nav flex-column">

            <li>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "ClienteInicio" ? "active" : "")"
                   asp-controller="ClienteInicio" asp-action="Index">
                    <i class="bi bi-house"></i>
                    <span class="link-text">Início</span>
                </a>
            </li>

            <li>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AgendamentosClientes" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                   asp-controller="AgendamentosClientes" asp-action="Index">
                    <i class="bi bi-list-check"></i>
                    <span class="link-text">Meus Agendamentos</span>
                </a>
            </li>

            <li>
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")"
                   asp-controller="AgendamentosClientes" asp-action="Create">
                    <i class="bi bi-plus-circle"></i>
                    <span class="link-text">Novo Agendamento</span>
                </a>
            </li>

            <li>
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PlanosCliente" ? "active" : "")"
                   asp-controller="PlanosCliente" asp-action="Index">
                    <i class="bi bi-card-checklist"></i>
                    <span class="link-text">Meus Planos</span>
                </a>
            </li>

        </ul>

        <div class="sidebar-secondary px-2 py-2">
            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Ajuda" ? "active" : "")"
               asp-controller="Ajuda" asp-action="Index">
                <i class="bi bi-question-circle"></i>
                <span class="link-text">Ajuda</span>
            </a>

            <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Atendimento" ? "active" : "")"
               asp-controller="Atendimento" asp-action="Index">
                <i class="bi bi-headset"></i>
                <span class="link-text">Atendimento</span>
            </a>

            <a class="nav-link" href="#" id="instalarAppLink" hidden>
                <i class="bi bi-download"></i>
                <span class="link-text">Instalar app</span>
            </a>
        </div>

        <div class="sidebar-footer">
            <div class="user-card">
                <div class="user-avatar">@Iniciais(nomeUsuario)</div>
                <div class="user-info">
                    <span class="user-name" title="@nomeUsuario">@(nomeUsuario ?? "Usuário")</span>
                    <span class="user-role">Cliente</span>
                </div>
                <form method="post" action="/logout">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="user-logout" title="Sair">
                        <i class="bi bi-box-arrow-right"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- CONTEÚDO -->
    <div class="content content-cliente" id="content">

        <!-- TOPBAR (só existe de verdade no mobile — é onde mora o botão do
             menu; o título de cada tela já aparece uma vez só, dentro do
             conteúdo, no padrão do Dashboard) -->
        <div class="topbar">
            <span class="hamburger" id="hamburger">
                <i class="bi bi-list"></i>
            </span>
            <span class="topbar-brand">Portal</span>

            @if (clienteInfo?.ClienteId != null)
            {
                <a asp-controller="Notificacoes" asp-action="Index" class="topbar-sino" title="Notificações">
                    <i class="bi bi-bell"></i>
                    @if (notificacoesNaoLidas > 0)
                    {
                        <span class="badge-contador">@(notificacoesNaoLidas > 9 ? "9+" : notificacoesNaoLidas.ToString())</span>
                    }
                </a>
            }
        </div>

        <!-- BODY -->
        <div class="p-4 portal-content-body">
            @RenderBody()
        </div>

        <!-- FOOTER -->
        <footer class="portal-footer">
            <span>© @DateTime.Now.Year Simpli Time — todos os direitos reservados</span>
            <a asp-controller="Atendimento" asp-action="Index">Atendimento</a>
        </footer>

    </div>

    

    @await RenderSectionAsync("Scripts", required: false)
    <div id="toast-container" class="toast-container"></div>

    @if (TempData["ToastMessage"] != null)
    {
        <script>
            window.onload = function () {
                showToast("@TempData["ToastMessage"]", "@TempData["ToastType"]");
            };
        </script>
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/pwa-cliente.js" asp-append-version="true"></script>
    <script src="~/js/masks.js" asp-append-version="true"></script>

    <script>
        const sidebar = document.getElementById('sidebar');
        const hamburger = document.getElementById('hamburger');

        hamburger.addEventListener('click', () => {
            sidebar.classList.toggle('show');
        });

                        function showToast(message, type) {

            const container = document.getElementById("toast-container");

            if (!container) return;

            const toast = document.createElement("div");

            toast.style.position = "fixed";
            toast.style.top = "20px";
            toast.style.right = "20px";
            toast.style.zIndex = "999999";
            toast.style.minWidth = "300px";
            toast.style.padding = "15px";
            toast.style.borderRadius = "10px";
            toast.style.boxShadow = "0 4px 12px rgba(0,0,0,.15)";
            toast.style.color = "#fff";
            toast.style.fontWeight = "500";
            toast.style.animation = "slideIn 0.3s ease";

            if (type === "success") {
                toast.style.backgroundColor = "#198754";
                toast.innerHTML = "✅ " + message;
            }
            else if (type === "error") {
                toast.style.backgroundColor = "#dc3545";
                toast.innerHTML = "❌ " + message;
            }
            else {
                toast.style.backgroundColor = "#ffc107";
                toast.style.color = "#000";
                toast.innerHTML = "⚠️ " + message;
            }

            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = "0";

                setTimeout(() => {
                    toast.remove();
                }, 300);
            }, 3000);
        }
    </script>
</body>
</html>