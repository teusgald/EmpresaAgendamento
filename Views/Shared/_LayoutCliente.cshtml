@using EmpresaAgendamento.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using EmpresaAgendamento.Models
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext _context

@{
    var userId = UserManager.GetUserId(User);

    var nomeUsuario = await _context.Users
        .Where(u => u.Id == userId)
        .Include(u => u.Cliente)
        .Select(u => u.Cliente.Nome)
        .FirstOrDefaultAsync();
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Área do Cliente</title>
    <link rel="icon" type="image/png" href="/img/icon.png?v=3" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>

<body>

    <!-- SIDEBAR -->
    <div class="sidebar" id="sidebar">
        <h4>👤 Cliente</h4>
        <hr />

        <ul class="nav flex-column">

            <li>
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                   asp-controller="AgendamentosClientes" asp-action="Index">
                    <i class="bi bi-list-check"></i>
                    <span class="link-text">Meus Agendamentos</span>
                </a>
            </li>

            <li>
                <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Create" ? "active" : "")"
                   asp-controller="AgendamentosClientes" asp-action="Create">
                    <i class="bi bi-plus-circle"></i>
                    <span class="link-text">Novo Agendamento</span>
                </a>
            </li>

        </ul>

        <div class="sidebar-footer d-flex flex-column px-2 py-2">

            <span class="mb-2 fw-semibold text-white">
                Bem-vindo,<br>  @nomeUsuario 
            </span>

            <form method="post" action="/logout" class="d-inline">
                <button type="submit" class="btn btn-link text-danger text-decoration-none p-0">
                    <i class="bi bi-box-arrow-right me-1"></i> Sair
                </button>
            </form>

        </div>
    </div>

    <!-- CONTEÚDO -->
    <div class="content" id="content">

        <!-- TOPBAR -->
        <div class="topbar">
            <span class="hamburger" id="hamburger">
                <i class="bi bi-list"></i>
            </span>
            <h5 class="mb-0">@ViewData["Title"]</h5>
        </div>

        <!-- BODY -->
        <div class="mt-5 p-4">
            @RenderBody()
        </div>

    </div>

    

    @await RenderSectionAsync("Scripts", required: false)
    <div id="toast-container" class="toast-container"></div>

    @if (TempData["ToastMessage"] != null)
    {
        <script>
            window.onload = function () {
                showToast("@TempData["ToastMessage"]", "@TempData["ToastType"]");
            };
        </script>
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const sidebar = document.getElementById('sidebar');
        const hamburger = document.getElementById('hamburger');

        hamburger.addEventListener('click', () => {
            sidebar.classList.toggle('show');
        });

                        function showToast(message, type) {

            const container = document.getElementById("toast-container");

            if (!container) return;

            const toast = document.createElement("div");

            toast.style.position = "fixed";
            toast.style.top = "20px";
            toast.style.right = "20px";
            toast.style.zIndex = "999999";
            toast.style.minWidth = "300px";
            toast.style.padding = "15px";
            toast.style.borderRadius = "10px";
            toast.style.boxShadow = "0 4px 12px rgba(0,0,0,.15)";
            toast.style.color = "#fff";
            toast.style.fontWeight = "500";
            toast.style.animation = "slideIn 0.3s ease";

            if (type === "success") {
                toast.style.backgroundColor = "#198754";
                toast.innerHTML = "✅ " + message;
            }
            else if (type === "error") {
                toast.style.backgroundColor = "#dc3545";
                toast.innerHTML = "❌ " + message;
            }
            else {
                toast.style.backgroundColor = "#ffc107";
                toast.style.color = "#000";
                toast.innerHTML = "⚠️ " + message;
            }

            container.appendChild(toast);

            setTimeout(() => {
                toast.style.opacity = "0";

                setTimeout(() => {
                    toast.remove();
                }, 300);
            }, 3000);
        }
    </script>
</body>
</html>