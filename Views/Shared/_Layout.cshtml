@using EmpresaAgendamento.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using EmpresaAgendamento.Models
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext _context

@{
	var userId = UserManager.GetUserId(User);

	var nomeUsuario = await _context.Users
		.Where(u => u.Id == userId)
		.Include(u => u.Empresa)
		.Select(u => u.Empresa.Nome)
		.FirstOrDefaultAsync();
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - EmpresaAgendamento</title>
	<link rel="icon" type="image/png" href="/img/icon.png?v=3" />
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
	<link rel="stylesheet" href="~/css/site.css" />

	<script>
				const empresaSelect = document.getElementById("empresaSelect");

		if (empresaSelect) {
			empresaSelect.addEventListener("change", function () {

				var empresaId = this.value;

				const servicoSelect = document.getElementById("servicoSelect");

				if (!servicoSelect) return;

				servicoSelect.innerHTML = '<option value="">Carregando...</option>';

				fetch('/AgendamentosCliente/GetServicosByEmpresa?empresaId=' + empresaId)
					.then(response => response.json())
					.then(data => {

						servicoSelect.innerHTML = '<option value="">Selecione</option>';

						data.forEach(function (servico) {
							var option = document.createElement("option");
							option.value = servico.id;
							option.text = servico.nome;
							servicoSelect.appendChild(option);
						});

					})
					.catch(error => {
						console.error("Erro ao carregar serviços:", error);
						servicoSelect.innerHTML = '<option value="">Erro ao carregar</option>';
					});
			});
		}

				$("#forgotForm").submit(function (e) {

			e.preventDefault();

			$.ajax({
				url: "/forgot",
				type: "POST",
				data: $(this).serialize(),

				success: function (response) {

					if (response.success) {

						alert("Email de recuperação enviado com sucesso.");

					} else {

						alert(response.error);
					}
				},

				error: function () {

					alert("Erro ao enviar email.");
				}
			});

		});
	</script>
</head>
<body>

	<!-- SIDEBAR -->
	<div class="sidebar" id="sidebar">
		<h4>🚀 Sistema</h4>
		<hr />
		<ul class="nav flex-column">

			<!-- DASHBOARD -->
			<li class="nav-item">
				<a class="nav-link" asp-controller="Empresas" asp-action="Dashboard">
					<i class="bi bi-bar-chart"></i>
					<span class="link-text">Dashboard</span>
				</a>
			</li>

			<!-- CALENDÁRIO -->
			<li class="nav-item">
				<a class="nav-link" asp-controller="Agendamentos" asp-action="Calendario">
					<i class="bi bi-calendar"></i>
					<span class="link-text">Calendário</span>
				</a>
			</li>

			<!-- AGENDAMENTOS -->
			<li class="nav-item">
				<a class="nav-link" asp-controller="Agendamentos" asp-action="Index">
					<i class="bi bi-list-check"></i>
					<span class="link-text">Agendamentos</span>
				</a>
			</li>

			<!-- ========================= -->
			<!-- CADASTROS (DROPDOWN) -->
			<!-- ========================= -->
			<li class="nav-item">

				<a class="nav-link d-flex justify-content-between align-items-center"
				   data-bs-toggle="collapse"
				   href="#cadastrosMenu"
				   role="button"
				   aria-expanded="false">

					<span>
						<i class="bi bi-folder"></i>
						<span class="link-text">Cadastros</span>
					</span>

					<i class="bi bi-chevron-down small"></i>
				</a>

				<div class="collapse ps-3" id="cadastrosMenu">

					<ul class="nav flex-column">

						<li>
							<a class="nav-link" asp-controller="Clientes" asp-action="Index">
								<i class="bi bi-people"></i>
								<span class="link-text">Clientes</span>
							</a>
						</li>

						<li>
							<a class="nav-link" asp-controller="Servicos" asp-action="Index">
								<i class="bi bi-scissors"></i>
								<span class="link-text">Serviços</span>
							</a>
						</li>

						<li>
							<a class="nav-link" asp-controller="Funcionarios" asp-action="Index">
								<i class="bi bi-person-badge"></i>
								<span class="link-text">Funcionários</span>
							</a>
						</li>

					</ul>

				</div>

			</li>

			<!-- ========================= -->
			<!-- FINANCEIRO (FUTURO) -->
			<!-- ========================= -->
			<li class="nav-item">

				<a class="nav-link d-flex justify-content-between align-items-center"
				   data-bs-toggle="collapse"
				   href="#financeiroMenu"
				   role="button"
				   aria-expanded="false">

					<span>
						<i class="bi bi-cash-coin"></i>
						<span class="link-text">Financeiro</span>
					</span>

					<i class="bi bi-chevron-down small"></i>
				</a>

				<div class="collapse ps-3" id="financeiroMenu">

					<ul class="nav flex-column">

						<li>
							<a class="nav-link disabled" href="#">
								<i class="bi bi-receipt"></i>
								<span class="link-text">Receitas</span>
							</a>
						</li>

						<li>
							<a class="nav-link disabled" href="#">
								<i class="bi bi-wallet2"></i>
								<span class="link-text">Despesas</span>
							</a>
						</li>

						<li>
							<a class="nav-link disabled" href="#">
								<i class="bi bi-graph-up"></i>
								<span class="link-text">Relatórios</span>
							</a>
						</li>

					</ul>

				</div>

			</li>

			<!-- EMPRESAS -->
			<li class="nav-item">
				<a class="nav-link" asp-controller="Empresas" asp-action="Index">
					<i class="bi bi-building"></i>
					<span class="link-text">Empresas</span>
				</a>
			</li>

		</ul>

		<div class="sidebar-footer d-flex flex-column px-2 py-2">

			<span class="mb-2 fw-semibold text-white">
				Bem-vindo,<br>  @nomeUsuario
			</span>

			<form method="post" action="/logout" class="d-inline">
				<button type="submit" class="btn btn-link text-danger text-decoration-none p-0">
					<i class="bi bi-box-arrow-right me-1"></i> Sair
				</button>
			</form>

		</div>
	</div>

	<!-- CONTEÚDO -->
	<div class="content" id="content">

		<!-- TOPBAR -->
		<div class="topbar">
			<span class="hamburger" id="hamburger"><i class="bi bi-list"></i></span>
			<h5 class="mb-0">@ViewData["Title"]</h5>
		</div>

		<!-- CORPO -->
		<div class="mt-5 p-4">
			@RenderBody()
		</div>

	</div>


	<div id="toast-container" class="toast-container"></div>

	@await RenderSectionAsync("Scripts", required: false)

	@if (TempData["ToastMessage"] != null)
	{
		<script>
			document.addEventListener("DOMContentLoaded", function () {
				showToast(
					"@TempData["ToastMessage"]",
					"@TempData["ToastType"]"
				);
			});
		</script>
	}

	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script>
				const sidebar = document.getElementById('sidebar');
		const hamburger = document.getElementById('hamburger');
		const overlay = document.getElementById('overlay');

		if (hamburger) {
			hamburger.addEventListener('click', () => {
				sidebar.classList.toggle('show');

				if (overlay) {
					overlay.classList.toggle('show');
				}
			});
		}

		if (overlay) {
			overlay.addEventListener('click', () => {
				sidebar.classList.remove('show');
				overlay.classList.remove('show');
			});
		}

										function showToast(message, type) {

			const container = document.getElementById("toast-container");

			if (!container) return;

			const toast = document.createElement("div");

			toast.style.position = "fixed";
			toast.style.top = "20px";
			toast.style.right = "20px";
			toast.style.zIndex = "999999";
			toast.style.minWidth = "300px";
			toast.style.padding = "15px";
			toast.style.borderRadius = "10px";
			toast.style.boxShadow = "0 4px 12px rgba(0,0,0,.15)";
			toast.style.color = "#fff";
			toast.style.fontWeight = "500";
			toast.style.animation = "slideIn 0.3s ease";

			if (type === "success") {
				toast.style.backgroundColor = "#198754";
				toast.innerHTML = "✅ " + message;
			}
			else if (type === "error") {
				toast.style.backgroundColor = "#dc3545";
				toast.innerHTML = "❌ " + message;
			}
			else {
				toast.style.backgroundColor = "#ffc107";
				toast.style.color = "#000";
				toast.innerHTML = "⚠️ " + message;
			}

			container.appendChild(toast);

			setTimeout(() => {
				toast.style.opacity = "0";

				setTimeout(() => {
					toast.remove();
				}, 300);
			}, 3000);
		}
	</script>
</body>
</html>