@using EmpresaAgendamento.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using EmpresaAgendamento.Models
@inject UserManager<ApplicationUser> UserManager
@inject ApplicationDbContext _context

@{
	var userId = UserManager.GetUserId(User);

	var empresaInfo = await _context.Users
		.Where(u => u.Id == userId)
		.Select(u => new {
			u.EmpresaId, u.Empresa.Nome, u.Empresa.LogoUrl, u.Empresa.AssinaturaStatus, u.Empresa.VipAcesso,
			u.Empresa.SimpliAiBetaAtivo,
			SimpliAiPermitidoPeloPlano = u.Empresa.Plano != null && u.Empresa.Plano.PermiteIA
		})
		.FirstOrDefaultAsync();

	var simpliAiAtivo = empresaInfo?.EmpresaId != null &&
		(empresaInfo.SimpliAiBetaAtivo || empresaInfo.SimpliAiPermitidoPeloPlano);

	var nomeUsuario = empresaInfo?.Nome;
	var logoEmpresa = empresaInfo?.LogoUrl;

	var assinaturaAtiva =
		empresaInfo?.VipAcesso == true ||
		empresaInfo?.AssinaturaStatus == "active" ||
		empresaInfo?.AssinaturaStatus == "trialing";

	var notificacoesNaoLidas = empresaInfo?.EmpresaId != null
		? await _context.Notificacoes.CountAsync(n => n.EmpresaId == empresaInfo.EmpresaId && !n.Lida)
		: 0;

	// Funcionário "Gerente" também vê Serviços, Fidelidade e o módulo
	// Financeiro — Funcionário "Padrão" continua só com Calendário,
	// Agendamentos e Clientes.
	var ehFuncionario = User.IsInRole("Funcionario");

	var nivelAcessoFuncionario = ehFuncionario
		? await _context.Funcionarios
			.Where(f => f.UserId == userId)
			.Select(f => (EmpresaAgendamento.Models.Enums.NivelAcessoFuncionario?)f.NivelAcesso)
			.FirstOrDefaultAsync()
		: null;

	var ehGerente = nivelAcessoFuncionario == EmpresaAgendamento.Models.Enums.NivelAcessoFuncionario.Gerente;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Simpli Time</title>
	<link rel="icon" type="image/png" href="/img/icon.png?v=3" />

	<!-- PWA — manifest próprio do portal da Empresa/Funcionário (start_url
	     de dashboard da empresa; não pode usar /manifest.json, que é do
	     portal do Cliente e abriria sempre em /Cliente). -->
	<link rel="manifest" href="/manifest-empresa.json" />
	<meta name="theme-color" content="#111111" />
	<meta name="mobile-web-app-capable" content="yes" />
	<meta name="apple-mobile-web-app-capable" content="yes" />
	<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
	<meta name="apple-mobile-web-app-title" content="Simpli Time" />
	<link rel="apple-touch-icon" href="/img/icon-192.png" />

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<style>
		.nav-locked {
			opacity: .45;
			pointer-events: none;
			cursor: not-allowed;
		}

		.nav-locked .bi-chevron-down {
			display: none;
		}
	</style>

	<script>
				const empresaSelect = document.getElementById("empresaSelect");

		if (empresaSelect) {
			empresaSelect.addEventListener("change", function () {

				var empresaId = this.value;

				const servicoSelect = document.getElementById("servicoSelect");

				if (!servicoSelect) return;

				servicoSelect.innerHTML = '<option value="">Carregando...</option>';

				fetch('/AgendamentosCliente/GetServicosByEmpresa?empresaId=' + empresaId)
					.then(response => response.json())
					.then(data => {

						servicoSelect.innerHTML = '<option value="">Selecione</option>';

						data.forEach(function (servico) {
							var option = document.createElement("option");
							option.value = servico.id;
							option.text = servico.nome;
							servicoSelect.appendChild(option);
						});

					})
					.catch(error => {
						console.error("Erro ao carregar serviços:", error);
						servicoSelect.innerHTML = '<option value="">Erro ao carregar</option>';
					});
			});
		}

				$("#forgotForm").submit(function (e) {

			e.preventDefault();

			$.ajax({
				url: "/forgot",
				type: "POST",
				data: $(this).serialize(),

				success: function (response) {

					if (response.success) {

						alert("Email de recuperação enviado com sucesso.");

					} else {

						alert(response.error);
					}
				},

				error: function () {

					alert("Erro ao enviar email.");
				}
			});

		});
	</script>
</head>
<body>

	@if (empresaInfo?.EmpresaId != null)
	{
		<a asp-controller="Notificacoes" asp-action="Index" class="sino-notificacoes" title="Notificações">
			<i class="bi bi-bell"></i>
			@if (notificacoesNaoLidas > 0)
			{
				<span class="badge-contador">@(notificacoesNaoLidas > 9 ? "9+" : notificacoesNaoLidas.ToString())</span>
			}
		</a>
	}

	@if (simpliAiAtivo && ViewData["OcultarSimpliAiBolha"] == null)
	{
		<form id="simpli-ai-token-form" style="display:none">
			@Html.AntiForgeryToken()
		</form>

		<button type="button" class="simpli-ai-bolha" id="simpliAiBolha" title="Simpli AI">
			<i class="bi bi-stars"></i>
		</button>

		<div class="simpli-ai-painel" id="simpliAiPainel">
			<div class="simpli-ai-painel-header">
				<div>
					Simpli AI
					<small>beta — pode errar</small>
				</div>
				<button type="button" id="simpliAiFechar">✕</button>
			</div>
			<div class="simpli-ai-mensagens" id="simpliAiMensagens">
				<div class="simpli-ai-msg model">Oi! Como posso te ajudar hoje? Pergunte sobre seus agendamentos ou financeiro.</div>
			</div>
			<form class="simpli-ai-painel-form" id="simpliAiForm">
				<input type="text" id="simpliAiInput" placeholder="Digite sua pergunta..." autocomplete="off" />
				<button type="submit"><i class="bi bi-send"></i></button>
			</form>
		</div>
	}

	<!-- SIDEBAR -->
	<div class="sidebar" id="sidebar">
		@if (!string.IsNullOrEmpty(logoEmpresa))
		{
			<div class="sidebar-logo-wrap">
				<img src="@logoEmpresa" alt="Logo" class="sidebar-logo" />
			</div>
		}
		else
		{
			<h4>🚀 Sistema</h4>
		}
		<hr />
		<ul class="nav flex-column">

			@{
				// Dono da empresa sem assinatura ativa só pode ver Dashboard e
				// Assinatura — o resto do menu fica travado até ele pagar.
				var menuBloqueado = !ehFuncionario && !assinaturaAtiva;
			}

			@if (!ehFuncionario)
			{
				<!-- DASHBOARD -->
				<li class="nav-item">
					<a class="nav-link" asp-controller="Empresas" asp-action="Dashboard">
						<i class="bi bi-bar-chart"></i>
						<span class="link-text">Dashboard</span>
					</a>
				</li>
			}

			@if (simpliAiAtivo)
			{
				<!-- SIMPLI AI -->
				<li class="nav-item">
					<a class="nav-link" asp-controller="SimpliAi" asp-action="Index">
						<i class="bi bi-stars"></i>
						<span class="link-text">Simpli AI</span>
					</a>
				</li>
			}

			<!-- CALENDÁRIO -->
			<li class="nav-item @(menuBloqueado ? "nav-locked" : "")">
				<a class="nav-link" asp-controller="Agendamentos" asp-action="Calendario">
					<i class="bi bi-calendar"></i>
					<span class="link-text">Calendário</span>
				</a>
			</li>

			<!-- AGENDAMENTOS -->
			<li class="nav-item @(menuBloqueado ? "nav-locked" : "")">
				<a class="nav-link" asp-controller="Agendamentos" asp-action="Index">
					<i class="bi bi-list-check"></i>
					<span class="link-text">Agendamentos</span>
				</a>
			</li>

			@if (ehFuncionario)
			{
				<!-- CLIENTES (funcionário não tem o dropdown "Cadastros" inteiro) -->
				<li class="nav-item">
					<a class="nav-link" asp-controller="Clientes" asp-action="Index">
						<i class="bi bi-people"></i>
						<span class="link-text">Clientes</span>
					</a>
				</li>

				@if (ehGerente)
				{
					<!-- SERVIÇOS -->
					<li class="nav-item">
						<a class="nav-link" asp-controller="Servicos" asp-action="Index">
							<i class="bi bi-scissors"></i>
							<span class="link-text">Serviços</span>
						</a>
					</li>

					<!-- PRODUTOS -->
					<li class="nav-item">
						<a class="nav-link" asp-controller="Produtos" asp-action="Index">
							<i class="bi bi-box-seam"></i>
							<span class="link-text">Produtos</span>
						</a>
					</li>

					<!-- FIDELIDADE -->
					<li class="nav-item">
						<a class="nav-link" asp-controller="Fidelidade" asp-action="Index">
							<i class="bi bi-award"></i>
							<span class="link-text">Fidelidade</span>
						</a>
					</li>
				}
			}
			else
			{
				<!-- ========================= -->
				<!-- CADASTROS (DROPDOWN) -->
				<!-- ========================= -->
				<li class="nav-item @(menuBloqueado ? "nav-locked" : "")">

					<a class="nav-link d-flex justify-content-between align-items-center"
					   data-bs-toggle="collapse"
					   href="#cadastrosMenu"
					   role="button"
					   aria-expanded="false">

						<span>
							<i class="bi bi-folder"></i>
							<span class="link-text">Cadastros</span>
						</span>

						<i class="bi bi-chevron-down small"></i>
					</a>

					<div class="collapse ps-3" id="cadastrosMenu">

						<ul class="nav flex-column">

							<li>
								<a class="nav-link" asp-controller="Clientes" asp-action="Index">
									<i class="bi bi-people"></i>
									<span class="link-text">Clientes</span>
								</a>
							</li>

							<li>
								<a class="nav-link" asp-controller="Servicos" asp-action="Index">
									<i class="bi bi-scissors"></i>
									<span class="link-text">Serviços</span>
								</a>
							</li>

							<li>
								<a class="nav-link" asp-controller="Produtos" asp-action="Index">
									<i class="bi bi-box-seam"></i>
									<span class="link-text">Produtos</span>
								</a>
							</li>

							<li>
								<a class="nav-link" asp-controller="Funcionarios" asp-action="Index">
									<i class="bi bi-person-badge"></i>
									<span class="link-text">Funcionários</span>
								</a>
							</li>

							<li>
								<a class="nav-link" asp-controller="PlanosServico" asp-action="Index">
									<i class="bi bi-card-checklist"></i>
									<span class="link-text">Planos</span>
								</a>
							</li>

							<li>
								<a class="nav-link" asp-controller="Empresas" asp-action="Horarios">
									<i class="bi bi-clock"></i>
									<span class="link-text">Horário de Funcionamento</span>
								</a>
							</li>

							<li>
								<a class="nav-link" asp-controller="Fidelidade" asp-action="Index">
									<i class="bi bi-award"></i>
									<span class="link-text">Fidelidade</span>
								</a>
							</li>

						</ul>

					</div>

				</li>
			}

			@if (!ehFuncionario || ehGerente)
			{
				<!-- ========================= -->
				<!-- FINANCEIRO (dono sempre; funcionário só se for Gerente) -->
				<!-- ========================= -->
				<li class="nav-item @(menuBloqueado ? "nav-locked" : "")">

					<a class="nav-link d-flex justify-content-between align-items-center"
					   data-bs-toggle="collapse"
					   href="#financeiroMenu"
					   role="button"
					   aria-expanded="false">

						<span>
							<i class="bi bi-cash-coin"></i>
							<span class="link-text">Financeiro</span>
						</span>

						<i class="bi bi-chevron-down small"></i>
					</a>

					<div class="collapse ps-3" id="financeiroMenu">

						<ul class="nav flex-column">

							<li>
								<a class="nav-link" asp-controller="Financeiro" asp-action="Dashboard">
									<i class="bi bi-speedometer2"></i>
									<span class="link-text">Dashboard</span>
								</a>
							</li>

							<li>
								<a class="nav-link" asp-controller="Financeiro" asp-action="Caixa">
									<i class="bi bi-safe"></i>
									<span class="link-text">Caixa</span>
								</a>
							</li>

							<li>
								<a class="nav-link" asp-controller="ContasReceber" asp-action="Index">
									<i class="bi bi-cash-stack"></i>
									<span class="link-text">Contas a Receber</span>
								</a>
							</li>

							<li>
								<a class="nav-link" asp-controller="ContasReceber" asp-action="Receitas">
									<i class="bi bi-receipt"></i>
									<span class="link-text">Receitas</span>
								</a>
							</li>

							<li>
								<a class="nav-link" asp-controller="ContasPagar" asp-action="Index">
									<i class="bi bi-cash-coin"></i>
									<span class="link-text">Contas a Pagar</span>
								</a>
							</li>

							<li>
								<a class="nav-link" asp-controller="ContasPagar" asp-action="Despesas">
									<i class="bi bi-wallet2"></i>
									<span class="link-text">Despesas</span>
								</a>
							</li>

							<li>
								<a class="nav-link" asp-controller="Comissoes" asp-action="Index">
									<i class="bi bi-percent"></i>
									<span class="link-text">Comissões</span>
								</a>
							</li>

							<li>
								<a class="nav-link" asp-controller="CategoriasFinanceiras" asp-action="Index">
									<i class="bi bi-tags"></i>
									<span class="link-text">Categorias</span>
								</a>
							</li>

							<li>
								<a class="nav-link" asp-controller="Financeiro" asp-action="Relatorios">
									<i class="bi bi-graph-up"></i>
									<span class="link-text">Relatórios</span>
								</a>
							</li>

						</ul>

					</div>

				</li>
			}

			@if (!ehFuncionario)
			{
				<!-- EMPRESAS -->
				<li class="nav-item @(menuBloqueado ? "nav-locked" : "")">
					<a class="nav-link" asp-controller="Empresas" asp-action="Index">
						<i class="bi bi-building"></i>
						<span class="link-text">Empresas</span>
					</a>
				</li>

				<!-- ASSINATURA (sempre liberada — é por aqui que o dono ativa a conta) -->
				<li class="nav-item">
					<a class="nav-link" asp-controller="Assinatura" asp-action="Index">
						<i class="bi bi-credit-card"></i>
						<span class="link-text">Assinatura</span>
					</a>
				</li>
			}

		</ul>

		<div class="sidebar-secondary px-2 py-2">
			<a class="nav-link" asp-controller="Ajuda" asp-action="Index">
				<i class="bi bi-question-circle"></i>
				<span class="link-text">Ajuda</span>
			</a>
			<a class="nav-link" asp-controller="Atendimento" asp-action="Index">
				<i class="bi bi-headset"></i>
				<span class="link-text">Atendimento</span>
			</a>

			<a class="nav-link" href="#" id="instalarAppLink" hidden>
				<i class="bi bi-download"></i>
				<span class="link-text">Instalar app</span>
			</a>
		</div>

		<div class="sidebar-footer d-flex flex-column px-2 py-2">

			<span class="mb-2 fw-semibold text-white">
				Bem-vindo,<br>  @nomeUsuario
			</span>

			<form method="post" action="/logout" class="d-inline">
				@Html.AntiForgeryToken()
				<button type="submit" class="btn btn-link text-danger text-decoration-none p-0">
					<i class="bi bi-box-arrow-right me-1"></i> Sair
				</button>
			</form>

		</div>
	</div>

	<!-- CONTEÚDO -->
	<div class="content" id="content">

		<!-- TOPBAR (só existe de verdade no mobile — é onde mora o botão do
		     menu; no desktop fica sem altura, o título de cada tela já
		     aparece uma vez só, dentro do conteúdo, no padrão do Dashboard) -->
		<div class="topbar">
			<span class="hamburger" id="hamburger"><i class="bi bi-list"></i></span>
			<span class="topbar-brand">Portal</span>

			@if (empresaInfo?.EmpresaId != null)
			{
				<a asp-controller="Notificacoes" asp-action="Index" class="topbar-sino" title="Notificações">
					<i class="bi bi-bell"></i>
					@if (notificacoesNaoLidas > 0)
					{
						<span class="badge-contador">@(notificacoesNaoLidas > 9 ? "9+" : notificacoesNaoLidas.ToString())</span>
					}
				</a>
			}
		</div>

		<!-- CORPO -->
		<div class="p-4">
			@RenderBody()
		</div>

	</div>


	<div id="toast-container" class="toast-container"></div>

	@await RenderSectionAsync("Scripts", required: false)

	@if (TempData["ToastMessage"] != null)
	{
		<script>
			document.addEventListener("DOMContentLoaded", function () {
				showToast(
					"@TempData["ToastMessage"]",
					"@TempData["ToastType"]"
				);
			});
		</script>
	}

	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/pwa-empresa.js" asp-append-version="true"></script>
	<script src="~/js/masks.js" asp-append-version="true"></script>
	<script>
				const sidebar = document.getElementById('sidebar');
		const hamburger = document.getElementById('hamburger');
		const overlay = document.getElementById('overlay');

		if (hamburger) {
			hamburger.addEventListener('click', () => {
				sidebar.classList.toggle('show');

				if (overlay) {
					overlay.classList.toggle('show');
				}
			});
		}

		if (overlay) {
			overlay.addEventListener('click', () => {
				sidebar.classList.remove('show');
				overlay.classList.remove('show');
			});
		}

										function showToast(message, type) {

			const container = document.getElementById("toast-container");

			if (!container) return;

			const toast = document.createElement("div");

			toast.style.position = "fixed";
			toast.style.top = "20px";
			toast.style.right = "20px";
			toast.style.zIndex = "999999";
			toast.style.minWidth = "300px";
			toast.style.padding = "15px";
			toast.style.borderRadius = "10px";
			toast.style.boxShadow = "0 4px 12px rgba(0,0,0,.15)";
			toast.style.color = "#fff";
			toast.style.fontWeight = "500";
			toast.style.animation = "slideIn 0.3s ease";

			if (type === "success") {
				toast.style.backgroundColor = "#198754";
				toast.innerHTML = "✅ " + message;
			}
			else if (type === "error") {
				toast.style.backgroundColor = "#dc3545";
				toast.innerHTML = "❌ " + message;
			}
			else {
				toast.style.backgroundColor = "#ffc107";
				toast.style.color = "#000";
				toast.innerHTML = "⚠️ " + message;
			}

			container.appendChild(toast);

			setTimeout(() => {
				toast.style.opacity = "0";

				setTimeout(() => {
					toast.remove();
				}, 300);
			}, 3000);
		}

		const simpliAiBolha = document.getElementById('simpliAiBolha');

		if (simpliAiBolha) {
			const painel = document.getElementById('simpliAiPainel');
			const fechar = document.getElementById('simpliAiFechar');
			const form = document.getElementById('simpliAiForm');
			const input = document.getElementById('simpliAiInput');
			const mensagens = document.getElementById('simpliAiMensagens');

			simpliAiBolha.addEventListener('click', () => painel.classList.toggle('show'));
			fechar.addEventListener('click', () => painel.classList.remove('show'));

			function adicionarMensagem(texto, role) {
				const div = document.createElement('div');
				div.className = 'simpli-ai-msg ' + role;
				div.textContent = texto;
				mensagens.appendChild(div);
				mensagens.scrollTop = mensagens.scrollHeight;
			}

			form.addEventListener('submit', function (e) {
				e.preventDefault();

				const texto = input.value.trim();
				if (!texto) return;

				adicionarMensagem(texto, 'user');
				input.value = '';

				const token = document.querySelector('#simpli-ai-token-form input[name="__RequestVerificationToken"]').value;

				fetch('/simpli-ai/mensagem', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						'RequestVerificationToken': token
					},
					body: JSON.stringify({ mensagem: texto })
				})
					.then(async response => {
						const data = await response.json().catch(() => ({}));

						if (!response.ok) {
							adicionarMensagem(data.erro || 'Não consegui responder agora.', 'model');
							return;
						}

						adicionarMensagem(data.resposta, 'model');
					})
					.catch(() => adicionarMensagem('Não consegui falar com o Simpli AI agora.', 'model'));
			});
		}
	</script>
</body>
</html>