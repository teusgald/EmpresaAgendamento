<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"]</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <!-- Plus Jakarta Sans (títulos/CTA) troca a Syne — Syne é uma fonte
         geométrica bem estilizada, lida como "startup/moda" mais do que
         "negócio local profissional"; Plus Jakarta Sans mantém peso 800 pra
         título continuar forte, mas com um traço mais neutro/corporativo. -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <!-- Ícones de conteúdo (endereço, horário, comodidades...) usam essa fonte
         em vez de emoji — emoji renderiza com cor fixa própria do SO, ignora
         `color`/CSS e quebra o tema de marca da empresa. Já era referenciada
         em Views/Publico/Empresas.cshtml (bi bi-geo-alt etc.) sem estar
         carregada aqui — os ícones lá ficavam quebrados. -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="icon" type="image/png" href="/img/icon.png?v=3" />

    <link rel="stylesheet"
          href="~/css/publico.css"
          asp-append-version="true" />

    <!-- Todo <select class="form-select"> vira um dropdown estilizado (com
         busca quando tem mais de 10 opções) — ver wwwroot/js/realceSelect.js. -->
    <link rel="stylesheet" href="~/css/realceSelect.css" asp-append-version="true" />
    <script src="~/js/realceSelect.js" asp-append-version="true"></script>

    <script src="~/js/masks.js" asp-append-version="true"></script>

    @RenderSection("Styles", required: false)
</head>

<body class="dark-theme">

    <nav>
        @RenderSection("Navbar", required: false)
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer>
        @RenderSection("Footer", required: false)
    </footer>

    <!-- Botão Tema -->
    <button id="themeToggle" class="theme-toggle">
        🌙
    </button>

    <div id="toast-container" class="toast-container"></div>

    @if (TempData["ToastMessage"] != null)
    {
        <script>
            window.onload = function () {
                showToast(
                    "@TempData["ToastMessage"]",
                    "@TempData["ToastType"]"
                );
            };
        </script>
    }


    <script>

        const toggle = document.getElementById("themeToggle");

        function getTema() {
            return localStorage.getItem("theme") || "dark";
        }

        function aplicarTema(tema) {

            const body = document.body;

            body.classList.remove("light-theme", "dark-theme");
            body.classList.add(`${tema}-theme`);

            localStorage.setItem("theme", tema);

            atualizarLogo(tema);

            if (toggle) {
                toggle.innerHTML = tema === "dark" ? "☀️" : "🌙";
            }
        }

        function atualizarLogo(tema) {

            const logo = document.getElementById("logoSite");
            if (!logo) return;

            const src =
                tema === "light"
                    ? "/img/logo.png"
                    : "/img/logocliente.png";

            logo.src = src + "?v=" + Date.now();
        }

        document.addEventListener("DOMContentLoaded", () => {

            const temaSalvo = getTema();

            aplicarTema(temaSalvo);

            if (toggle) {

                toggle.addEventListener("click", () => {

                    const atual =
                        document.body.classList.contains("dark-theme")
                            ? "dark"
                            : "light";

                    const novo = atual === "dark" ? "light" : "dark";

                    aplicarTema(novo);
                });
            }
        });

    </script>
    @RenderSection("Scripts", required: false)

</body>
</html>