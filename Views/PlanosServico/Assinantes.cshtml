@model EmpresaAgendamento.Models.PlanoServico
@using EmpresaAgendamento.Models.Enums

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold mb-0">Assinantes — @Model.Nome</h3>
            <span class="text-muted small">
                @Model.QuantidadeUsos sessões por período
                (@(Model.Periodicidade == PeriodicidadePlanoServico.Semanal ? "semanal" : "mensal"))
                @if (Model.PercentualJurosAtraso.HasValue)
                {
                    <text> — juros de atraso: @Model.PercentualJurosAtraso.Value.ToString("F2")%</text>
                }
            </span>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
    </div>

    @{
        var pendentes = Model.Assinaturas.Where(a => a.Status == StatusAssinaturaPlano.Pendente).ToList();
        var ativas = Model.Assinaturas.Where(a => a.Status == StatusAssinaturaPlano.Ativa).ToList();
        var canceladas = Model.Assinaturas.Where(a => a.Status == StatusAssinaturaPlano.Cancelada).ToList();
    }

    @if (pendentes.Any())
    {
        <div class="card shadow-sm mb-4 border-warning">
            <div class="card-body">

                <h5 class="mb-3">
                    <i class="bi bi-clock-history text-warning"></i>
                    Solicitações pendentes de aprovação
                </h5>

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Cliente</th>
                                <th>Solicitado em</th>
                                <th class="text-end">Ações</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var assinatura in pendentes)
                            {
                                <tr>
                                    <td class="fw-semibold">@assinatura.Cliente.Nome</td>
                                    <td>@assinatura.DataInicio.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">
                                        <form asp-action="AprovarAssinatura" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@assinatura.Id" />
                                            <input type="hidden" name="planoServicoId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-success">
                                                Aprovar (confirmei o pagamento)
                                            </button>
                                        </form>

                                        <form asp-action="CancelarAssinatura" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@assinatura.Id" />
                                            <input type="hidden" name="planoServicoId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Recusar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <h5 class="mb-3">Adicionar cliente diretamente</h5>

            <form asp-action="AdicionarAssinante" method="post" class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="planoServicoId" value="@Model.Id" />

                <div class="col-md-8">
                    <select name="clienteId" class="form-select" asp-items="ViewBag.Clientes">
                        <option value="">Selecione um cliente</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <button type="submit" class="btn btn-primary w-100">Adicionar ao plano</button>
                </div>
            </form>

        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <h5 class="mb-3">Assinantes ativos e histórico</h5>

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Cliente</th>
                            <th>Assinante desde</th>
                            <th>Créditos usados no período</th>
                            <th>Vencimento do período</th>
                            <th>Status</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var assinatura in ativas.Concat(canceladas).OrderByDescending(a => a.Status == StatusAssinaturaPlano.Ativa).ThenBy(a => a.Cliente.Nome))
                        {
                            <tr>
                                <td class="fw-semibold">@assinatura.Cliente.Nome</td>

                                <td>@assinatura.DataInicio.ToString("dd/MM/yyyy")</td>

                                <td>
                                    @assinatura.CreditosUsados / @Model.QuantidadeUsos
                                </td>

                                <td>
                                    @if (assinatura.Status == StatusAssinaturaPlano.Ativa)
                                    {
                                        @assinatura.DataVencimento.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>

                                <td>
                                    @if (assinatura.Status == StatusAssinaturaPlano.Ativa)
                                    {
                                        <span class="badge bg-success">Ativa</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Cancelada</span>
                                    }
                                </td>

                                <td class="text-end">
                                    @if (assinatura.Status == StatusAssinaturaPlano.Ativa)
                                    {
                                        <form asp-action="CancelarAssinatura" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@assinatura.Id" />
                                            <input type="hidden" name="planoServicoId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Cancelar
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }

                        @if (!ativas.Any() && !canceladas.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    Nenhum cliente assinante ainda.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>
