@model EmpresaAgendamento.Models.ViewModels.SuperAdminEditarEmpresaViewModel
@{
    ViewData["Title"] = "Editar empresa";
    Layout = "_LayoutSuperAdmin";
}

<div class="container-fluid mt-4">

    <div class="page-header">
        <div>
            <h3 class="fw-bold mb-0">@Model.EmpresaNome</h3>
            <p class="page-subtitle">Alterar plano e acesso VIP.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-dark btn-sm">
            <i class="bi bi-arrow-left"></i> Voltar
        </a>
    </div>

    <div class="card shadow-sm" style="max-width:520px;">
        <div class="card-body">

            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="EmpresaId" />

                <div class="mb-3">
                    <label class="form-label small fw-semibold">Plano</label>
                    <select asp-for="PlanoId" class="form-select">
                        <option value="">Sem plano</option>
                        @foreach (var plano in Model.PlanosDisponiveis)
                        {
                            <option value="@plano.Id">@plano.Nome — @plano.ValorMensal.ToString("C")/mês</option>
                        }
                    </select>
                </div>

                <div class="form-check form-switch mb-4">
                    <input class="form-check-input" type="checkbox" asp-for="VipAcesso" id="vipAcessoCheck" />
                    <label class="form-check-label" for="vipAcessoCheck">
                        Acesso VIP — nunca bloqueado pelo paywall, mesmo sem assinatura ativa no Stripe.
                    </label>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-semibold">WhatsApp — Phone number ID</label>
                    <input type="text" class="form-control" asp-for="WhatsAppPhoneNumberId" placeholder="Ex.: 109876543210987" />
                    <div class="form-text">
                        Copiado do Meta Business Manager (WhatsApp &gt; Configuração da API), depois
                        de registrar o número dessa empresa na WABA. Em branco = usa o número
                        global enquanto não for provisionado.
                    </div>
                </div>

                <div class="form-check form-switch mb-4">
                    <input class="form-check-input" type="checkbox" asp-for="SimpliAiBetaAtivo" id="simpliAiBetaCheck" />
                    <label class="form-check-label" for="simpliAiBetaCheck">
                        Simpli AI (beta) — libera o assistente de chat mesmo sem o plano permitir.
                        Só marcar em empresa de teste: o provedor de IA está no tier gratuito
                        enquanto isso (dado pode ser usado pelo provedor pra treinar modelo).
                    </label>
                </div>

                <button type="submit" class="btn btn-dark w-100">Salvar</button>

            </form>

        </div>
    </div>

</div>
