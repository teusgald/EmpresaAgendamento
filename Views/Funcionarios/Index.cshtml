@model IEnumerable<EmpresaAgendamento.Models.Funcionario>

<div class="container-fluid mt-4">

    <div class="page-header">
        <div>
            <h3 class="fw-bold mb-0">Funcionários</h3>
            <p class="page-subtitle">Equipe que atende os agendamentos da sua empresa.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Novo Funcionário
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm">
            <div class="empty-state">
                <i class="bi bi-person-badge"></i>
                <p>Nenhum funcionário cadastrado ainda.</p>
                <a asp-action="Create" class="btn btn-dark btn-sm mt-2">Cadastrar o primeiro funcionário</a>
            </div>
        </div>
    }
    else
    {

    <!-- DESKTOP -->
    <div class="card shadow-sm d-none d-lg-block">
        <div class="card-body">

            <table class="table table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Funcionário</th>
                        <th>Cargo</th>
                        <th>Telefone</th>
                        <th>Serviços</th>
                        <th>Status</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                <div class="d-flex align-items-center gap-2">

                                    @if (!string.IsNullOrWhiteSpace(item.FotoUrl))
                                    {
                                        <img src="@item.FotoUrl"
                                             class="rounded-circle"
                                             width="45"
                                             height="45"
                                             style="object-fit:cover;">
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center"
                                             style="width:45px;height:45px;">
                                            @(item.Nome.Substring(0, 1).ToUpper())
                                        </div>
                                    }

                                    <div>
                                        <div class="fw-semibold">
                                            @item.Nome
                                            @if (item.Perfil != null)
                                            {
                                                <span class="badge bg-primary">@item.Perfil.Nome</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark" title="Sem acesso às telas que já usam perfil (ex.: Clientes)">Sem perfil</span>
                                            }
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.Email))
                                        {
                                            <small class="text-muted">
                                                @item.Email
                                            </small>
                                        }
                                    </div>

                                </div>
                            </td>

                            <td>
                                @(item.Cargo ?? "-")
                            </td>

                            <td>
                                @(item.Telefone ?? "-")
                            </td>

                            <td>

                                @if (item.Servicos.Any())
                                {
                                    @foreach (var servico in item.Servicos)
                                    {
                                        <span class="badge bg-light text-dark border me-1 mb-1">
                                            @servico.Servico.Nome
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Nenhum
                                    </span>
                                }

                            </td>

                            <td>

                                @if (item.Ativo)
                                {
                                    <span class="badge bg-success">
                                        Ativo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Inativo
                                    </span>
                                }

                            </td>

                            <td class="text-end">

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Editar
                                </a>

                                <a asp-action="Horarios"
                                   asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    Horários
                                </a>

                                @if (item.UserId != null)
                                {
                                    <span class="badge bg-info text-dark">Acesso ativo</span>

                                    <form asp-action="ReenviarAcesso" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary" title="Manda um novo link pro funcionário definir a senha">
                                            Reenviar acesso
                                        </button>
                                    </form>
                                }
                                else if (!string.IsNullOrWhiteSpace(item.Email))
                                {
                                    <form asp-action="CriarAcesso" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-info">
                                            Criar acesso
                                        </button>
                                    </form>
                                }

                                <form asp-action="ToggleAtivo"
                                      method="post"
                                      class="d-inline">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.Id" />

                                    @if (item.Ativo)
                                    {
                                        <button type="submit"
                                                class="btn btn-sm btn-success">
                                            Ativo
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit"
                                                class="btn btn-sm btn-outline-secondary">
                                            Inativo
                                        </button>
                                    }

                                </form>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    </div>

    <!-- MOBILE -->
    <div class="d-lg-none">

        @foreach (var item in Model)
        {
            <div class="card mobile-card mb-3">

                <div class="card-body">

                    <div class="d-flex align-items-center gap-3 mb-3">

                        @if (!string.IsNullOrWhiteSpace(item.FotoUrl))
                        {
                            <img src="@item.FotoUrl"
                                 class="rounded-circle"
                                 width="60"
                                 height="60"
                                 style="object-fit:cover;">
                        }
                        else
                        {
                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center"
                                 style="width:60px;height:60px;font-size:20px;">
                                @(item.Nome.Substring(0, 1).ToUpper())
                            </div>
                        }

                        <div>

                            <h6 class="fw-bold mb-1">
                                @item.Nome
                                @if (item.Perfil != null)
                                {
                                    <span class="badge bg-primary">@item.Perfil.Nome</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Sem perfil</span>
                                }
                            </h6>

                            <small class="text-muted">
                                @(item.Cargo ?? "Sem cargo")
                            </small>

                        </div>

                    </div>

                    <div class="mobile-info">
                        <label>Telefone</label>
                        <span>@(item.Telefone ?? "-")</span>
                    </div>

                    <div class="mobile-info">
                        <label>Email</label>
                        <span>@(item.Email ?? "-")</span>
                    </div>

                    <div class="mobile-info">

                        <label>Serviços</label>

                        <div class="mt-1">

                            @if (item.Servicos.Any())
                            {
                                @foreach (var servico in item.Servicos)
                                {
                                    <span class="badge bg-light text-dark border me-1 mb-1">
                                        @servico.Servico.Nome
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">
                                    Nenhum serviço
                                </span>
                            }

                        </div>

                    </div>

                    <div class="mt-3">

                        @if (item.Ativo)
                        {
                            <span class="badge bg-success">
                                Ativo
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">
                                Inativo
                            </span>
                        }

                    </div>

                    <div class="mobile-actions mt-3">

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-primary">
                            Editar
                        </a>

                        <a asp-action="Horarios"
                           asp-route-id="@item.Id"
                           class="btn btn-outline-secondary">
                            Horários
                        </a>

                        @if (item.UserId != null)
                        {
                            <span class="badge bg-info text-dark align-self-center">Acesso ativo</span>

                            <form asp-action="ReenviarAcesso" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-outline-secondary w-100 mt-2">
                                    Reenviar acesso
                                </button>
                            </form>
                        }
                        else if (!string.IsNullOrWhiteSpace(item.Email))
                        {
                            <form asp-action="CriarAcesso" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="btn btn-outline-info w-100 mt-2">
                                    Criar acesso
                                </button>
                            </form>
                        }

                    </div>

                </div>

            </div>
        }

    </div>

    }

    @if (ViewBag.TotalPages > 1)
    {
        <div class="d-flex justify-content-center mt-4">

            <nav>
                <ul class="pagination">

                    <!-- ANTERIOR -->
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(ViewBag.CurrentPage - 1)">
                            Anterior
                        </a>
                    </li>

                    <!-- PÁGINAS -->
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i">
                                @i
                            </a>
                        </li>
                    }

                    <!-- PRÓXIMO -->
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(ViewBag.CurrentPage + 1)">
                            Próximo
                        </a>
                    </li>

                </ul>
            </nav>

        </div>
    }

</div>
