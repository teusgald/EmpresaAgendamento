@model EmpresaAgendamento.ViewModels.FuncionarioViewModel

<div class="container-fluid mt-4">

    
    <h3 class="fw-bold mb-3">Novo Funcionário</h3>

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div class="row">

            <!-- COL ESQUERDA -->
            <div class="col-lg-8">

                <div class="card shadow-sm mb-3">
                    <div class="card-body">

                        <div class="row g-3">

                            <div class="col-md-6">
                                <label class="form-label">Nome</label>
                                <input asp-for="Nome" class="form-control" />
                                <span asp-validation-for="Nome" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Cargo</label>
                                <input asp-for="Cargo" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Telefone</label>
                                <input asp-for="Telefone" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Email</label>
                                <input asp-for="Email" class="form-control" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Observações</label>
                                <textarea asp-for="Observacoes" class="form-control"></textarea>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Comissão %</label>
                                <input asp-for="PercentualComissaoPadrao" class="form-control" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Comissão Fixa</label>
                                <input asp-for="ValorComissaoFixa" class="form-control" />
                            </div>

                            <div class="col-12">
                                <label class="form-label">Foto (URL)</label>
                                <input asp-for="FotoUrl" class="form-control" />
                            </div>

                        </div>

                    </div>
                </div>

                <!-- SERVIÇOS -->
                <div class="card shadow-sm">
                    <div class="card-body">

                        <h5 class="mb-3">Serviços</h5>

                        @for (int i = 0; i < Model.ServicosDisponiveis.Count; i++)
                        {
                            <div class="form-check">
                                <input class="form-check-input"
                                       type="checkbox"
                                       name="ServicosSelecionados"
                                       value="@Model.ServicosDisponiveis[i].Value" />

                                <label class="form-check-label">
                                    @Model.ServicosDisponiveis[i].Text
                                </label>
                            </div>
                        }


                        <!-- COL DIREITA -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary ">
                                Salvar
                            </button>

                            <a asp-action="Index" class="btn btn-outline-secondary ">
                                Voltar
                            </a>

                        </div>
                    </div>
                </div>

            </div>

           

        </div>

    </form>
   

</div>
