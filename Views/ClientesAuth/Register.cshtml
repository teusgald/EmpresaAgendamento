@model ClienteRegisterViewModel

@{
    Layout = null;
}

<div class="auth-card">

    <!-- HEADER -->
    <div class="text-center mb-4">
        <i class="bi bi-person-circle auth-icon"></i>
        <h4 class="auth-title">Cadastro de Cliente</h4>
        <p class="auth-subtitle">Crie sua conta para agendar serviços</p>
    </div>

    <!-- FORM -->
    <form id="clienteRegisterForm" data-type="cliente-register">

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <input asp-for="Nome" class="form-control" placeholder="Nome completo" />
        </div>

        <div class="mb-3">
            <input asp-for="Telefone" class="form-control" placeholder="Telefone" />
        </div>

        <div class="mb-3">
            <input asp-for="Email" class="form-control" placeholder="Email" />
        </div>

        <div class="mb-3">
            <input asp-for="Password" type="password" class="form-control" placeholder="Senha" />
        </div>

        <button class="btn btn-dark w-100">
            Criar Conta
        </button>

        <div class="text-center mt-3">
            <a href="#" class="text-muted small switch-mode" data-mode="login">Já tem conta? Entrar</a>
        </div>

    </form>

</div>