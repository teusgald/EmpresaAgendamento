@model ClienteRegisterViewModel
@{
    Layout = null;
}

<div class="auth-card">

    <div class="text-center mb-4">
        <h4>Criar conta</h4>
        <p class="text-muted">Cadastro de cliente</p>
    </div>

    <form id="clienteRegisterForm" data-type="cliente-register">

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <input asp-for="Nome" class="form-control mb-3" placeholder="Nome completo" />

        <input asp-for="Telefone" class="form-control mb-3" placeholder="Telefone" />

        <input asp-for="Email" class="form-control mb-3" placeholder="Email" />

        <input asp-for="Password" type="password" class="form-control mb-3" placeholder="Senha" />

        <button class="btn btn-dark w-100 mb-3">
            Criar conta
        </button>

        <div class="text-center">
            <a href="#" class="switch-mode" data-mode="login">
                Já tenho conta
            </a>
        </div>

    </form>

</div>