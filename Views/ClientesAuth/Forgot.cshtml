
<div class="auth-card">

    <div class="text-center mb-4">
        <h4>Recuperar senha</h4>
        <p class="text-muted">Digite seu email</p>
    </div>

    <form id="forgotForm" asp-action="Forgot" method="post" data-type="cliente-forgot">

        <input name="Email" class="form-control mb-3" placeholder="Email" />

        <button class="btn btn-dark w-100">
            Enviar link
        </button>

        <div class="text-center mt-3">
            <a href="#" onclick="backToLogin()">Voltar</a>
        </div>

    </form>

</div>