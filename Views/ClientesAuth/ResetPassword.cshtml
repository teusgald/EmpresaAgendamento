@using EmpresaAgendamento.Models.ViewModels
@model ResetPasswordViewModel

<div class="auth-card">

    <div class="text-center mb-4">
        <h4>Nova senha</h4>
    </div>

    <form id="resetForm" data-type="cliente-reset">

        <input type="hidden" name="Email" value="@Model.Email" />
        <input type="hidden" name="Token" value="@Model.Token" />

        <input name="Password" type="password" class="form-control mb-3" placeholder="Nova senha" />

        <input name="ConfirmPassword" type="password" class="form-control mb-3" placeholder="Confirmar senha" />

        <button class="btn btn-dark w-100">
            Alterar senha
        </button>

    </form>

</div>