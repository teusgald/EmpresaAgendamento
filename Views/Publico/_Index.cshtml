@section Scripts {

    <script>

        // ==========================================
        // MODO LOGIN / REGISTRO / RECUPERAR SENHA
        // ==========================================

        let modoCliente = "login";

        // ==========================================
        // DESCRIÇÃO EMPRESA
        // ==========================================

        function toggleDesc() {

            document.getElementById("desc")
                ?.classList.toggle("expanded");
        }

        // ==========================================
        // ABAS (SERVIÇOS / GALERIA / AVALIAÇÕES)
        // ==========================================

        document.querySelectorAll(".tab-btn").forEach(btn => {

            btn.addEventListener("click", () => {

                document.querySelectorAll(".tab-btn")
                    .forEach(b => b.classList.remove("active"));

                btn.classList.add("active");

                document.querySelectorAll(".tab-pane-publico")
                    .forEach(p => p.style.display = "none");

                document.getElementById(btn.dataset.tab).style.display = "";
            });
        });

        // ==========================================
        // GALERIA — ABRE O CARROSSEL NA FOTO CLICADA
        // ==========================================

        document.querySelectorAll("#tabGaleria [data-foto-index]").forEach(el => {

            el.addEventListener("click", () => {

                const indice = parseInt(el.dataset.fotoIndex);

                const carousel = bootstrap.Carousel.getOrCreateInstance(
                    document.getElementById("galeriaCarousel")
                );

                carousel.to(indice);
            });
        });

        // ==========================================
        // PAGINAÇÃO (5 por página) — Serviços, Planos e Avaliações
        // ==========================================
        // Cada lista tem seu próprio contador de página e seu próprio
        // seletor ESCOPADO à aba (ex.: "#tabServicos .service-item") — sem
        // isso, a paginação de Serviços pegava também os itens da aba
        // Produtos (que reaproveita a mesma classe .service-item mas não
        // tem data-name), quebrando com erro de JS pra empresa que cadastra
        // produto.

        const ITENS_POR_PAGINA = 5;

        function criarPaginador(itemSelector, navId, filtroFn) {

            let paginaAtual = 1;

            function itensFiltrados() {
                const todos = Array.from(document.querySelectorAll(itemSelector));
                return filtroFn ? todos.filter(filtroFn) : todos;
            }

            function render() {

                const itens = itensFiltrados();
                const totalPaginas = Math.max(1, Math.ceil(itens.length / ITENS_POR_PAGINA));

                if (paginaAtual > totalPaginas) {
                    paginaAtual = totalPaginas;
                }

                document.querySelectorAll(itemSelector)
                    .forEach(item => item.style.display = "none");

                itens
                    .slice(
                        (paginaAtual - 1) * ITENS_POR_PAGINA,
                        paginaAtual * ITENS_POR_PAGINA
                    )
                    .forEach(item => item.style.display = "");

                const nav = document.getElementById(navId);

                if (!nav) return;

                nav.innerHTML = "";

                if (totalPaginas <= 1) return;

                for (let i = 1; i <= totalPaginas; i++) {

                    const btn = document.createElement("button");

                    btn.type = "button";
                    btn.textContent = i;
                    btn.className = "page-btn" + (i === paginaAtual ? " active" : "");

                    btn.addEventListener("click", () => {
                        paginaAtual = i;
                        render();
                    });

                    nav.appendChild(btn);
                }
            }

            return {
                render,
                resetPagina() {
                    paginaAtual = 1;
                    render();
                }
            };
        }

        const paginadorServicos = criarPaginador(
            "#tabServicos .service-item",
            "servicosPaginacao",
            item => {
                const q = document.getElementById("searchInput")?.value.toLowerCase() || "";
                return (item.dataset.name || "").includes(q);
            }
        );

        const paginadorPlanos = criarPaginador("#tabPlanos .plan-card", "planosPaginacao");
        const paginadorAvaliacoes = criarPaginador("#tabAvaliacoes .review-item", "avaliacoesPaginacao");

        function renderPaginacaoServicos() {
            paginadorServicos.render();
            paginadorPlanos.render();
            paginadorAvaliacoes.render();
        }

        function filterServices() {
            paginadorServicos.resetPagina();
        }

        // ==========================================
        // EMPRESA
        // ==========================================

        const empresaId =
            document.getElementById("EmpresaId").value;

        // ==========================================
        // CARREGA LOGIN / REGISTRO / FORGOT
        // ==========================================

        function mostrarAlertaCliente(mensagem, tipo = "danger") {

            const alerta =
                document.getElementById("clienteLoginAlert");

            if (!alerta)
                return;

            alerta.innerHTML = mensagem
                ? `<div class="alert alert-${tipo} py-2 mb-3">${mensagem}</div>`
                : "";
        }

        function loadClienteLogin(mode = "login") {

            modoCliente = mode;

            mostrarAlertaCliente("");

            let url = "/cliente/login";

            if (mode === "register")
                url = "/cliente/registro";

            if (mode === "forgot")
                url = "/cliente/forgot";

            const container =
                document.getElementById("clienteLoginContent");

            container.innerHTML =
                '<p class="text-center text-muted my-4">Carregando...</p>';

            fetch(url)
                .then(res => {

                    if (!res.ok) {
                        throw new Error(`HTTP ${res.status}`);
                    }

                    return res.text();
                })
                .then(html => {

                    const doc =
                        new DOMParser()
                            .parseFromString(html, "text/html");

                    const content =
                        doc.querySelector(".auth-card")
                        || doc.querySelector(".login-card")
                        || doc.body;

                    container.innerHTML =
                        content.outerHTML;

                    const form =
                        document.querySelector(
                            "#clienteLoginContent form"
                        );

                    if (
                        form &&
                        !form.querySelector(
                            'input[name="Origem"]'
                        )
                    ) {

                        form.insertAdjacentHTML(
                            "beforeend",
                            `
                            <input type="hidden"
                                   name="Origem"
                                   value="publico" />
                            `
                        );
                    }
                })
                .catch(err => {

                    console.error(
                        "Erro ao carregar tela de cliente:",
                        err
                    );

                    container.innerHTML =
                        '<p class="text-danger text-center my-4">' +
                        'Não foi possível carregar esta tela agora. Tente novamente.' +
                        '</p>';
                });
        }

        // ==========================================
        // TROCAR TELA LOGIN / REGISTRO / FORGOT
        // ==========================================

        document.addEventListener(
            "click",
            function (e) {

                const btn =
                    e.target.closest(".switch-mode");

                if (!btn)
                    return;

                e.preventDefault();

                const mode =
                    btn.dataset.mode;

                loadClienteLogin(mode);
            }
        );

        // ==========================================
        // ABRIR MODAL LOGIN
        // ==========================================

        document.addEventListener(
            "DOMContentLoaded",
            () => {

                const loginModal =
                    document.getElementById(
                        "clienteLoginModal"
                    );

                if (!loginModal)
                    return;

                loginModal.addEventListener(
                    "shown.bs.modal",
                    (event) => loadClienteLogin(
                        event.relatedTarget?.dataset.clienteMode || "login"
                    )
                );
            }
        );

        // ==========================================
        // SUBMIT LOGIN / REGISTRO / FORGOT
        // ==========================================

        document.body.addEventListener(
            "submit",
            async function (e) {

                const form = e.target;

                if (
                    !form.closest(
                        "#clienteLoginContent"
                    )
                )
                    return;

                e.preventDefault();

                mostrarAlertaCliente("");

                const urlsPorTipo = {
                    "cliente-login": "/cliente/login",
                    "cliente-register": "/cliente/registro",
                    "cliente-forgot": "/cliente/forgot",
                    "cliente-reset": "/cliente/resetpassword"
                };

                const url =
                    urlsPorTipo[form.dataset.type]
                    || form.action;

                const formData =
                    new FormData(form);

                try {

                    const response =
                        await fetch(
                            url,
                            {
                                method: "POST",
                                body: formData
                            });

                    const contentType =
                        response.headers.get(
                            "content-type"
                        );

                    if (
                        contentType &&
                        contentType.includes(
                            "application/json"
                        )
                    ) {

                        const data =
                            await response.json();

                        if (data.success) {

                            if (data.reload) {

                                bootstrap.Modal
                                    .getInstance(
                                        document.getElementById(
                                            "clienteLoginModal"
                                        )
                                    )
                                    ?.hide();

                                location.reload();

                                return;
                            }

                            if (data.redirect) {

                                window.location.href =
                                    data.redirect;

                                return;
                            }

                            if (data.message) {

                                mostrarAlertaCliente(
                                    data.message,
                                    "success"
                                );

                                setTimeout(
                                    () => location.reload(),
                                    2500
                                );

                                return;
                            }

                            location.reload();

                            return;
                        }

                        mostrarAlertaCliente(
                            data.error ||
                            "Erro ao processar."
                        );

                        return;
                    }

                    const html =
                        await response.text();

                    const doc =
                        new DOMParser()
                            .parseFromString(
                                html,
                                "text/html"
                            );

                    const content =
                        doc.querySelector(".auth-card")
                        || doc.querySelector(".login-card")
                        || doc.body;

                    document.getElementById(
                        "clienteLoginContent"
                    ).innerHTML =
                        content.outerHTML;
                }
                catch (err) {

                    console.error(err);

                    mostrarAlertaCliente(
                        "Erro ao processar a solicitação."
                    );
                }
            }
        );

        // ==========================================
        // VERIFICA CLIENTE LOGADO
        // ==========================================

        async function verificarClienteLogado() {

            const bloco =
                document.getElementById(
                    "blocoDadosCliente"
                );

            const blocoLogin =
                document.getElementById(
                    "blocoLoginCadastro"
                );

            const clienteId =
                document.getElementById(
                    "ClienteId"
                );

            const nome =
                document.getElementById(
                    "NomeCliente"
                );

            const telefone =
                document.getElementById(
                    "TelefoneCliente"
                );

            if (clienteId)
                clienteId.value = "";

            if (nome)
                nome.value = "";

            if (telefone)
                telefone.value = "";

            if (bloco)
                bloco.style.display = "block";

            if (blocoLogin)
                blocoLogin.style.display = "block";

            try {

                const response =
                    await fetch(
                        "/cliente/me"
                    );

                if (!response.ok)
                    return false;

                const cliente =
                    await response.json();

                if (!cliente.autenticado)
                    return false;

                clienteId.value =
                    cliente.clienteId;

                nome.value =
                    cliente.nome;

                telefone.value =
                    cliente.telefone;

                bloco.style.display =
                    "none";

                if (blocoLogin)
                    blocoLogin.style.display = "none";

                            const areaNavbar =
            document.getElementById(
                "areaClienteNavbar"
            );

        if (areaNavbar)
        {
            areaNavbar.innerHTML = `
                <div class="dropdown">

                    <button
                        class="btn-cta dropdown-toggle"
                        data-bs-toggle="dropdown">

                        👤 ${cliente.nome}
                    </button>

                    <ul class="dropdown-menu">

                        <li>
                            <a class="dropdown-item"
                               href="/Cliente/Agendamentos">

                                Meus Agendamentos
                            </a>
                        </li>

                        <li>
                            <form method="post" action="/cliente/logout" class="px-3">
                                <input type="hidden" name="__RequestVerificationToken" value="@csrfTokenLogout" />
                                <button type="submit" class="dropdown-item text-danger px-0">
                                    Sair
                                </button>
                            </form>
                        </li>

                    </ul>

                </div>
            `;
        }
                return true;
            }
            catch {

                bloco.style.display =
                    "block";

                return false;
            }
        }

        // ==========================================
        // MENSAGENS NO MODAL DE AGENDAMENTO
        // ==========================================

        function mostrarAlertaAgendamento(mensagem, tipo = "danger") {

            const alerta =
                document.getElementById("agendamentoAlert");

            if (!alerta)
                return;

            alerta.innerHTML = mensagem
                ? `<div class="alert alert-${tipo} py-2 mb-3">${mensagem}</div>`
                : "";
        }

        // ==========================================
        // AGENDAR AGORA (HERO) — ROLA ATÉ OS SERVIÇOS
        // ==========================================

        document.querySelector(".btn-agendar")
            ?.addEventListener("click", () => {

                document.getElementById("servicos")
                    ?.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
            });

        // ==========================================
        // ABRIR MODAL AGENDAMENTO
        // ==========================================

        document
            .querySelectorAll(".btn-schedule")
            .forEach(btn => {

                btn.addEventListener(
                    "click",
                    async function () {

                        const servicoId =
                            this.dataset.servico;

                        mostrarAlertaAgendamento("");

                        document.getElementById(
                            "ServicoId"
                        ).value =
                            servicoId;

                        const response =
                            await fetch(
                                `/Publico/Funcionarios/${empresaId}`
                            );

                        const funcionarios =
                            await response.json();

                        const select =
                            document.getElementById(
                                "FuncionarioId"
                            );

                        select.innerHTML =
                            '<option value="">Qualquer profissional</option>';

                        funcionarios.forEach(f => {

                            select.innerHTML += `
                                <option value="${f.id}">
                                    ${f.nome}
                                </option>
                            `;
                        });

                        // Só faz sentido escolher profissional quando há
                        // mais de um pra escolher — com 0 ou 1, o backend já
                        // resolve sozinho (sorteia o único ativo, ou agenda
                        // direto na empresa se não tiver nenhum).
                        const profissionalWrap =
                            document.getElementById(
                                "profissionalWrap"
                            );

                        if (funcionarios.length > 1) {
                            profissionalWrap.hidden = false;
                        } else {
                            profissionalWrap.hidden = true;
                            select.value = "";
                        }

                        await verificarClienteLogado();

                        new bootstrap.Modal(
                            document.getElementById(
                                "agendamentoModal"
                            )
                        ).show();
                    }
                );
            });

        // ==========================================
        // HORÁRIOS
        // ==========================================

        async function carregarHorarios() {

            const funcionarioId =
                document.getElementById(
                    "FuncionarioId"
                ).value;

            const servicoId =
                document.getElementById(
                    "ServicoId"
                ).value;

            const data =
                document.getElementById(
                    "DataAgendamento"
                ).value;

            if (!data)
                return;

            const response =
                await fetch(
                    `/Publico/HorariosDisponiveis?empresaId=${empresaId}&servicoId=${servicoId}&funcionarioId=${funcionarioId}&data=${data}`
                );

            const horarios =
                await response.json();

            const select =
                document.getElementById(
                    "Horario"
                );

            select.innerHTML = "";

            horarios.forEach(h => {

                select.innerHTML += `
                    <option value="${h}">
                        ${h}
                    </option>
                `;
            });
        }

        document.getElementById("FuncionarioId")
            ?.addEventListener(
                "change",
                carregarHorarios
            );

        document.getElementById("DataAgendamento")
            ?.addEventListener(
                "change",
                carregarHorarios
            );

        // ==========================================
        // CONFIRMAR AGENDAMENTO
        // ==========================================

        document.getElementById(
            "btnConfirmarAgendamento"
        )
        ?.addEventListener(
            "click",
            async () => {

                const data =
                    document.getElementById(
                        "DataAgendamento"
                    ).value;

                const hora =
                    document.getElementById(
                        "Horario"
                    ).value;

                if (!data || !hora) {

                    mostrarAlertaAgendamento(
                        "Selecione data e horário.",
                        "warning"
                    );

                    return;
                }

                mostrarAlertaAgendamento("");

                const payload = {

                    empresaId:
                        parseInt(
                            document.getElementById(
                                "EmpresaId"
                            ).value
                        ),

                    servicoId:
                        parseInt(
                            document.getElementById(
                                "ServicoId"
                            ).value
                        ),

                    funcionarioId:
                        document.getElementById(
                            "FuncionarioId"
                        ).value
                            ? parseInt(
                                document.getElementById(
                                    "FuncionarioId"
                                ).value
                            )
                            : null,

                    clienteId:
                        document.getElementById(
                            "ClienteId"
                        ).value
                            ? parseInt(
                                document.getElementById(
                                    "ClienteId"
                                ).value
                            )
                            : null,

                    nome:
                        document.getElementById(
                            "NomeCliente"
                        ).value,

                    telefone:
                        document.getElementById(
                            "TelefoneCliente"
                        ).value,

                    dataHora:
                        `${data}T${hora}:00`
                };

                const response =
                    await fetch(
                        "/Publico/Agendar",
                        {
                            method: "POST",
                            headers: {
                                "Content-Type":
                                    "application/json"
                            },
                            body:
                                JSON.stringify(
                                    payload
                                )
                        });

                const result =
                    await response.json();

                if (result.sucesso) {

                    mostrarAlertaAgendamento(
                        result.mensagem,
                        "success"
                    );

                    setTimeout(() => {
                        location.reload();
                    }, 1500);
                }
                else {

                    mostrarAlertaAgendamento(
                        result.mensagem ||
                        "Erro ao realizar agendamento."
                    );
                }
            }
        );

        // ==========================================
        // ABRIR LOGIN A PARTIR AGENDAMENTO
        // ==========================================

        document.getElementById(
            "abrirLoginCliente"
        )
        ?.addEventListener(
            "click",
            function (e) {

                e.preventDefault();

                bootstrap.Modal
                    .getInstance(
                        document.getElementById(
                            "agendamentoModal"
                        )
                    )
                    ?.hide();

                new bootstrap.Modal(
                    document.getElementById(
                        "clienteLoginModal"
                    )
                ).show();
            }
        );
            document.addEventListener(
        "DOMContentLoaded",
        async () => {

            renderPaginacaoServicos();

            await verificarClienteLogado();
        });

        // ==========================================
        // AVISO (MODAL) — fecha em 10s ou se o cliente fechar
        // ==========================================

        let avisoModalTimeout = null;

        function mostrarAviso(mensagem, sucesso = true) {

            const modalEl = document.getElementById("avisoModal");
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

            document.getElementById("avisoModalMensagem").textContent = mensagem;
            document.getElementById("avisoModalIcone").textContent = sucesso ? "✅" : "⚠️";

            modal.show();

            if (avisoModalTimeout) {
                clearTimeout(avisoModalTimeout);
            }

            avisoModalTimeout = setTimeout(() => modal.hide(), 10000);

            modalEl.addEventListener("hidden.bs.modal", () => {
                if (avisoModalTimeout) {
                    clearTimeout(avisoModalTimeout);
                    avisoModalTimeout = null;
                }
            }, { once: true });
        }

        // ==========================================
        // PLANOS — CONTRATAR
        // ==========================================

        document.querySelectorAll(".btn-contratar-plano").forEach(btn => {

            btn.addEventListener("click", async () => {

                const clienteIdInput = document.getElementById("ClienteId");

                if (!clienteIdInput.value) {
                    new bootstrap.Modal(
                        document.getElementById("clienteLoginModal")
                    ).show();
                    return;
                }

                btn.disabled = true;

                try {
                    const resp = await fetch("/Publico/SolicitarPlano", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            planoServicoId: parseInt(btn.dataset.planoId)
                        })
                    });

                    const data = await resp.json();

                    mostrarAviso(data.mensagem, data.sucesso);

                    if (!data.sucesso) {
                        btn.disabled = false;
                    }
                } catch (err) {
                    console.error(err);
                    mostrarAviso("Erro ao enviar solicitação.", false);
                    btn.disabled = false;
                }
            });
        });

        // ==========================================
        // AVALIAÇÕES — ESTRELAS + ENVIO
        // ==========================================

        let notaSelecionada = 0;

        function selecionarEstrelas(valor) {

            notaSelecionada = valor;

            document.querySelectorAll("#starPicker .star-pick")
                .forEach(el => {
                    el.classList.toggle(
                        "selected",
                        parseInt(el.dataset.valor) <= valor
                    );
                });
        }

        document.querySelectorAll("#starPicker .star-pick")
            .forEach(el => {
                el.addEventListener("click", () =>
                    selecionarEstrelas(parseInt(el.dataset.valor))
                );
            });

        document.getElementById("btnAbrirAvaliacao")
            ?.addEventListener("click", async () => {

                const clienteIdInput = document.getElementById("ClienteId");

                if (!clienteIdInput.value) {
                    new bootstrap.Modal(
                        document.getElementById("clienteLoginModal")
                    ).show();
                    return;
                }

                const formDiv = document.getElementById("formAvaliacao");
                const abrindo = formDiv.style.display === "none";

                formDiv.style.display = abrindo ? "" : "none";

                if (abrindo) {

                    try {
                        const resp = await fetch(
                            `/Publico/MinhaAvaliacao?empresaId=${empresaId}`
                        );

                        const data = await resp.json();

                        if (data.avaliado) {
                            selecionarEstrelas(data.nota);
                            document.getElementById("comentarioAvaliacao").value =
                                data.comentario || "";
                        }
                    } catch (err) {
                        console.error("Erro ao carregar avaliação:", err);
                    }
                }
            });

        document.getElementById("btnEnviarAvaliacao")
            ?.addEventListener("click", async () => {

                const alerta = document.getElementById("avaliacaoAlert");

                if (!notaSelecionada) {
                    alerta.innerHTML =
                        '<div class="alert alert-warning py-2 mb-0">Escolha de 1 a 5 estrelas.</div>';
                    return;
                }

                try {
                    const resp = await fetch("/Publico/Avaliar", {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            empresaId: parseInt(empresaId),
                            nota: notaSelecionada,
                            comentario: document.getElementById("comentarioAvaliacao").value
                        })
                    });

                    const data = await resp.json();

                    if (data.sucesso) {
                        alerta.innerHTML =
                            `<div class="alert alert-success py-2 mb-0">${data.mensagem}</div>`;
                        setTimeout(() => location.reload(), 1200);
                    } else {
                        alerta.innerHTML =
                            `<div class="alert alert-danger py-2 mb-0">${data.mensagem}</div>`;
                    }
                } catch (err) {
                    console.error(err);
                    alerta.innerHTML =
                        '<div class="alert alert-danger py-2 mb-0">Erro ao enviar avaliação.</div>';
                }
            });
    </script>

}