                    <a href="@mapsUrl"
                       target="_blank"
                       class="map-btn"
                       title="Ver no mapa">
                        🗺️
                    </a>
                </div>
            </div>
        }

        @if (linhasHorario.Any())
        {
            <div class="sidebar-section">
                <h3>🕐 Horário</h3>
                @foreach (var linha in linhasHorario)
                {
                    <p class="mb-1">@linha</p>
