@*
    Layout anterior da página pública, mantido só como backup pra voltar
    rápido se o novo (Index.cshtml) der problema em produção. O prefixo "_"
    tira do convention-based routing do MVC — "return View()" no
    PublicoController nunca resolve pra este arquivo sozinho, só se alguém
    chamar View("_Index") explicitamente. Sem uso ativo: se o novo ficar
    validado em produção por um tempo, pode apagar este arquivo.
*@
@model EmpresaAgendamento.ViewModels.EmpresaPublicaViewModel
@using EmpresaAgendamento.Helpers
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{

    var empresa = Model.Empresa;
    string nome = empresa.NomeFantasia ?? empresa.Nome;

    ViewData["Title"] = nome;

    // Usado pelo botão "Sair" do dropdown do cliente logado — ele monta o
    // menu via JS (innerHTML), então precisa do token pronto pra montar um
    // <form> de verdade em vez de um link GET pra uma rota que só aceita POST.
    var csrfTokenLogout = Antiforgery.GetAndStoreTokens(Context).RequestToken;

    // Só entra na linha quem realmente tem valor — sem isso, endereço
    // incompleto sobrava vírgula/traço solto ("Rua X, , Bairro").
    var linhaRua = string.Join(", ", new[] { empresa.Endereco, empresa.Numero, empresa.Complemento }
        .Where(p => !string.IsNullOrWhiteSpace(p)));

    var linhaBairroCidade = string.Join(" - ", new[]
        {
            empresa.Bairro,
            string.Join("/", new[] { empresa.Cidade, empresa.UF }.Where(p => !string.IsNullOrWhiteSpace(p)))
        }
        .Where(p => !string.IsNullOrWhiteSpace(p)));

    // CEP entra na mesma linha do bairro/cidade, sem cor diferenciada —
    // igual ao layout original — e só aparece se realmente tiver valor.
    var linhaEndereco = linhaBairroCidade;

    if (!string.IsNullOrWhiteSpace(empresa.CEP))
    {
        linhaEndereco = string.IsNullOrWhiteSpace(linhaEndereco)
            ? $"CEP {empresa.CEP}"
            : $"{linhaEndereco} — CEP {empresa.CEP}";
    }

    var temLocalizacao = !string.IsNullOrWhiteSpace(linhaRua) || !string.IsNullOrWhiteSpace(linhaEndereco);

    var queryMaps = Uri.EscapeDataString(
        string.Join(", ", new[] { empresa.Endereco, empresa.Numero, empresa.Bairro, empresa.Cidade, empresa.UF, empresa.CEP }
            .Where(p => !string.IsNullOrWhiteSpace(p))));

    var mapsUrl = $"https://www.google.com/maps/search/?api=1&query={queryMaps}";

    var linhasHorario = HorarioFormatHelper.FormatarPorDia(empresa.Horarios);

    // Cor de marca da empresa (opcional) — sobrescreve as variáveis de cor
    // só nesta página (renderização por request, nunca vaza pra outra
    // empresa). Sem cor configurada, mantém o padrão do Simpli Time.
    //
    // A ideia é literal: a página usa SÓ as duas cores escolhidas — a
    // PRIMÁRIA é o fundo dominante do layout inteiro (não uma versão
    // "escurecida" dela por cima do tema padrão — é a cor em si), e a
    // SECUNDÁRIA cuida dos detalhes (botões, links, destaques). Branco,
    // preto etc. só entram como base neutra de texto/contraste — nunca
    // substituindo a cor escolhida por outra coisa.
    static bool EhHexValido(string? hex) =>
        !string.IsNullOrWhiteSpace(hex) && System.Text.RegularExpressions.Regex.IsMatch(hex, "^#[0-9A-Fa-f]{6}$");

    static (int R, int G, int B) HexParaRgb(string hex) => (
        Convert.ToInt32(hex.Substring(1, 2), 16),
        Convert.ToInt32(hex.Substring(3, 2), 16),
        Convert.ToInt32(hex.Substring(5, 2), 16));

    // Mistura linear simples de duas cores (mesmo resultado do color-mix()
    // do CSS em srgb) — usada só pra criar variação de profundidade (cards
    // um pouco mais claros/escuros que o fundo) sem inventar uma cor nova:
    // é sempre a própria cor da empresa misturada com o neutro de contraste.
    static string Misturar(string hexA, string hexB, double pctA)
    {
        var (ar, ag, ab) = HexParaRgb(hexA);
        var (br, bg, bb) = HexParaRgb(hexB);
        var p = Math.Clamp(pctA, 0, 100) / 100.0;

        int r = (int)Math.Round(ar * p + br * (1 - p));
        int g = (int)Math.Round(ag * p + bg * (1 - p));
        int b = (int)Math.Round(ab * p + bb * (1 - p));

        return $"#{r:X2}{g:X2}{b:X2}";
    }

    static string ComAlpha(string hex, double alpha)
    {
        var (r, g, b) = HexParaRgb(hex);
        return $"rgba({r},{g},{b},{alpha.ToString(System.Globalization.CultureInfo.InvariantCulture)})";
    }

    // Luminância relativa — decide se o texto/contraste em cima de uma cor
    // fica preto ou branco, pra manter legível com qualquer cor escolhida
    // (inclusive branco ou preto puro).
    static string CorContraste(string hex)
    {
        var (r, g, b) = HexParaRgb(hex);
        var luminancia = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
        return luminancia > 0.6 ? "#111111" : "#ffffff";
    }

    var temPrimaria = EhHexValido(empresa.CorPrimaria);
    var temSecundaria = EhHexValido(empresa.CorSecundaria);

    var corMarcaCss = "";
    var corMarcaLoginCss = "";

    if (temPrimaria)
    {
        var primaria = empresa.CorPrimaria!;
        var textoBase = CorContraste(primaria);

        // Fundo = a própria cor primária, sem alteração nenhuma. bg2/3/4 são
        // só um leve degradê de profundidade (cards, inputs) misturando a
        // mesma cor com o neutro de contraste — nunca uma cor diferente.
        var bg2 = Misturar(primaria, textoBase, 92);
        var bg3 = Misturar(primaria, textoBase, 84);
        var bg4 = Misturar(primaria, textoBase, 76);

        var texto2 = Misturar(textoBase, primaria, 65);
        var texto3 = Misturar(textoBase, primaria, 40);

        // Secundária = detalhes (botões, links, seleção, ícones). Sem
        // secundária configurada, os detalhes usam um tom do neutro de
        // contraste misturado na própria primária — continua sendo "só as
        // duas cores da empresa" (aqui, só a primária existe mesmo).
        var detalhe = temSecundaria ? empresa.CorSecundaria! : Misturar(primaria, textoBase, 75);
        var detalhe2 = Misturar(detalhe, textoBase, 85);
        var detalheContraste = CorContraste(detalhe);

        corMarcaCss =
            $"--bg:{primaria};" +
            $"--bg2:{bg2};--bg3:{bg3};--bg4:{bg4};" +
            $"--text:{textoBase};--text2:{texto2};--text3:{texto3};" +
            $"--border:{ComAlpha(textoBase, 0.10)};--border2:{ComAlpha(textoBase, 0.18)};" +
            $"--footer-bg:{bg2};--nav-bg:{ComAlpha(primaria, 0.92)};" +
            $"--accent:{detalhe};--accent2:{detalhe2};--accent-contrast:{detalheContraste};";

        corMarcaLoginCss =
            $"--login-btn:{detalhe};--login-btn-hover:{detalhe2};" +
            $"--login-btn-contrast:{detalheContraste};--login-accent-soft:{detalhe}22;";
    }
}

@section Styles {
    <style>
        /* Estilo do formulário de login/registro/recuperação carregado dentro
           do modal público. Escopado em #clienteLoginContent de propósito —
           as telas originais (/cliente/login, /registro, /forgot) têm seu
           próprio <style> com regras de "body"/página cheia que NÃO podem
           ser copiadas para cá (vazariam para o fundo do site). */
        #clienteLoginModal .modal-content {
            background: #ffffff;
        }

        #clienteLoginContent .login-card,
        #clienteLoginContent .auth-card {
            background: transparent;
            box-shadow: none;
            padding: 0;
            border: none;
        }

        #clienteLoginContent h3,
        #clienteLoginContent h4,
        #clienteLoginContent p,
        #clienteLoginContent label,
        #clienteLoginContent .text-muted {
            color: #212529;
        }

        #clienteLoginContent {
            /* Padrão do sistema (sem cor de marca configurada pela empresa)
               — mantém o azul original em vez de herdar o dourado padrão do
               resto da página pública, que é um elemento visual diferente. */
            --login-btn: #2563eb;
            --login-btn-hover: #1e40af;
            --login-btn-contrast: #ffffff;
            --login-accent-soft: #eff6ff;
        }

        /* Ícone e título — existiam em site.css (Home/telas do portal), mas
           a página pública não carrega site.css, então ficavam sem nenhum
           estilo (círculo, tamanho, cor). */
        #clienteLoginContent .auth-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: var(--login-accent-soft);
            color: var(--login-btn);
            font-size: 1.5rem;
            margin-bottom: .75rem;
        }

        #clienteLoginContent .auth-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: #212529;
            margin-bottom: .25rem;
        }

        #clienteLoginContent .form-control,
        #clienteLoginContent .form-select {
            border-radius: 10px;
            border: 1px solid #E5E7EB;
        }

        #clienteLoginContent .form-control:focus,
        #clienteLoginContent .form-select:focus {
            border-color: var(--login-btn);
            box-shadow: 0 0 0 3px color-mix(in srgb, var(--login-btn) 15%, transparent);
        }

        #clienteLoginContent .form-check-input:checked {
            background-color: var(--login-btn);
            border-color: var(--login-btn);
        }

        #clienteLoginContent .btn-primary,
        #clienteLoginContent .btn-dark {
            border-radius: 10px;
            background: var(--login-btn);
            color: var(--login-btn-contrast);
            border: none;
        }

        #clienteLoginContent .btn-primary:hover,
        #clienteLoginContent .btn-dark:hover {
            background: var(--login-btn-hover);
        }

        #clienteLoginContent a {
            color: #6B7280;
        }

        #clienteLoginContent a:hover {
            color: var(--login-btn);
        }
    </style>

    @if (!string.IsNullOrEmpty(corMarcaCss))
    {
        <style>
            /* Mesma regra pro tema escuro (:root) e pro claro
               (body.light-theme, ativado pelo botão 🌙/☀️) — com cor de
               marca configurada, a página usa sempre a mesma cor da
               empresa, o alternador de tema não "revela" o preto/branco
               padrão por baixo. */
            :root, body.light-theme {
                @Html.Raw(corMarcaCss)
            }
        </style>
    }

    @if (!string.IsNullOrEmpty(corMarcaLoginCss))
    {
        <style>#clienteLoginContent{@Html.Raw(corMarcaLoginCss)}</style>
    }
}

