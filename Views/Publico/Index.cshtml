@model EmpresaAgendamento.ViewModels.EmpresaPublicaViewModel
@using EmpresaAgendamento.Helpers
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{

    var empresa = Model.Empresa;
    string nome = empresa.NomeFantasia ?? empresa.Nome;

    ViewData["Title"] = nome;

    // Usado pelo botão "Sair" do dropdown do cliente logado — ele monta o
    // menu via JS (innerHTML), então precisa do token pronto pra montar um
    // <form> de verdade em vez de um link GET pra uma rota que só aceita POST.
    var csrfTokenLogout = Antiforgery.GetAndStoreTokens(Context).RequestToken;

    // Só entra na linha quem realmente tem valor — sem isso, endereço
    // incompleto sobrava vírgula/traço solto ("Rua X, , Bairro").
    var linhaRua = string.Join(", ", new[] { empresa.Endereco, empresa.Numero, empresa.Complemento }
        .Where(p => !string.IsNullOrWhiteSpace(p)));

    var linhaBairroCidade = string.Join(" - ", new[]
        {
            empresa.Bairro,
            string.Join("/", new[] { empresa.Cidade, empresa.UF }.Where(p => !string.IsNullOrWhiteSpace(p)))
        }
        .Where(p => !string.IsNullOrWhiteSpace(p)));

    var linhaEndereco = linhaBairroCidade;

    if (!string.IsNullOrWhiteSpace(empresa.CEP))
    {
        linhaEndereco = string.IsNullOrWhiteSpace(linhaEndereco)
            ? $"CEP {empresa.CEP}"
            : $"{linhaEndereco} — CEP {empresa.CEP}";
    }

    var temLocalizacao = !string.IsNullOrWhiteSpace(linhaRua) || !string.IsNullOrWhiteSpace(linhaEndereco);

    var queryMaps = Uri.EscapeDataString(
        string.Join(", ", new[] { empresa.Endereco, empresa.Numero, empresa.Bairro, empresa.Cidade, empresa.UF, empresa.CEP }
            .Where(p => !string.IsNullOrWhiteSpace(p))));

    var mapsUrl = $"https://www.google.com/maps/search/?api=1&query={queryMaps}";

    var linhasHorario = HorarioFormatHelper.FormatarPorDia(empresa.Horarios);
    var linhasHorarioResumo = HorarioFormatHelper.FormatarLinhas(empresa.Horarios);

    var agora = DateTime.Now;
    var statusAtual = HorarioFormatHelper.ObterStatusAtual(empresa.Horarios, agora);
    var horarioDeHoje = HorarioFormatHelper.HorarioDeHoje(empresa.Horarios, agora);

    // Capa do hero: banner que a empresa configurou em Configurações, e na
    // falta dele a primeira foto da galeria — mesma cascata já usada em
    // EmpresaDescobertaService.cs pra o card da vitrine de empresas. Sem
    // nenhuma das duas, cai num gradiente (ver .hero-cover-wrap.sem-capa).
    var capaUrl = !string.IsNullOrWhiteSpace(empresa.CapaBannerUrl)
        ? empresa.CapaBannerUrl
        : Model.Fotos.OrderBy(f => f.DataUpload).Select(f => f.Url).FirstOrDefault();

    var temAnoFundacao = empresa.AnoFundacao.HasValue
        && empresa.AnoFundacao.Value > 1900
        && empresa.AnoFundacao.Value <= agora.Year;

    var anosAtuando = temAnoFundacao ? agora.Year - empresa.AnoFundacao!.Value : 0;

    // Só mostra a faixa de números se tiver pelo menos um número real —
    // nada de estimativa/placeholder ("2.400+ clientes") sem dado por trás.
    var temTrustbar = Model.TotalAvaliacoes > 0 || temAnoFundacao;

    // As 5 fotos mais antigas pra prévia acima da aba — mesma ordenação que
    // a aba Galeria já usa (Model.Fotos vem ordenado por DataUpload do
    // controller).
    var fotosDestaque = Model.Fotos.Take(5).ToList();

    // Prévia de avaliações: as com comentário, nota mais alta primeiro —
    // é vitrine, não a lista completa (essa continua na aba).
    var depoimentosDestaque = Model.Avaliacoes
        .Where(a => !string.IsNullOrWhiteSpace(a.Comentario))
        .OrderByDescending(a => a.Nota)
        .ThenByDescending(a => a.DataAtualizacao ?? a.DataCriacao)
        .Take(3)
        .ToList();

    string? whatsappLink = null;

    if (!string.IsNullOrEmpty(empresa.WhatsApp))
    {
        whatsappLink = empresa.WhatsApp.StartsWith("http")
            ? empresa.WhatsApp
            : $"https://wa.me/{empresa.WhatsApp.Replace("(", "").Replace(")", "").Replace(" ", "").Replace("-", "")}";
    }

    // Cor de marca da empresa (opcional) — sobrescreve as variáveis de cor só
    // nesta página (renderização por request, nunca vaza pra outra empresa).
    // Cálculo mora em Helpers/CorMarcaHelper.cs — inclui o ajuste de
    // contraste mínimo do texto (ver comentário lá) e é usado tanto aqui
    // quanto no botão do modal de login/cadastro do cliente, mais abaixo.
    var corMarcaCss = CorMarcaHelper.GerarVariaveisTema(empresa.CorPrimaria, empresa.CorSecundaria);
    var corMarcaLoginCss = CorMarcaHelper.GerarVariaveisLogin(empresa.CorPrimaria, empresa.CorSecundaria);
}

@section Styles {
    <style>
        /* Estilo do formulário de login/registro/recuperação carregado dentro
           do modal público. Escopado em #clienteLoginContent de propósito —
           as telas originais (/cliente/login, /registro, /forgot) têm seu
           próprio <style> com regras de "body"/página cheia que NÃO podem
           ser copiadas para cá (vazariam para o fundo do site). */
        #clienteLoginModal .modal-content {
            background: #ffffff;
        }

        #clienteLoginContent .login-card,
        #clienteLoginContent .auth-card {
            background: transparent;
            box-shadow: none;
            padding: 0;
            border: none;
        }

        #clienteLoginContent h3,
        #clienteLoginContent h4,
        #clienteLoginContent p,
        #clienteLoginContent label,
        #clienteLoginContent .text-muted {
            color: #212529;
        }

        #clienteLoginContent {
            /* Padrão do sistema (sem cor de marca configurada pela empresa)
               — mantém o azul original em vez de herdar o dourado padrão do
               resto da página pública, que é um elemento visual diferente. */
            --login-btn: #2563eb;
            --login-btn-hover: #1e40af;
            --login-btn-contrast: #ffffff;
            --login-accent-soft: #eff6ff;
        }

        /* Ícone e título — existiam em site.css (Home/telas do portal), mas
           a página pública não carrega site.css, então ficavam sem nenhum
           estilo (círculo, tamanho, cor). */
        #clienteLoginContent .auth-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 56px;
            height: 56px;
            border-radius: 50%;
            background: var(--login-accent-soft);
            color: var(--login-btn);
            font-size: 1.5rem;
            margin-bottom: .75rem;
        }

        #clienteLoginContent .auth-title {
            font-size: 1.15rem;
            font-weight: 700;
            color: #212529;
            margin-bottom: .25rem;
        }

        #clienteLoginContent .form-control,
        #clienteLoginContent .form-select {
            border-radius: 10px;
            border: 1px solid #E5E7EB;
        }

        #clienteLoginContent .form-control:focus,
        #clienteLoginContent .form-select:focus {
            border-color: var(--login-btn);
            box-shadow: 0 0 0 3px color-mix(in srgb, var(--login-btn) 15%, transparent);
        }

        #clienteLoginContent .form-check-input:checked {
            background-color: var(--login-btn);
            border-color: var(--login-btn);
        }

        #clienteLoginContent .btn-primary,
        #clienteLoginContent .btn-dark {
            border-radius: 10px;
            background: var(--login-btn);
            color: var(--login-btn-contrast);
            border: none;
        }

        #clienteLoginContent .btn-primary:hover,
        #clienteLoginContent .btn-dark:hover {
            background: var(--login-btn-hover);
        }

        #clienteLoginContent a {
            color: #6B7280;
        }

        #clienteLoginContent a:hover {
            color: var(--login-btn);
        }
    </style>

    @if (!string.IsNullOrEmpty(corMarcaCss))
    {
        <style>
            /* Mesma regra pro tema escuro (:root) e pro claro
               (body.light-theme, ativado pelo botão 🌙/☀️) — com cor de
               marca configurada, a página usa sempre a mesma cor da
               empresa, o alternador de tema não "revela" o preto/branco
               padrão por baixo. */
            :root, body.light-theme {
                @Html.Raw(corMarcaCss)
            }
        </style>
    }

    @if (!string.IsNullOrEmpty(corMarcaLoginCss))
    {
        <style>#clienteLoginContent{@Html.Raw(corMarcaLoginCss)}</style>
    }
}

@section Navbar {
    <a class="navbar-brand d-flex align-items-center" href="/">
        <img id="logoSite"
             src="~/img/logocliente.png"
             alt="Logo"
             class="navbar-logo me-2" />
    </a>

    <div class="nav-links">
        <a href="#">Início</a>
        <a href="#servicos">Serviços</a>
        @if (fotosDestaque.Any())
        {
            <a href="#galeria-preview">Galeria</a>
        }
        <a href="#contato">Contato</a>
        <a href="/empresas">Encontrar empresas</a>
    </div>

    <div id="areaClienteNavbar">

        <button class="btn-cta"
                id="btnEntrarCliente"
                data-bs-toggle="modal"
                data-bs-target="#clienteLoginModal"
                data-cliente-mode="login">
            Entrar
        </button>

    </div>
}

<div class="hero">

    <div class="hero-cover-wrap @(string.IsNullOrWhiteSpace(capaUrl) ? "sem-capa" : "")">
        @if (!string.IsNullOrWhiteSpace(capaUrl))
        {
            <img src="@capaUrl" alt="" />
        }
        <div class="hero-cover-fade"></div>
    </div>

    <div class="hero-header hero-body @(string.IsNullOrWhiteSpace(capaUrl) ? "" : "com-capa")">

        <div class="hero-identity">
            <div class="logo-ring">
                <img src="@empresa.LogoUrl" />

                @if (Model.NotaMedia.HasValue)
                {
                    <div class="rating-badge">★ @Model.NotaMedia.Value.ToString("F1")</div>
                }
            </div>

            <div class="hero-name">
                <h1>@nome</h1>

                @if (empresa.Categoria.HasValue)
                {
                    <div class="segment">
                        @CategoriaEmpresaHelper.NomeExibicao(empresa.Categoria)
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(empresa.Slogan))
                {
                    <p style="font-size:13px;color:var(--text2);margin-top:4px;max-width:520px;">@empresa.Slogan</p>
                }

                @if (Model.NotaMedia.HasValue)
                {
                    <div class="stars">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <span class="star">@(i <= Math.Round(Model.NotaMedia.Value) ? "★" : "☆")</span>
                        }
                        <span class="review-count">@Model.NotaMedia.Value.ToString("F1") (@Model.TotalAvaliacoes avaliações)</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(statusAtual.Texto))
                {
                    <div class="status-chip @(statusAtual.Aberto ? "aberto" : "fechado")">
                        @if (statusAtual.Aberto)
                        {
                            <span class="pulse"></span>
                        }
                        else
                        {
                            <i class="bi bi-clock"></i>
                        }
                        @statusAtual.Texto
                    </div>
                }
            </div>
        </div>

        <div class="hero-actions">
            @if (whatsappLink != null)
            {
                <a class="btn-wpp" href="@whatsappLink" target="_blank" rel="noopener">
                    <i class="bi bi-whatsapp"></i> WhatsApp
                </a>
            }
            <button class="btn-agendar">Agendar agora</button>
        </div>

    </div>

</div>

<div class="wrap">
    <input type="hidden"
           id="EmpresaId"
           value="@Model.Empresa.Id" />

    <!-- Info essencial visível sem precisar rolar — inclusive no celular,
         onde a sidebar completa (mais abaixo) só aparece depois de todo o
         conteúdo de serviços. -->
    <div class="quickinfo">

        @if (temLocalizacao)
        {
            <a class="qi-item link" href="@mapsUrl" target="_blank" rel="noopener">
                <i class="bi bi-geo-alt"></i>
                <div class="lbl">@(string.IsNullOrWhiteSpace(linhaRua) ? linhaEndereco : linhaRua)</div>
            </a>
        }

        @if (horarioDeHoje != null)
        {
            <div class="qi-item">
                <i class="bi bi-clock"></i>
                <div class="lbl">Hoje</div>
                <div class="val">@horarioDeHoje</div>
            </div>
        }

        @if (empresa.AceitaPix || empresa.AceitaDinheiro || empresa.AceitaCartaoDebito || empresa.AceitaCartaoCredito)
        {
            <div class="qi-item">
                <i class="bi bi-credit-card"></i>
                <div class="lbl">
                    @string.Join(" · ", new[] {
                        empresa.AceitaPix ? "Pix" : null,
                        empresa.AceitaDinheiro ? "Dinheiro" : null,
                        empresa.AceitaCartaoDebito ? "Débito" : null,
                        empresa.AceitaCartaoCredito ? "Crédito" : null,
                    }.Where(t => t != null))
                </div>
                @if (empresa.ParcelamentoMaximo > 1)
                {
                    <div class="val">até @(empresa.ParcelamentoMaximo)x</div>
                }
            </div>
        }

        @if (whatsappLink != null)
        {
            <a class="qi-item link" href="@whatsappLink" target="_blank" rel="noopener">
                <i class="bi bi-whatsapp"></i>
                <div class="lbl">Fale agora</div>
                <div class="val">@empresa.WhatsApp</div>
            </a>
        }

    </div>

    @if (temTrustbar)
    {
        <div class="trustbar">
            @if (Model.NotaMedia.HasValue)
            {
                <div class="trust-stat"><div class="n">@Model.NotaMedia.Value.ToString("F1")</div><div class="l">nota média</div></div>
            }
            @if (Model.TotalAvaliacoes > 0)
            {
                <div class="trust-stat"><div class="n">@Model.TotalAvaliacoes</div><div class="l">avaliaç@(Model.TotalAvaliacoes == 1 ? "ão" : "ões")</div></div>
            }
            @if (temAnoFundacao)
            {
                <div class="trust-stat"><div class="n">@anosAtuando</div><div class="l">ano@(anosAtuando == 1 ? "" : "s") de atuação</div></div>
            }
        </div>
    }

    @if (fotosDestaque.Any())
    {
        <section id="galeria-preview" style="margin-bottom:2.5rem;">
            <div class="preview-head">
                <h2>Nosso trabalho</h2>
                @if (Model.Fotos.Count > fotosDestaque.Count)
                {
                    <button type="button" class="ver-todas" data-abrir-aba="tabGaleria">Ver todas as fotos (@Model.Fotos.Count) →</button>
                }
            </div>

            <div class="gallery">

                <div class="gallery-main" data-bs-toggle="modal" data-bs-target="#galeriaModal" data-foto-index="0">
                    <img src="@fotosDestaque[0].Url" alt="Foto 1" />
                </div>

                @if (fotosDestaque.Count > 1)
                {
                    <div class="gallery-thumb" data-bs-toggle="modal" data-bs-target="#galeriaModal" data-foto-index="1">
                        <img src="@fotosDestaque[1].Url" alt="Foto 2" />
                    </div>
                }

                @if (fotosDestaque.Count > 2)
                {
                    <div class="gallery-thumb" data-bs-toggle="modal" data-bs-target="#galeriaModal" data-foto-index="2">
                        <img src="@fotosDestaque[2].Url" alt="Foto 3" />

                        @if (Model.Fotos.Count > 3)
                        {
                            <div class="gallery-more">
                                +@(Model.Fotos.Count - 3) fotos
                            </div>
                        }
                    </div>
                }

            </div>
        </section>
    }

    @if (depoimentosDestaque.Any())
    {
        <section id="avaliacoes-preview" style="margin-bottom:2.5rem;">
            <div class="preview-head">
                <h2>O que dizem os clientes</h2>
                <button type="button" class="ver-todas" data-abrir-aba="tabAvaliacoes">Ver todas (@Model.TotalAvaliacoes) →</button>
            </div>

            <div class="testi-grid">
                @foreach (var av in depoimentosDestaque)
                {
                    <div class="testi-card">
                        <span class="stars-display">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span class="star">@(i <= av.Nota ? "★" : "☆")</span>
                            }
                        </span>
                        <p>"@av.Comentario"</p>
                        <div class="testi-who">
                            <div class="testi-avatar">@(string.IsNullOrWhiteSpace(av.Cliente?.Nome) ? "?" : av.Cliente.Nome.Trim().Substring(0, 1).ToUpper())</div>
                            <div>
                                <div class="name">@(av.Cliente?.Nome ?? "Cliente")</div>
                                <div class="when">@((av.DataAtualizacao ?? av.DataCriacao).ToString("dd/MM/yyyy"))</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <div class="layout">

        <div class="left-col">

            <p class="desc-text" id="desc">
                @empresa.Descricao
            </p>

            <button class="toggle-desc" onclick="toggleDesc()">Ver mais</button>

            <!-- Comodidades -->
            <div>
                <div class="section-title">Comodidades</div>
                <div class="section-sub">Clique no item para obter informações</div>

                <div class="amenities-grid">

                    <div class="amenity @(Model.Empresa.TemWifi ? "" : "off")"
                         title="Wi-Fi gratuito disponível">
                        <div class="icon"><i class="bi bi-wifi"></i></div>
                        <div class="label">Wi-Fi</div>
                    </div>

                    <div class="amenity @(Model.Empresa.TemEstacionamento ? "" : "off")"
                         title="Estacionamento disponível">
                        <div class="icon"><i class="bi bi-p-square"></i></div>
                        <div class="label">Estacionamento</div>
                    </div>

                    <div class="amenity @(Model.Empresa.TemAcessibilidade ? "" : "off")"
                         title="Acessibilidade no local">
                        <div class="icon"><i class="bi bi-universal-access"></i></div>
                        <div class="label">Acessibilidade</div>
                    </div>

                    <div class="amenity @(Model.Empresa.TemArCondicionado ? "" : "off")"
                         title="Ambiente climatizado">
                        <div class="icon"><i class="bi bi-snow"></i></div>
                        <div class="label">Ar-condicionado</div>
                    </div>

                    <div class="amenity @(Model.Empresa.AtendimentoOnline ? "" : "off")"
                         title="Atendimento online disponível">
                        <div class="icon"><i class="bi bi-laptop"></i></div>
                        <div class="label">Atendimento online</div>
                    </div>

                    <div class="amenity @(Model.Empresa.TemWifi ? "" : "off")"
                         title="Ambiente com conexão disponível">
                        <div class="icon"><i class="bi bi-cup-hot"></i></div>
                        <div class="label">Café / Wi-Fi</div>
                    </div>

                    <div class="amenity @(Model.Empresa.TemEstacionamento ? "" : "off")"
                         title="Ambiente seguro e estruturado">
                        <div class="icon"><i class="bi bi-shield-check"></i></div>
                        <div class="label">Segurança</div>
                    </div>

                    <div class="amenity @(string.IsNullOrEmpty(Model.Empresa.ComodidadesExtras) ? "off" : "")"
                         title="@Model.Empresa.ComodidadesExtras">
                        <div class="icon"><i class="bi bi-plus-circle"></i></div>
                        <div class="label">Extras</div>
                    </div>

                </div>
            </div>

            <div id="servicos">

                <div class="tabs-wrapper">
                    <div class="tabs">
                        <button class="tab-btn active" data-tab="tabServicos">Serviços</button>
                        @if (Model.TemProdutos)
                        {
                            <button class="tab-btn" data-tab="tabProdutos">Produtos</button>
                        }
                        @if (Model.PlanosServico != null && Model.PlanosServico.Any())
                        {
                            <button class="tab-btn" data-tab="tabPlanos">Planos</button>
                        }
                        <button class="tab-btn" data-tab="tabGaleria">Galeria</button>
                        <button class="tab-btn" data-tab="tabAvaliacoes">Avaliações (@Model.TotalAvaliacoes)</button>
                    </div>
                </div>

                <!-- ===================== SERVIÇOS ===================== -->
                <div id="tabServicos" class="tab-pane-publico">

                    <div class="search-box">
                        <i class="bi bi-search"></i>
                        <input type="search"
                               placeholder="Pesquisar serviço"
                               id="searchInput"
                               oninput="filterServices()" />
                    </div>

                    <div class="services-list">

                        @if (Model.Servicos != null && Model.Servicos.Any())
                        {
                            foreach (var s in Model.Servicos)
                            {
                                <div class="service-item" data-name="@s.Nome.ToLower()">

                                    <div class="service-img"><i class="bi bi-stars"></i></div>

                                    <div class="service-info">
                                        <div class="name">@s.Nome</div>

                                        @if (!string.IsNullOrEmpty(s.Descricao))
                                        {
                                            <div class="desc">@s.Descricao</div>
                                        }

                                        <div class="meta">
                                            <span class="price">@(s.Preco > 0 ? $"R$ {s.Preco:F2}" : "Grátis")</span>
                                            <span class="duration"><i class="bi bi-clock"></i> @s.DuracaoMinutos min</span>
                                        </div>
                                    </div>

                                    <button class="btn-schedule"
                                            data-servico="@s.Id"
                                            data-servico-nome="@s.Nome">
                                        Agendar
                                    </button>

                                </div>
                            }
                        }
                        else
                        {
                            <p style="color:var(--text2)">
                                Nenhum serviço disponível.
                            </p>
                        }

                    </div>

                    <div class="pagination-public" id="servicosPaginacao"></div>

                </div>

                @if (Model.TemProdutos)
                {
                    <!-- ===================== PRODUTOS ===================== -->
                    <div id="tabProdutos" class="tab-pane-publico" style="display:none">

                        <div class="services-list">

                            @foreach (var p in Model.Produtos)
                            {
                                <div class="service-item">

                                    @if (!string.IsNullOrWhiteSpace(p.FotoUrl))
                                    {
                                        <img src="@p.FotoUrl" alt="@p.Nome" class="service-img" style="object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="service-img"><i class="bi bi-bag"></i></div>
                                    }

                                    <div class="service-info">
                                        <div class="name">@p.Nome</div>

                                        @if (!string.IsNullOrEmpty(p.Descricao))
                                        {
                                            <div class="desc">@p.Descricao</div>
                                        }

                                        <div class="meta">
                                            <span class="price">R$ @p.Preco.ToString("F2")</span>
                                        </div>
                                    </div>

                                </div>
                            }

                        </div>

                        <p class="small mt-2" style="color:var(--text2)">
                            Produtos disponíveis para consumo durante o atendimento — não são vendidos separadamente por aqui.
                        </p>

                    </div>
                }

                @if (Model.PlanosServico != null && Model.PlanosServico.Any())
                {
                    <!-- ===================== PLANOS ===================== -->
                    <div id="tabPlanos" class="tab-pane-publico" style="display:none">

                        <div class="plans-grid">

                            @foreach (var plano in Model.PlanosServico)
                            {
                                <div class="plan-card">

                                    <div class="plan-card-header">
                                        <h4>@plano.Nome</h4>
                                        <span class="plan-periodicidade">
                                            @(plano.Periodicidade == EmpresaAgendamento.Models.Enums.PeriodicidadePlanoServico.Semanal ? "Semanal" : "Mensal")
                                        </span>
                                    </div>

                                    @if (plano.ValorReferencia.HasValue)
                                    {
                                        <div class="plan-price">
                                            @if (plano.ValorReferencia.Value > 0)
                                            {
                                                @($"R$ {plano.ValorReferencia.Value:F2}")
                                                <span>/ @(plano.Periodicidade == EmpresaAgendamento.Models.Enums.PeriodicidadePlanoServico.Semanal ? "semana" : "mês")</span>
                                            }
                                            else
                                            {
                                                @:Grátis
                                            }
                                        </div>
                                    }

                                    <div class="plan-usos">
                                        @plano.QuantidadeUsos sessões por período
                                    </div>

                                    @if (plano.Servicos.Any())
                                    {
                                        <ul class="plan-servicos">
                                            @foreach (var item in plano.Servicos)
                                            {
                                                <li>@item.Servico.Nome</li>
                                            }
                                        </ul>
                                    }

                                    <button class="btn-agendar btn-contratar-plano" data-plano-id="@plano.Id" style="margin-top:10px;">
                                        Contratar plano
                                    </button>

                                    <p class="plan-contato-nota">
                                        A empresa confirma o pagamento com você e libera os créditos.
                                    </p>

                                </div>
                            }

                        </div>

                        <div class="pagination-public" id="planosPaginacao"></div>

                    </div>
                }

                <!-- ===================== GALERIA ===================== -->
                <div id="tabGaleria" class="tab-pane-publico" style="display:none">

                    @if (Model.Fotos != null && Model.Fotos.Any())
                    {
                        <div class="gallery">

                            <div class="gallery-main" data-bs-toggle="modal" data-bs-target="#galeriaModal" data-foto-index="0">
                                <img src="@Model.Fotos[0].Url" alt="Foto 1" />
                            </div>

                            @if (Model.Fotos.Count > 1)
                            {
                                <div class="gallery-thumb" data-bs-toggle="modal" data-bs-target="#galeriaModal" data-foto-index="1">
                                    <img src="@Model.Fotos[1].Url" alt="Foto 2" />
                                </div>
                            }

                            @if (Model.Fotos.Count > 2)
                            {
                                <div class="gallery-thumb" data-bs-toggle="modal" data-bs-target="#galeriaModal" data-foto-index="2">
                                    <img src="@Model.Fotos[2].Url" alt="Foto 3" />

                                    @if (Model.Fotos.Count > 3)
                                    {
                                        <div class="gallery-more">
                                            +@(Model.Fotos.Count - 3) fotos
                                        </div>
                                    }
                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <p style="color:var(--text2)">Nenhuma foto adicionada ainda.</p>
                    }

                </div>

                <!-- ===================== AVALIAÇÕES ===================== -->
                <div id="tabAvaliacoes" class="tab-pane-publico" style="display:none">

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">

                        <div>
                            @if (Model.NotaMedia.HasValue)
                            {
                                <span class="stars-display">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="star">@(i <= Math.Round(Model.NotaMedia.Value) ? "★" : "☆")</span>
                                    }
                                </span>
                                <strong>@Model.NotaMedia.Value.ToString("F1")</strong>
                                <span class="review-count">(@Model.TotalAvaliacoes avaliações)</span>
                            }
                            else
                            {
                                <span class="review-count">Ainda sem avaliações — seja o primeiro!</span>
                            }
                        </div>

                        <button class="btn-agendar" id="btnAbrirAvaliacao" style="padding:8px 18px;font-size:13px;">
                            Deixar avaliação
                        </button>

                    </div>

                    <div id="formAvaliacao" style="display:none" class="mb-4">

                        <div class="star-picker" id="starPicker">
                            <span class="star-pick" data-valor="1">★</span>
                            <span class="star-pick" data-valor="2">★</span>
                            <span class="star-pick" data-valor="3">★</span>
                            <span class="star-pick" data-valor="4">★</span>
                            <span class="star-pick" data-valor="5">★</span>
                        </div>

                        <textarea id="comentarioAvaliacao"
                                  class="form-control mt-2"
                                  rows="3"
                                  placeholder="Conte como foi sua experiência (opcional)"></textarea>

                        <button class="btn-agendar mt-2" id="btnEnviarAvaliacao" style="padding:8px 18px;font-size:13px;">
                            Enviar
                        </button>

                        <div id="avaliacaoAlert" class="mt-2"></div>

                    </div>

                    <div class="reviews-list">

                        @if (Model.Avaliacoes != null && Model.Avaliacoes.Any())
                        {
                            foreach (var av in Model.Avaliacoes)
                            {
                                <div class="review-item">

                                    <div class="review-header">
                                        <strong>@(av.Cliente?.Nome ?? "Cliente")</strong>

                                        <span class="stars-display">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <span class="star">@(i <= av.Nota ? "★" : "☆")</span>
                                            }
                                        </span>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(av.Comentario))
                                    {
                                        <p class="review-comment">@av.Comentario</p>
                                    }

                                    <span class="review-date">
                                        @((av.DataAtualizacao ?? av.DataCriacao).ToString("dd/MM/yyyy"))
                                    </span>

                                </div>
                            }
                        }
                        else
                        {
                            <p style="color:var(--text2)">Nenhuma avaliação ainda. Seja o primeiro a avaliar!</p>
                        }

                    </div>

                    <div class="pagination-public" id="avaliacoesPaginacao"></div>

                </div>

            </div>

            <!-- FAQ — reduz a fricção de quem está na dúvida de agendar -->
            <div style="margin-top:2.5rem;">
                <div class="section-title" style="margin-bottom:1rem;">Perguntas frequentes</div>

                <div id="faqList">
                    <div class="faq-item">
                        <button type="button" class="faq-q">
                            Preciso pagar algo para reservar o horário?
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="faq-a">Não. O agendamento é gratuito — o pagamento é combinado com a empresa e feito no atendimento.</div>
                    </div>
                    <div class="faq-item">
                        <button type="button" class="faq-q">
                            Posso remarcar ou cancelar?
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="faq-a">Sim — acesse "Meus Agendamentos" no seu painel de cliente pra remarcar ou cancelar, dentro do prazo definido pela empresa.</div>
                    </div>
                    <div class="faq-item">
                        <button type="button" class="faq-q">
                            Preciso me cadastrar para agendar?
                            <i class="bi bi-chevron-down"></i>
                        </button>
                        <div class="faq-a">Não é obrigatório — dá pra agendar só com nome e telefone. Ter conta ajuda a acompanhar o histórico dos seus agendamentos.</div>
                    </div>
                </div>
            </div>

        </div>

        <aside class="sidebar">

            @if (temLocalizacao)
            {
                <!-- Localização -->
                <div class="sidebar-section" id="contato">
                    <h3><i class="bi bi-geo-alt"></i> Localização</h3>

                    <div class="location-row">
                        <p>
                            @if (!string.IsNullOrWhiteSpace(linhaRua))
                            {
