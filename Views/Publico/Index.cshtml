            }

            <!-- Formas de Pagamento -->
            <div class="sidebar-section">
                <h3><i class="bi bi-credit-card"></i> Formas de pagamento</h3>

                <div class="payment-tags">

                    @if (empresa.AceitaDinheiro)
                    {
                        <span class="payment-tag"><i class="bi bi-cash"></i> Dinheiro</span>
                    }

                    @if (empresa.AceitaPix)
                    {
