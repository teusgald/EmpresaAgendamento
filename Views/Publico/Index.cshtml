                    @if (!string.IsNullOrEmpty(empresa.Email))
                    {
                        <div class="contact-item" onclick="copyText('@empresa.Email', this)">
                            <div class="left">
                                <div class="icon-wrap"><i class="bi bi-envelope"></i></div>
                                <span class="val">@empresa.Email</span>
                            </div>
                            <span class="copy-icon"><i class="bi bi-clipboard"></i></span>
                        </div>
                    }

                </div>
            </div>

        </aside>

    </div>
