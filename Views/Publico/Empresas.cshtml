@model EmpresaAgendamento.Models.ViewModels.EmpresaDescobertaViewModel
@using EmpresaAgendamento.Helpers
@{
    // Página pública (sem login), rota "/empresas" — usa o mesmo layout das
    // páginas públicas de empresa (_LayoutPublico, tema escuro/claro,
    // publico.css), não o layout da Home nem o do portal autenticado. É a
    // página de descoberta do cliente, faz parte da experiência pública.
    ViewData["Title"] = "Encontre uma empresa";

    // Painel de filtros avançados começa aberto só se algum desses já
    // estiver ativo (ex.: cliente voltou de um resultado filtrado) — senão
    // fica escondido, estilo iFood: categoria + busca por nome primeiro,
    // o resto é "avançado" de propósito ("não precisa mostrar muita coisa").
    var temFiltroAvancado =
        !string.IsNullOrWhiteSpace(Model.Filtro.Cidade) ||
        !string.IsNullOrWhiteSpace(Model.Filtro.UF) ||
        Model.Filtro.PrecoMinimo.HasValue ||
        Model.Filtro.PrecoMaximo.HasValue ||
        Model.Filtro.AvaliacaoMinima.HasValue ||
        Model.Filtro.DistanciaMaximaKm.HasValue;
}

@section Styles {
    <style>
        .descoberta-header {
            max-width: 1100px;
            margin: 0 auto;
            padding: 1.5rem 1.5rem 0;
        }

        .descoberta-header h1 {
            font-size: clamp(1.5rem, 4vw, 2rem);
            font-weight: 800;
        }

        .descoberta-header p {
            color: var(--text2);
            font-size: 13.5px;
            margin-top: 4px;
        }

        .descoberta-filtros {
            max-width: 1100px;
            margin: 1.25rem auto 0;
            padding: 0 1.5rem;
        }

        /* Busca por nome — a barra mais em destaque, igual iFood/Booksy:
           busca é a ação principal, o resto é filtro secundário. */
        .descoberta-busca-row {
            display: flex;
            gap: 10px;
            margin-bottom: 1rem;
        }

        .descoberta-busca-input {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 10px;
            background: var(--bg2);
            border: 1px solid var(--border2);
            border-radius: 50px;
            padding: 0 16px;
            height: 48px;
        }

            .descoberta-busca-input i {
                color: var(--text3);
                flex-shrink: 0;
            }

            .descoberta-busca-input input {
                background: none;
                border: none;
                outline: none;
                color: var(--text);
                font-family: 'DM Sans', sans-serif;
                font-size: 14.5px;
                width: 100%;
            }

        .descoberta-busca-row .btn-cta {
            flex-shrink: 0;
            height: 48px;
            padding: 0 26px;
        }

        /* Categorias — chips com rolagem horizontal, não um <select>. É o
           filtro principal (estilo iFood: categoria primeiro, o resto vem
           depois, escondido). */
        .descoberta-categorias {
            display: flex;
            gap: 8px;
            overflow-x: auto;
            padding-bottom: 6px;
            margin-bottom: .75rem;
            scrollbar-width: thin;
        }

        .descoberta-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
            background: var(--bg2);
            border: 1px solid var(--border2);
            color: var(--text2);
            border-radius: 50px;
            padding: 8px 16px;
            font-size: 13px;
            font-weight: 500;
            white-space: nowrap;
            cursor: pointer;
            transition: background .15s, border-color .15s, color .15s;
        }

            .descoberta-chip:hover {
                border-color: var(--accent);
                color: var(--text);
            }

            .descoberta-chip.ativo {
                background: var(--accent);
                border-color: var(--accent);
                color: var(--accent-contrast);
                font-weight: 700;
            }

        /* Filtros avançados — escondidos por padrão atrás de um botão, não
           uma tela cheia de campo logo de cara ("não precisa mostrar muita
           coisa"). */
        .descoberta-avancado-toggle {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: none;
            border: none;
            color: var(--text2);
            font-size: 13px;
            font-weight: 600;
            padding: 4px 0;
            margin-bottom: .75rem;
            cursor: pointer;
        }

            .descoberta-avancado-toggle:hover {
                color: var(--text);
            }

            .descoberta-avancado-toggle i.bi-chevron-down {
                transition: transform .2s;
                font-size: .8em;
            }

            .descoberta-avancado-toggle[aria-expanded="true"] i.bi-chevron-down {
                transform: rotate(180deg);
            }

        .descoberta-filtros-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 1.1rem;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: .75rem;
            align-items: end;
        }

        .descoberta-filtros-card label {
            display: block;
            font-size: 11.5px;
            color: var(--text2);
            margin-bottom: 4px;
            text-transform: uppercase;
            letter-spacing: .03em;
        }

        .descoberta-filtros-card select,
        .descoberta-filtros-card input {
            width: 100%;
            background: var(--bg3);
            border: 1px solid var(--border2);
            color: var(--text);
            border-radius: var(--radius-sm);
            padding: 8px 10px;
            font-size: 13.5px;
            font-family: 'DM Sans', sans-serif;
        }

        .descoberta-filtros-actions {
            grid-column: 1 / -1;
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 4px;
        }

        .descoberta-resultados {
            max-width: 1100px;
            margin: 1.5rem auto 3rem;
            padding: 0 1.5rem;
        }

        .descoberta-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 1rem;
        }

        .descoberta-card {
            background: var(--bg2);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
            display: block;
            text-decoration: none;
            color: var(--text);
            transition: border-color .2s, transform .15s;
        }

            .descoberta-card:hover {
                border-color: var(--accent);
                transform: translateY(-2px);
                color: var(--text);
            }

        .descoberta-banner {
            width: 100%;
            height: 110px;
            object-fit: cover;
            background: var(--bg3);
        }

        .descoberta-card-body {
            padding: 14px;
            text-align: center;
        }

        .descoberta-logo {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid var(--border2);
            margin: -34px auto 8px;
            background: var(--bg2);
            display: block;
        }

        .descoberta-logo-vazia {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            margin: -34px auto 8px;
            background: var(--bg3);
            border: 2px solid var(--border2);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: var(--text2);
        }

        .descoberta-card h3 {
            font-size: 14.5px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .descoberta-badge {
            display: inline-block;
            font-size: 11px;
            color: var(--text2);
            border: 1px solid var(--border2);
            border-radius: 999px;
            padding: 2px 10px;
            margin-bottom: 8px;
        }

        .descoberta-meta {
            font-size: 12px;
            color: var(--text2);
        }

        .descoberta-empty {
            text-align: center;
            padding: 3rem 1rem;
            color: var(--text2);
        }

            .descoberta-empty i {
                font-size: 2.25rem;
                display: block;
                margin-bottom: .75rem;
                color: var(--text3);
            }
    </style>
}

@section Navbar {
    <a class="navbar-brand d-flex align-items-center" href="/">
        <img id="logoSite" src="~/img/logocliente.png" alt="Logo" class="navbar-logo me-2" />
    </a>

    <div class="nav-links">
        <a href="/">Início</a>
    </div>
}

<div class="descoberta-header">
    <h1>Encontre uma empresa</h1>
    <p>Busque por categoria, localização, preço e avaliação.</p>
</div>

<div class="descoberta-filtros">
    <form method="get" id="formDescoberta">

        <!-- Busca por nome — ação principal, igual iFood/Booksy -->
        <div class="descoberta-busca-row">
            <div class="descoberta-busca-input">
                <i class="bi bi-search"></i>
                <input type="text" name="nome" value="@Model.Filtro.Nome" placeholder="Buscar pelo nome do estabelecimento" />
            </div>
            <button type="submit" class="btn-cta">Buscar</button>
        </div>

        <!-- Categoria — chips, não dropdown. Clicar já filtra (ver script). -->
        <div class="descoberta-categorias">
            <button type="button" class="descoberta-chip @(!Model.Filtro.Categoria.HasValue ? "ativo" : "")" data-categoria="">
                <i class="bi bi-grid"></i> Todas
            </button>
            @foreach (var cat in Model.Categorias)
            {
                <button type="button" class="descoberta-chip @(Model.Filtro.Categoria == cat.Valor ? "ativo" : "")" data-categoria="@cat.Valor">
                    <i class="bi @CategoriaEmpresaHelper.Icone(cat.Valor)"></i> @cat.Nome
                </button>
            }
        </div>
        <input type="hidden" name="categoria" id="categoriaInput" value="@Model.Filtro.Categoria" />

        <!-- Avançado — cidade/UF/preço/avaliação/distância, escondido até pedir -->
        <button type="button"
                class="descoberta-avancado-toggle"
                data-bs-toggle="collapse"
                data-bs-target="#filtrosAvancados"
                aria-expanded="@(temFiltroAvancado ? "true" : "false")">
            <i class="bi bi-sliders"></i> Filtros avançados <i class="bi bi-chevron-down"></i>
        </button>

        <div class="collapse @(temFiltroAvancado ? "show" : "")" id="filtrosAvancados">
            <div class="descoberta-filtros-card">
                <div>
                    <label>Cidade</label>
                    <input type="text" name="cidade" value="@Model.Filtro.Cidade" placeholder="Ex.: São Paulo" />
                </div>

                <div>
                    <label>UF</label>
                    <select name="uf" class="form-select">
                        <option value="">Qualquer</option>
                        @foreach (var uf in EstadoBrasilHelper.Estados)
                        {
                            <option value="@uf.Sigla" selected="@(Model.Filtro.UF == uf.Sigla)">@uf.Nome</option>
                        }
                    </select>
                </div>

                <div>
                    <label>Avaliação mínima</label>
                    <select name="avaliacaoMinima" class="form-select">
                        <option value="">Qualquer</option>
                        @foreach (var nota in new[] { 5, 4, 3, 2, 1 })
                        {
                            <option value="@nota" selected="@(Model.Filtro.AvaliacaoMinima == nota)">@nota+ estrelas</option>
                        }
                    </select>
                </div>

                <div>
                    <label>Preço mín.</label>
                    <input name="precoMinimo" data-mask="dinheiro" placeholder="R$ 0,00" value="@Model.Filtro.PrecoMinimo" />
                </div>

                <div>
                    <label>Preço máx.</label>
                    <input name="precoMaximo" data-mask="dinheiro" placeholder="R$ 0,00" value="@Model.Filtro.PrecoMaximo" />
                </div>

                <div>
                    <label>Distância máx.</label>
                    <select name="distanciaMaximaKm" class="form-select">
                        <option value="">Qualquer</option>
                        @foreach (var km in new[] { 5, 10, 25, 50, 100 })
                        {
                            <option value="@km" selected="@(Model.Filtro.DistanciaMaximaKm == km)">até @km km</option>
                        }
                    </select>
                </div>

                <input type="hidden" name="latitudeUsuario" id="latitudeUsuario" value="@Context.Request.Query["latitudeUsuario"]" />
                <input type="hidden" name="longitudeUsuario" id="longitudeUsuario" value="@Context.Request.Query["longitudeUsuario"]" />

                <div class="descoberta-filtros-actions">
                    <button type="button" id="btnUsarLocalizacao" class="btn-cta" style="background:var(--bg3);color:var(--text);border:1px solid var(--border2);">
                        <i class="bi bi-geo-alt"></i> Perto de mim
                    </button>
                    <button type="submit" class="btn-cta">Aplicar filtros</button>
                    <a href="/empresas" style="align-self:center;color:var(--text2);font-size:13px;">Limpar tudo</a>
                </div>
            </div>
        </div>
    </form>
</div>

<div class="descoberta-resultados">

    @if (!Model.Empresas.Any())
    {
        <div class="descoberta-empty">
            <i class="bi bi-search"></i>
            <p>Nenhuma empresa encontrada com esses filtros.</p>
        </div>
    }
    else
    {
        <div class="descoberta-grid">
            @foreach (var empresa in Model.Empresas)
            {
                <a href="/@empresa.Slug" class="descoberta-card">

                    @if (!string.IsNullOrWhiteSpace(empresa.CapaOuFotoUrl))
                    {
                        <img src="@empresa.CapaOuFotoUrl" alt="@empresa.Nome" class="descoberta-banner" />
                    }
                    else
                    {
                        <div class="descoberta-banner"></div>
                    }

                    <div class="descoberta-card-body">

                        @if (!string.IsNullOrWhiteSpace(empresa.LogoUrl))
                        {
                            <img src="@empresa.LogoUrl" alt="@empresa.Nome" class="descoberta-logo" />
                        }
                        else
                        {
                            <div class="descoberta-logo-vazia"><i class="bi bi-shop"></i></div>
                        }

                        <h3>@empresa.Nome</h3>

                        <span class="descoberta-badge">
                            @(!string.IsNullOrWhiteSpace(empresa.Categoria) ? empresa.Categoria : "Sem categoria")
                        </span>

                        <div class="descoberta-meta">
                            @if (empresa.NotaMedia.HasValue)
                            {
                                <span class="star">★</span>
                                <strong>@empresa.NotaMedia.Value.ToString("0.0")</strong>
                                <span>(@empresa.TotalAvaliacoes)</span>
                            }
                            else
                            {
                                <span>Sem avaliações ainda</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(empresa.Cidade) || empresa.DistanciaKm.HasValue)
                        {
                            <div class="descoberta-meta mt-1">
                                <i class="bi bi-geo-alt"></i>
                                @if (!string.IsNullOrWhiteSpace(empresa.Cidade))
                                {
                                    @:@empresa.Cidade@(!string.IsNullOrWhiteSpace(empresa.UF) ? $" - {empresa.UF}" : "")
                                }
                                @if (empresa.DistanciaKm.HasValue)
                                {
                                    @:(@empresa.DistanciaKm.Value.ToString("0.#") km)
                                }
                            </div>
                        }

                    </div>
                </a>
            }
        </div>
    }

</div>

@section Footer {
    <div class="footer-bottom">
        <span>© @DateTime.Now.Year Simpli Time</span>
    </div>
}

@section Scripts {
    <script>
        // Chip de categoria — clicar já filtra (define o hidden e reenvia o
        // form), sem precisar de um <select> pra uma coisa só.
        document.querySelectorAll(".descoberta-chip").forEach(function (chip) {
            chip.addEventListener("click", function () {
                document.getElementById("categoriaInput").value = chip.dataset.categoria;
                document.getElementById("formDescoberta").submit();
            });
        });

        // "Perto de mim" — pede a localização do navegador, preenche os
        // campos escondidos de latitude/longitude e reenvia o filtro. Sem
        // permissão de geolocalização, o filtro de distância só não é usado;
        // o resto da busca continua funcionando normalmente.
        document.getElementById("btnUsarLocalizacao")?.addEventListener("click", function () {
            if (!navigator.geolocation) {
                return;
            }

            var botao = this;
            botao.disabled = true;

            navigator.geolocation.getCurrentPosition(function (posicao) {
                document.getElementById("latitudeUsuario").value = posicao.coords.latitude;
                document.getElementById("longitudeUsuario").value = posicao.coords.longitude;
                botao.closest("form").submit();
            }, function () {
                botao.disabled = false;
            });
        });
    </script>
}
