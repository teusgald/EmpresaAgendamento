@model EmpresaAgendamento.Models.ViewModels.ClienteInicioViewModel

@{
    ViewData["Title"] = "Início";
}

<div class="container-fluid mt-4">

    <div class="page-header">
        <div>
            <h3 class="fw-bold mb-0">Onde você quer agendar?</h3>
            <p class="page-subtitle">Sugestões das empresas mais bem avaliadas do sistema.</p>
        </div>
    </div>

    <!-- FILTRO -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-6 col-md-3">
                    <label class="form-label">Categoria</label>
                    <select name="categoria" class="form-select">
                        <option value="">Todas as categorias</option>
                        @foreach (var cat in Model.Categorias)
                        {
                            <option value="@cat" selected="@(Model.CategoriaSelecionada == cat)">@cat</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">Cidade</label>
                    <input type="text" name="cidade" class="form-control" value="@Model.Cidade" placeholder="Ex.: São Paulo" />
                </div>
                <div class="col-6 col-md-1">
                    <label class="form-label">UF</label>
                    <input type="text" name="uf" class="form-control" value="@Model.UF" maxlength="2" placeholder="SP" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">Avaliação mínima</label>
                    <select name="avaliacaoMinima" class="form-select">
                        <option value="">Qualquer</option>
                        @foreach (var nota in new[] { 5, 4, 3, 2, 1 })
                        {
                            <option value="@nota" selected="@(Model.AvaliacaoMinima == nota)">@nota+ estrelas</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">Preço mín.</label>
                    <input name="precoMinimo" class="form-control" data-mask="dinheiro" placeholder="R$ 0,00" value="@Model.PrecoMinimo" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">Preço máx.</label>
                    <input name="precoMaximo" class="form-control" data-mask="dinheiro" placeholder="R$ 0,00" value="@Model.PrecoMaximo" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label">Distância máx.</label>
                    <select name="distanciaMaximaKm" class="form-select">
                        <option value="">Qualquer</option>
                        @foreach (var km in new[] { 5, 10, 25, 50, 100 })
                        {
                            <option value="@km" selected="@(Model.DistanciaMaximaKm == km)">até @km km</option>
                        }
                    </select>
                </div>
                <input type="hidden" name="latitudeUsuario" id="latitudeUsuario" value="@Context.Request.Query["latitudeUsuario"]" />
                <input type="hidden" name="longitudeUsuario" id="longitudeUsuario" value="@Context.Request.Query["longitudeUsuario"]" />
                <div class="col-6 col-md-2 d-flex align-items-end">
                    <button type="button" id="btnUsarLocalizacao" class="btn btn-outline-secondary w-100">
                        <i class="bi bi-geo-alt"></i> Perto de mim
                    </button>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-outline-primary">Filtrar</button>
                </div>
            </form>
        </div>
    </div>

    @section Scripts {
        <script>
            // "Perto de mim" — pede a localização do navegador, preenche os
            // campos escondidos de latitude/longitude e reenvia o filtro. Sem
            // permissão de geolocalização, o filtro de distância só não é
            // usado; o resto da busca continua funcionando normalmente.
            document.getElementById("btnUsarLocalizacao")?.addEventListener("click", function () {
                if (!navigator.geolocation) {
                    return;
                }

                var botao = this;
                botao.disabled = true;

                navigator.geolocation.getCurrentPosition(function (posicao) {
                    document.getElementById("latitudeUsuario").value = posicao.coords.latitude;
                    document.getElementById("longitudeUsuario").value = posicao.coords.longitude;
                    botao.closest("form").submit();
                }, function () {
                    botao.disabled = false;
                });
            });
        </script>
    }

    @if (!Model.Empresas.Any())
    {
        <div class="card shadow-sm">
            <div class="empty-state">
                <i class="bi bi-search"></i>
                <p>
                    @if (!string.IsNullOrWhiteSpace(Model.CategoriaSelecionada))
                    {
                        @:Nenhuma empresa encontrada em "@Model.CategoriaSelecionada" ainda.
                    }
                    else
                    {
                        @:Nenhuma empresa disponível no momento.
                    }
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var empresa in Model.Empresas)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <a href="/@empresa.Slug" class="text-decoration-none">
                        <div class="card shadow-sm h-100 empresa-sugestao-card">
                            <div class="card-body text-center">

                                @if (!string.IsNullOrWhiteSpace(empresa.LogoUrl))
                                {
                                    <img src="@empresa.LogoUrl" alt="@empresa.Nome" class="empresa-sugestao-logo" />
                                }
                                else
                                {
                                    <div class="empresa-sugestao-logo empresa-sugestao-logo-vazia">
                                        <i class="bi bi-shop"></i>
                                    </div>
                                }

                                <h6 class="fw-bold mb-1 mt-2">@empresa.Nome</h6>

                                <span class="badge bg-light text-dark border mb-2">
                                    @(!string.IsNullOrWhiteSpace(empresa.Categoria) ? empresa.Categoria : "Sem categoria")
                                </span>

                                <div class="small">
                                    @if (empresa.NotaMedia.HasValue)
                                    {
                                        <span class="text-warning">
                                            <i class="bi bi-star-fill"></i>
                                        </span>
                                        <span class="fw-semibold">@empresa.NotaMedia.Value.ToString("0.0")</span>
                                        <span class="text-muted">(@empresa.TotalAvaliacoes)</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sem avaliações ainda</span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(empresa.Cidade) || empresa.DistanciaKm.HasValue)
                                {
                                    <div class="small text-muted mt-1">
                                        <i class="bi bi-geo-alt"></i>
                                        @if (!string.IsNullOrWhiteSpace(empresa.Cidade))
                                        {
                                            @:@empresa.Cidade@(!string.IsNullOrWhiteSpace(empresa.UF) ? $" - {empresa.UF}" : "")
                                        }
                                        @if (empresa.DistanciaKm.HasValue)
                                        {
                                            @:(@empresa.DistanciaKm.Value.ToString("0.#") km)
                                        }
                                    </div>
                                }

                                @if (empresa.DescontosFidelidadeDisponiveis > 0)
                                {
                                    <span class="badge bg-warning text-dark mt-2">
                                        <i class="bi bi-award-fill"></i>
                                        Desconto de fidelidade disponível
                                    </span>
                                }

                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }

</div>
