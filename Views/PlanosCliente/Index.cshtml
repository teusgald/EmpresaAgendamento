@model List<EmpresaAgendamento.Models.PlanoServico>
@using EmpresaAgendamento.Models.Enums
@using EmpresaAgendamento.Models

@{
    ViewData["Title"] = "Meus Planos";
    var meusPlanos = ViewBag.MeusPlanos as List<AssinaturaPlanoServico> ?? new();
}

<div class="container-fluid">

    <h3 class="fw-bold mb-3">Meus Planos</h3>

    @if (meusPlanos.Any())
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body">

                <h5 class="mb-3">Meus planos assinados</h5>

                <!-- DESKTOP -->
                <div class="table-responsive d-none d-lg-block">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Plano</th>
                                <th>Empresa</th>
                                <th>Créditos usados</th>
                                <th>Vencimento</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var assinatura in meusPlanos)
                            {
                                <tr>
                                    <td class="fw-semibold">@assinatura.PlanoServico.Nome</td>
                                    <td>@(assinatura.PlanoServico.Empresa.NomeFantasia ?? assinatura.PlanoServico.Empresa.Nome)</td>
                                    <td>
                                        @if (assinatura.Status == StatusAssinaturaPlano.Ativa)
                                        {
                                            <text>@assinatura.CreditosUsados / @assinatura.PlanoServico.QuantidadeUsos</text>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (assinatura.Status == StatusAssinaturaPlano.Ativa)
                                        {
                                            @assinatura.DataVencimento.ToString("dd/MM/yyyy")
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @switch (assinatura.Status)
                                        {
                                            case StatusAssinaturaPlano.Ativa:
                                                <span class="badge bg-success">Ativo</span>
                                                break;
                                            case StatusAssinaturaPlano.Pendente:
                                                <span class="badge bg-warning text-dark">Aguardando aprovação</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">Cancelado</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- MOBILE -->
                <div class="d-lg-none">
                    @foreach (var assinatura in meusPlanos)
                    {
                        <div class="card mobile-card mb-2">
                            <div class="card-body">

                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold mb-0">@assinatura.PlanoServico.Nome</h6>

                                    @switch (assinatura.Status)
                                    {
                                        case StatusAssinaturaPlano.Ativa:
                                            <span class="badge bg-success">Ativo</span>
                                            break;
                                        case StatusAssinaturaPlano.Pendente:
                                            <span class="badge bg-warning text-dark">Aguardando</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">Cancelado</span>
                                            break;
                                    }
                                </div>

                                <div class="mobile-info">
                                    <label>Empresa</label>
                                    <span>@(assinatura.PlanoServico.Empresa.NomeFantasia ?? assinatura.PlanoServico.Empresa.Nome)</span>
                                </div>

                                <div class="mobile-info">
                                    <label>Créditos usados</label>
                                    <span>
                                        @(assinatura.Status == StatusAssinaturaPlano.Ativa
                                            ? $"{assinatura.CreditosUsados} / {assinatura.PlanoServico.QuantidadeUsos}"
                                            : "—")
                                    </span>
                                </div>

                                <div class="mobile-info">
                                    <label>Vencimento</label>
                                    <span>
                                        @(assinatura.Status == StatusAssinaturaPlano.Ativa
                                            ? assinatura.DataVencimento.ToString("dd/MM/yyyy")
                                            : "—")
                                    </span>
                                </div>

                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <h5 class="mb-3">Planos disponíveis</h5>

            @if (!Model.Any())
            {
                <p class="text-muted">Nenhum plano disponível no momento.</p>
            }
            else
            {
                <div class="row g-3">

                    @foreach (var plano in Model)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100">
                                <div class="card-body d-flex flex-column">

                                    <h6 class="fw-bold mb-1">@plano.Nome</h6>
                                    <div class="text-muted small mb-2">
                                        @(plano.Empresa.NomeFantasia ?? plano.Empresa.Nome)
                                    </div>

                                    @if (plano.ValorReferencia.HasValue)
                                    {
                                        <div class="fs-5 fw-bold text-success mb-1">
                                            R$ @plano.ValorReferencia.Value.ToString("F2")
                                            <span class="fs-6 fw-normal text-muted">
                                                / @(plano.Periodicidade == PeriodicidadePlanoServico.Semanal ? "semana" : "mês")
                                            </span>
                                        </div>
                                    }

                                    <div class="small text-muted mb-2">
                                        @plano.QuantidadeUsos sessões por período
                                    </div>

                                    @if (plano.Servicos.Any())
                                    {
                                        <ul class="small text-muted mb-3">
                                            @foreach (var item in plano.Servicos)
                                            {
                                                <li>@item.Servico.Nome</li>
                                            }
                                        </ul>
                                    }

                                    <form asp-action="Solicitar" method="post" class="mt-auto">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="planoServicoId" value="@plano.Id" />
                                        <button type="submit" class="btn btn-dark w-100">
                                            Contratar plano
                                        </button>
                                    </form>

                                </div>
                            </div>
                        </div>
                    }

                </div>
            }

        </div>
    </div>

</div>
