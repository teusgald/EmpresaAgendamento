@model IEnumerable<EmpresaAgendamento.Models.CategoriaFinanceira>
@using EmpresaAgendamento.Models.Enums

@{
    ViewData["Title"] = "Categorias Financeiras";
}

<div class="container-fluid mt-4">

    <div class="page-header">
        <div>
            <h3 class="fw-bold mb-0">Categorias Financeiras</h3>
            <p class="page-subtitle">Categorias usadas pra classificar receitas e despesas.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Nova Categoria
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-tags"></i>
                    <p>Nenhuma categoria cadastrada ainda.</p>
                </div>
            }
            else
            {
                <table class="table table-hover align-middle table-cards-mobile">
                    <thead class="table-light">
                        <tr>
                            <th>Nome</th>
                            <th>Tipo</th>
                            <th>Origem</th>
                            <th class="text-end">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="td-header">@item.Nome</td>
                                <td data-label="Tipo">
                                    @if (item.Tipo == TipoCategoriaFinanceira.Receita)
                                    {
                                        <span class="badge bg-success">Receita</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Despesa</span>
                                    }
                                </td>
                                <td data-label="Origem">
                                    @if (item.Padrao)
                                    {
                                        <span class="badge bg-secondary">Padrão do sistema</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Manual</span>
                                    }
                                </td>
                                <td data-label="Ações" class="text-end">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        Editar
                                    </a>

                                    <form asp-action="ToggleAtivo" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />

                                        @if (item.Ativo)
                                        {
                                            <button type="submit" class="btn btn-sm btn-success">Ativa</button>
                                        }
                                        else
                                        {
                                            <button type="submit" class="btn btn-sm btn-outline-secondary">Inativa</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

        </div>
    </div>

</div>
