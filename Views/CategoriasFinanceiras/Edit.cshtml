@model EmpresaAgendamento.Models.CategoriaFinanceira
@using EmpresaAgendamento.Models.Enums

@{
    ViewData["Title"] = "Editar Categoria";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm" style="max-width: 520px;">
        <div class="card-body">
            <h4 class="mb-4">Editar Categoria</h4>

            @if (Model.Padrao)
            {
                <div class="alert alert-info">
                    Esta é uma categoria padrão criada automaticamente pelo sistema —
                    o nome e o tipo não podem ser alterados.
                </div>
            }

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="mb-3">
                    <label class="form-label">Nome</label>
                    <input asp-for="Nome" class="form-control" disabled="@Model.Padrao" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Tipo</label>
                    <select asp-for="Tipo" class="form-select" disabled="@Model.Padrao">
                        <option value="@TipoCategoriaFinanceira.Receita">Receita</option>
                        <option value="@TipoCategoriaFinanceira.Despesa">Despesa</option>
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Salvar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
                </div>
            </form>
        </div>
    </div>
</div>
