@model EmpresaAgendamento.Models.CategoriaFinanceira
@using EmpresaAgendamento.Models.Enums

@{
    ViewData["Title"] = "Nova Categoria";
}

<div class="container-fluid mt-4">
    <div class="card shadow-sm" style="max-width: 520px;">
        <div class="card-body">
            <h4 class="mb-4">Nova Categoria</h4>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Nome</label>
                    <input asp-for="Nome" class="form-control" placeholder="Ex.: Produtos, Aluguel..." />
                </div>

                <div class="mb-3">
                    <label class="form-label">Tipo</label>
                    <select asp-for="Tipo" class="form-select">
                        <option value="@TipoCategoriaFinanceira.Receita">Receita</option>
                        <option value="@TipoCategoriaFinanceira.Despesa">Despesa</option>
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Salvar</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Voltar</a>
                </div>
            </form>
        </div>
    </div>
</div>
