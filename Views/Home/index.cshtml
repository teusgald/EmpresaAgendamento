@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sistema de Agendamentos</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #0d6efd, #6610f2);
            color: white;
        }

        .hero {
            padding: 80px 20px;
            text-align: center;
        }

        .card-option {
            border: none;
            border-radius: 16px;
            transition: 0.3s;
        }

            .card-option:hover {
                transform: translateY(-5px);
            }

        .btn-lg {
            border-radius: 12px;
        }

        .features i {
            font-size: 2rem;
        }
    </style>
</head>
<body>

    <!-- HERO -->
    <section class="hero">
        <div class="container">
            <h1 class="display-5 fw-bold">Sistema Inteligente de Agendamentos</h1>
            <p class="lead mt-3">
                Conecte clientes e empresas com facilidade, controle total e experiência moderna.
            </p>

            <div class="mt-4">
                
                <a asp-controller="ClientesAuth" asp-action="login" class="btn btn-outline-light btn-lg me-2">
                    Sou Cliente
                </a>
                <a href="/Identity/Account/login" class="btn btn-warning btn-lg">
                    Sou Empresa
                </a>
            </div>
        </div>
    </section>

    <!-- BENEFÍCIOS -->
    <section class="py-5 bg-white text-dark">
        <div class="container text-center">
            <h2 class="mb-5">Por que usar o sistema?</h2>

            <div class="row g-4 features">
                <div class="col-md-4">
                    <i class="bi bi-calendar-check text-primary"></i>
                    <h5 class="mt-3">Agendamento Fácil</h5>
                    <p>Clientes agendam em poucos cliques.</p>
                </div>

                <div class="col-md-4">
                    <i class="bi bi-graph-up text-success"></i>
                    <h5 class="mt-3">Gestão Completa</h5>
                    <p>Empresas controlam clientes, serviços e faturamento.</p>
                </div>

                <div class="col-md-4">
                    <i class="bi bi-phone text-warning"></i>
                    <h5 class="mt-3">100% Responsivo</h5>
                    <p>Acesse de qualquer dispositivo, inclusive celular.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ESCOLHA PERFIL -->
    <section class="py-5 bg-light text-dark">
        <div class="container text-center">
            <h2 class="mb-5">Comece agora</h2>

            <div class="row g-4 justify-content-center">

                <!-- CLIENTE -->
                <div class="col-md-5">
                    <div class="card card-option shadow p-4">
                        <h4><i class="bi bi-person"></i> Cliente</h4>
                        <p>Agende serviços rapidamente e acompanhe seus horários.</p>

                        <a href="/ClientesAuth/Register" class="btn btn-primary btn-lg w-100">
                            Criar Conta de Cliente
                        </a>
                    </div>
                </div>

                <!-- EMPRESA -->
                <div class="col-md-5">
                    <div class="card card-option shadow p-4">
                        <h4><i class="bi bi-building"></i> Empresa</h4>
                        <p>Gerencie agendamentos, clientes e serviços do seu negócio.</p>

                        <a href="/Identity/Account/Register" class="btn btn-success btn-lg w-100">
                            Criar Conta de Empresa
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="text-center py-4 bg-dark text-light">
        <small>© @DateTime.Now.Year - Sistema de Agendamentos</small>
    </footer>

</body>
</html>