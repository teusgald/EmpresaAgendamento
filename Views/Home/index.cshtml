@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AgendaPro</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        body {
            background: #f9fafb;
            color: #111827;
            padding-top: 80px;
        }

        @@media (max-width: 991px) {
            .nav-actions

        {
            width: 100%;
            justify-content: center; /* CENTRALIZA horizontal */
            margin-top: 15px;
        }

        .nav-actions .btn {
            min-width: 120px;
            text-align: center;
        }

        }

        /* NAVBAR */
        .navbar-custom {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #e5e7eb;
        }

        /* LINKS */
        .navbar .nav-link {
            color: #374151;
            font-weight: 500;
            transition: 0.3s;
        }

            .navbar .nav-link:hover {
                color: #000;
            }

        .navbar-toggler {
            border: none;
        }

            .navbar-toggler:focus {
                box-shadow: none;
            }

        .navbar-brand {
            color: #111827 !important;
            font-weight: 700;
        }

            .navbar-brand:hover {
                color: #6b7280 !important; /* cinza elegante */
            }
        /* BOTÃO LOGIN (clean) */
        .btn-login {
            background: transparent;
            border: none;
            color: #374151;
            font-weight: 500;
        }

            .btn-login:hover {
                color: #000;
            }

        /* BOTÃO CTA (preto) */
        .btn-cta {
            background: #000;
            color: #fff;
            border-radius: 10px;
            padding: 6px 16px;
            font-weight: 500;
            transition: 0.3s;
        }

            .btn-cta:hover {
                background: #111;
                transform: translateY(-1px);
            }

        .section {
            padding: 100px 0;
        }

        .hero {
            padding: 120px 0;
        }

        /* CARD NEGÓCIO */
        .card-business {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 20px;
            padding: 25px 15px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

            .card-business h6 {
                margin-top: 15px;
                font-weight: 600;
            }

            .card-business p {
                font-size: 13px;
                color: #6b7280;
                margin-top: 5px;
            }

        /* ÍCONE */
        .icon-box {
            width: 55px;
            height: 55px;
            margin: 0 auto;
            border-radius: 14px;
            background: #f3f4f6;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            color: #111827;
            transition: 0.3s;
        }

        /* HOVER PREMIUM */
        .card-business:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.06);
        }

            .card-business:hover .icon-box {
                background: #111827;
                color: #fff;
                transform: scale(1.1);
            }

        .hero {
            padding: 120px 0;
            background: #f8fafc;
        }

        /* TEXTO */
        .hero-badge {
            display: inline-block;
            background: #f1f5f9;
            color: #0f172a;
            padding: 6px 14px;
            border-radius: 999px;
            font-size: 13px;
            margin-bottom: 20px;
        }

        .hero-title {
            font-size: 42px;
            font-weight: 800;
            line-height: 1.2;
            color: #020617;
            margin-bottom: 20px;
        }

        .hero-subtitle {
            font-size: 18px;
            color: #475569;
            margin-bottom: 30px;
            max-width: 520px;
        }

        .hero-actions {
            display: flex;
            align-items: center;
            gap: 20px;
        }

        .hero-note {
            font-size: 14px;
            color: #64748b;
        }

        /* IMAGEM */
        .hero-image {
            position: relative;
            height: 500px;
            border-radius: 20px;
            overflow: hidden;
        }

            .hero-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }

            /* 🔥 DEGRADÊ PROFISSIONAL */
            .hero-image::after {
                content: "";
                position: absolute;
                inset: 0;
                background: linear-gradient( to left, rgba(255,255,255,0) 40%, rgba(248,250,252,0.9) 100% );
            }

        /* RESPONSIVO */
        @@media (max-width: 992px) {
            .hero

        {
            padding: 80px 0;
        }

        .hero-image {
            height: 350px;
            margin-top: 40px;
        }

        .hero-title {
            font-size: 32px;
        }

        }

        /* ITEM LISTA */
        .benefit-item {
            display: flex;
            gap: 15px;
            margin-bottom: 25px;
            align-items: flex-start;
        }

            .benefit-item h6 {
                margin-bottom: 4px;
                font-weight: 600;
            }

            .benefit-item p {
                margin: 0;
                color: #6b7280;
                font-size: 14px;
            }

        /* ÍCONES */
        .benefit-icon {
            width: 45px;
            height: 45px;
            border-radius: 12px;
            background: #f3f4f6;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            color: #111827;
            transition: 0.3s;
        }

        /* CARDS DIREITA */
        .benefit-card {
            display: flex;
            gap: 15px;
            padding: 20px;
            border-radius: 18px;
            background: #fff;
            border: 1px solid #e5e7eb;
            transition: all 0.3s ease;
        }

            /* HOVER */
            .benefit-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 20px 40px rgba(0,0,0,0.06);
            }

                .benefit-card:hover .benefit-icon {
                    background: #111827;
                    color: #fff;
                }

        .btn-primary {
            background: #111827;
            border: none;
            border-radius: 12px;
        }

        .btn-outline-custom {
            border: 1px solid #d1d5db;
            border-radius: 12px;
        }

        /* CARD BASE */
        .plan-card {
            background: #0f172a;
            border: 1px solid #1e293b;
            border-radius: 18px;
            padding: 30px;
            display: flex;
            flex-direction: column;
            height: 100%;
            transition: all 0.3s ease;
        }

            /* HOVER */
            .plan-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 20px 50px rgba(0,0,0,0.4);
            }

        /* PREÇO */
        .price {
            font-size: 32px;
            font-weight: 700;
        }

            .price span {
                font-size: 14px;
                color: #94a3b8;
                font-weight: 400;
            }

        /* LISTA */
        .plan-list {
            list-style: none;
            padding: 0;
            margin-bottom: 30px;
        }

            .plan-list li {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 12px;
                color: #cbd5f5;
            }

            .plan-list i {
                color: #22c55e;
            }

        /* BOTÃO NORMAL */
        .btn-plan {
            border: 1px solid #334155;
            color: #fff;
            padding: 10px;
            border-radius: 10px;
            transition: 0.3s;
        }

            .btn-plan:hover {
                background: #1e293b;
            }

        /* PLANO DESTAQUE */
        .plan-card.highlight {
            background: #111827;
            border: 1px solid #374151;
            transform: scale(1.05);
        }

        /* BADGE */
        .badge-plan {
            background: #22c55e;
            color: #022c22;
            font-size: 12px;
            font-weight: 600;
            padding: 5px 10px;
            border-radius: 20px;
            display: inline-block;
            margin-bottom: 10px;
        }

        /* BOTÃO DESTAQUE */
        .btn-plan-primary {
            background: #fff;
            color: #000;
            padding: 10px;
            border-radius: 10px;
            font-weight: 600;
            transition: 0.3s;
        }

            .btn-plan-primary:hover {
                background: #e5e7eb;
            }

        .footer-premium {
            background: #020617;
            color: #cbd5f5;
            padding: 70px 0 30px;
        }

        /* LOGO */
        .logo-icon {
            background: #111827;
            padding: 8px 10px;
            border-radius: 10px;
            color: #fff;
        }

        /* TEXTO */
        .footer-desc {
            color: #94a3b8;
            font-size: 14px;
            line-height: 1.6;
        }

        /* TITULOS */
        .footer-title {
            color: #fff;
            font-weight: 600;
            margin-bottom: 15px;
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* LINKS */
        .footer-links {
            list-style: none;
            padding: 0;
        }

            .footer-links li {
                margin-bottom: 8px;
            }

            .footer-links a {
                color: #94a3b8;
                text-decoration: none;
                font-size: 14px;
                transition: 0.3s;
            }

                .footer-links a:hover {
                    color: #fff;
                }

        /* CONTATO */
        .footer-contact {
            list-style: none;
            padding: 0;
        }

            .footer-contact li {
                display: flex;
                align-items: center;
                gap: 8px;
                margin-bottom: 10px;
                font-size: 14px;
                color: #94a3b8;
            }

        /* LINHA FINAL */
        .footer-bottom {
            border-top: 1px solid #1e293b;
            margin-top: 40px;
            padding-top: 20px;
            text-align: center;
            font-size: 13px;
            color: #64748b;
        }

        .hero img {
            transition: transform 0.4s ease;
        }

            .hero img:hover {
                transform: scale(1.02);
            }
    </style>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-light fixed-top navbar-custom">
        <div class="container d-flex align-items-center justify-content-between">

            <!-- LOGO -->
            <a class="navbar-brand fw-bold" href="/">AgendaPro</a>

            <!-- MENU MOBILE -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- CONTEÚDO -->
            <div id="menu" class="collapse navbar-collapse">

                <!-- LINKS CENTRALIZADOS -->
                <ul class="navbar-nav mx-auto text-center gap-4">
                    <li><a class="nav-link" href="#">Home</a></li>
                    <li><a class="nav-link" href="#beneficios">Benefícios</a></li>
                    <li><a class="nav-link" href="#planos">Planos</a></li>
                    <li><a class="nav-link" href="#contato">Contato</a></li>
                </ul>

                <!-- AÇÕES DIREITA -->
                <div class="nav-actions d-flex gap-2">
                    <a href="/ClientesAuth/Login" class="btn btn-login">Login</a>
                    <a href="/Identity/Account/Register" class="btn btn-cta">Começar</a>
                </div>

            </div>
        </div>
    </nav>

    <!-- HERO -->
    <section class="hero">
        <div class="container">
            <div class="row align-items-center">

                <!-- TEXTO -->
                <div class="col-lg-6">
                    <div class="hero-badge">
                        Mais tempo para você, mais clientes para o seu negócio.
                    </div>

                    <h1 class="hero-title">
                        Organize seus atendimentos e aumente seus clientes com um sistema de agendamento online
                    </h1>

                    <p class="hero-subtitle">
                        A plataforma completa para profissionais e empresas que desejam profissionalizar sua gestão, reduzir faltas e faturar mais.
                    </p>

                    <div class="hero-actions">
                        <a href="/Identity/Account/Register" class="btn btn-dark btn-lg px-4">
                            Começar Agora
                        </a>

                        <span class="hero-note">
                            ✔ Teste sem compromisso
                        </span>
                    </div>
                </div>

                <!-- IMAGEM -->
                <div class="col-lg-6">
                    <div class="hero-image">
                        <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?q=80&w=1400&auto=format&fit=crop"
                             alt="Sistema de agendamento" />
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- PARA QUEM -->
    <section class="section bg-light text-center">
        <div class="container">
            <h2 class="mb-3">Feito para o seu negócio</h2>
            <p class="text-muted mb-5">
                Uma plataforma que se adapta ao seu tipo de atendimento
            </p>

            <div class="row g-4 justify-content-center">

                <!-- CARD -->
                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card-business">
                        <div class="icon-box">
                            <i class="bi bi-scissors"></i>
                        </div>
                        <h6>Barbeiros</h6>
                        <p>Organize cortes e horários</p>
                    </div>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card-business">
                        <div class="icon-box">
                            <i class="bi bi-stars"></i>
                        </div>
                        <h6>Salões</h6>
                        <p>Controle serviços e equipe</p>
                    </div>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card-business">
                        <div class="icon-box">
                            <i class="bi bi-heart-pulse"></i>
                        </div>
                        <h6>Clínicas</h6>
                        <p>Agendamentos organizados</p>
                    </div>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card-business">
                        <div class="icon-box">
                            <i class="bi bi-briefcase"></i>
                        </div>
                        <h6>Autônomos</h6>
                        <p>Gestão simples e rápida</p>
                    </div>
                </div>

                <div class="col-6 col-md-4 col-lg-2">
                    <div class="card-business">
                        <div class="icon-box">
                            <i class="bi bi-tools"></i>
                        </div>
                        <h6>Serviços</h6>
                        <p>Atendimentos organizados</p>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- BENEFÍCIOS -->
    <section id="beneficios" class="section">
        <div class="container">
            <div class="row g-5 align-items-center">

                <!-- ESQUERDA (TEXTO + LISTA) -->
                <div class="col-lg-6">

                    <h2 class="mb-4">Tudo que você precisa em um só lugar</h2>

                    <p class="text-muted mb-5">
                        Substitua o caderno, planilhas e mensagens soltas no WhatsApp por um sistema profissional que automatiza sua rotina.
                    </p>

                    <!-- ITEM -->
                    <div class="benefit-item">
                        <div class="benefit-icon">
                            <i class="bi bi-clock"></i>
                        </div>
                        <div>
                            <h6>Agendamento 24h</h6>
                            <p>Seus clientes marcam sozinhos a qualquer hora do dia.</p>
                        </div>
                    </div>

                    <div class="benefit-item">
                        <div class="benefit-icon">
                            <i class="bi bi-check-circle"></i>
                        </div>
                        <div>
                            <h6>Redução de faltas</h6>
                            <p>Lembretes automáticos evitam esquecimentos.</p>
                        </div>
                    </div>

                    <div class="benefit-item">
                        <div class="benefit-icon">
                            <i class="bi bi-people"></i>
                        </div>
                        <div>
                            <h6>Controle de clientes</h6>
                            <p>Histórico completo e preferências registradas.</p>
                        </div>
                    </div>

                </div>

                <!-- DIREITA (CARDS) -->
                <div class="col-lg-6">

                    <div class="benefit-card mb-4">
                        <div class="benefit-icon">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                        <div>
                            <h6>Gestão de caixa</h6>
                            <p>Acompanhe seu faturamento em tempo real com facilidade.</p>
                        </div>
                    </div>

                    <div class="benefit-card">
                        <div class="benefit-icon">
                            <i class="bi bi-whatsapp"></i>
                        </div>
                        <div>
                            <h6>Integração WhatsApp</h6>
                            <p>Confirmações automáticas direto no celular do cliente.</p>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </section>

    <!-- PLANOS PREMIUM -->
    <section id="planos" class="section" style="background:#020617; color:#fff;">
        <div class="container">

            <div class="text-center mb-5">
                <h2 class="fw-bold">Preços simples e transparentes</h2>
                <p class="text-secondary">Escolha o plano ideal para escalar seus atendimentos</p>
            </div>

            <div class="row justify-content-center g-4">

                <!-- PLANO MENSAL -->
                <div class="col-md-5">
                    <div class="plan-card">

                        <h5 class="text-light">Mensal</h5>
                        <p class="text-secondary mb-4">Ideal para começar</p>

                        <div class="price mb-4">
                            R$ 49,90 <span>/mês</span>
                        </div>

                        <ul class="plan-list">
                            <li><i class="bi bi-check2"></i> Agendamentos ilimitados</li>
                            <li><i class="bi bi-check2"></i> Gestão de clientes</li>
                            <li><i class="bi bi-check2"></i> Controle financeiro</li>
                        </ul>

                        <a href="/Identity/Account/Register" class="btn btn-plan mt-auto">
                            Assinar Mensal
                        </a>

                    </div>
                </div>

                <!-- PLANO ANUAL (DESTAQUE) -->
                <div class="col-md-5">
                    <div class="plan-card highlight">

                        <div class="badge-plan">Economize 17%</div>

                        <h5>Anual</h5>
                        <p class="text-light-50 mb-4">Melhor custo-benefício</p>

                        <div class="price mb-4">
                            R$ 99,90 <span>/ano</span>
                        </div>

                        <ul class="plan-list">
                            <li><i class="bi bi-check2"></i> Tudo do mensal</li>
                            <li><i class="bi bi-check2"></i> WhatsApp automático</li>
                            <li><i class="bi bi-check2"></i> Link personalizado</li>
                            <li><i class="bi bi-check2"></i> Suporte prioritário</li>
                        </ul>

                        <a href="/Identity/Account/Register" class="btn btn-plan-primary mt-auto">
                            Assinar Anual
                        </a>

                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- CTA FINAL -->
    <section class="section text-center">
        <div class="container">
            <h2 class="mb-4">Pronto para crescer?</h2>

            <p class="text-muted mb-4">
                Junte-se a profissionais que já automatizaram seus atendimentos.
            </p>

            <a href="/Identity/Account/Register" class="btn btn-primary btn-lg">
                Começar Agora
            </a>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer-premium" id="contato">
        <div class="container">

            <div class="row g-5">

                <!-- LOGO + DESCRIÇÃO -->
                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="logo-icon">
                            <i class="bi bi-calendar-check"></i>
                        </div>
                        <span class="fw-bold fs-5 text-white">AgendaPro</span>
                    </div>

                    <p class="footer-desc">
                        A plataforma definitiva para organizar seus atendimentos e escalar seu negócio.
                        Simples, rápida e eficiente.
                    </p>
                </div>

                <!-- PRODUTO -->
                <div class="col-md-2">
                    <h6 class="footer-title">Produto</h6>
                    <ul class="footer-links">
                        <li><a href="#">Funcionalidades</a></li>
                        <li><a href="#planos">Planos e Preços</a></li>
                        <li><a href="#">Integrações</a></li>
                        <li><a href="#">Atualizações</a></li>
                    </ul>
                </div>

                <!-- EMPRESA -->
                <div class="col-md-3">
                    <h6 class="footer-title">Empresa</h6>
                    <ul class="footer-links">
                        <li><a href="#">Sobre nós</a></li>
                        <li><a href="#">Blog</a></li>
                        <li><a href="#">Termos de Uso</a></li>
                        <li><a href="#">Privacidade</a></li>
                    </ul>
                </div>

                <!-- CONTATO -->
                <div class="col-md-3">
                    <h6 class="footer-title">Contato</h6>
                    <ul class="footer-contact">
                        <li><i class="bi bi-envelope"></i> contato@agendapro.com</li>
                        <li><i class="bi bi-telephone"></i> (11) 99999-9999</li>
                        <li><i class="bi bi-geo-alt"></i> São Paulo, SP - Brasil</li>
                    </ul>
                </div>

            </div>

            <!-- LINHA FINAL -->
            <div class="footer-bottom">
                © @DateTime.Now.Year - AgendaPro. Todos os direitos reservados.
            </div>

        </div>
    </footer>

    <script>
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener("click", function (e) {
                e.preventDefault();
                document.querySelector(this.getAttribute("href"))
                    .scrollIntoView({ behavior: "smooth" });
            });
        });
    </script>

</body>
</html>