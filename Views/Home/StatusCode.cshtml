@{
    Layout = null;

    int codigo = ViewBag.Codigo is int c ? c : 0;

    string titulo;
    string mensagem;
    string icone;

    switch (codigo)
    {
        case 404:
            titulo = "Página não encontrada";
            mensagem = "O endereço que você tentou abrir não existe ou foi removido. Confira o link e tente de novo.";
            icone = "bi-signpost-2";
            break;
        case 403:
            titulo = "Acesso não disponível";
            mensagem = "Você não tem permissão para acessar essa página.";
            icone = "bi-shield-lock";
            break;
        default:
            titulo = "Não foi possível abrir essa página";
            mensagem = $"Ocorreu um problema (código {codigo}). Tente novamente em alguns instantes.";
            icone = "bi-exclamation-triangle";
            break;
    }

    ViewData["Title"] = titulo;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Simpli Time</title>
    <link rel="icon" type="image/png" href="/img/icon.png?v=3" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
</head>
<body class="bg-light">

    <div class="d-flex align-items-center justify-content-center" style="min-height:100vh;">
        <div class="card shadow-sm text-center" style="width:100%;max-width:420px;">
            <div class="card-body p-4">

                <i class="bi @icone text-warning" style="font-size:2.5rem;"></i>
                <h4 class="mt-3 mb-2">@titulo</h4>

                <p class="text-muted small mb-4">
                    @mensagem
                </p>

                <a href="/" class="btn btn-dark w-100">
                    <i class="bi bi-arrow-left me-1"></i> Voltar para o início
                </a>

            </div>
        </div>
    </div>

</body>
</html>
