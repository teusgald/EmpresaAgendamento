{
  // A connection string real fica em User Secrets (dev) ou na variável de ambiente
  // ConnectionStrings__DefaultConnection / configuração do App Service (produção).
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Liga a tela de manutenção pra todo mundo (menos os assets) sem precisar
  // recompilar — no Azure, basta trocar "Manutencao__Ativa" em Application
  // settings e reiniciar o app.
  "Manutencao": {
    "Ativa": false
  }
}
