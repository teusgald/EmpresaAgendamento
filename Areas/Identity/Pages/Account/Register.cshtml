@page
@model RegisterModel

@{
    Layout = null;
}

<div class="auth-card">

    <!-- HEADER -->
    <div class="text-center mb-4">
        <i class="bi bi-building auth-icon"></i>
        <h4 class="auth-title">Cadastro de Empresa</h4>
        <p class="auth-subtitle">Crie sua conta empresarial</p>
    </div>

    <form method="post">

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <input asp-for="Input.NomeEmpresa" class="form-control" placeholder="Nome da empresa" />
        </div>

        <div class="mb-3">
            <input asp-for="Input.Email" class="form-control" placeholder="Email" />
        </div>

        <div class="mb-3">
            <input asp-for="Input.Password" type="password" class="form-control" placeholder="Senha" />
        </div>

        <div class="mb-3">
            <input asp-for="Input.ConfirmPassword" type="password" class="form-control" placeholder="Confirmar senha" />
        </div>

        <button class="btn btn-dark w-100">
            Criar Conta
        </button>

    </form>

</div>